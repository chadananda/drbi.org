# build output
dist/
.astro/
.wrangler/
.vercel/
.vercel
.aider*
.claude/*
# the xswarm Stop gate must travel with the repo -- without it a dispatched
# worker can end its turn with acceptance criteria failing and nothing notices
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
!.claude/commands/

# dependencies
node_modules/
package-lock.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.*
!.env.example
.env.production

# analytics data (exclude raw imports but include processed summary)
src/data/analytics-imports/
!src/data/analytics-summary.json
.env.development.local

# macOS / Windows junk files
.DS_Store
Thumbs.db
.vscode

# auto-generated runtime files
cron-last-run.json

# misc
extra/
public/posts/

# backup and research
work/

# temp / scratch (screenshots, audits, uploads, local db) — never committed
tmp/
cron-last-run.json

# Playwright test outputs
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/reports/
.dev.vars

# Dropbox conflict artifacts — these defeat rules anchored on `.env$`
# (e.g. ".env (Chad's conflicted copy 2026-04-01)") and have leaked keys before.
*conflicted copy*
*Conflicted Copy*
