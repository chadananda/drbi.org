---
export const prerender = true;
import Layout from "./Layout.astro";
import PageHero from "@components/PageHero.astro";
import Container from "@components/container.astro";
import { imagekitUrl } from "@utils/utils.js";

const { frontmatter } = Astro.props;

// frontmatter.image (a keyword) → R2 key on cdn.shrtr.com, served via ImageKit.
const imageMap: Record<string, string> = {
  arts: "drbi.org/site/drbi/arts.webp",
  cemetery: "drbi.org/site/drbi/cemetery.webp",
  study: "drbi.org/site/drbi/study.webp",
  soil: "drbi.org/site/drbi/soil.webp",
  kure: "drbi.org/site/drbi/kure.webp",
  casas: "drbi.org/site/history/casas.webp",
  hall: "drbi.org/site/history/hall.webp",
  pavilion: "drbi.org/site/history/pavilion.webp",
  roundhouse: "drbi.org/site/history/round-house.webp",
  guesthouse: "drbi.org/site/history/guest-house.webp",
  farm: "drbi.org/site/history/farm.webp",
  memories: "drbi.org/site/drbi/memories.webp",
  contribute: "drbi.org/site/drbi/contribute.webp",
  events: "drbi.org/site/drbi/events.webp",
  faith: "drbi.org/site/drbi/faith.webp",
  news: "drbi.org/site/drbi/news.webp",
};
const heroImage = imageMap[frontmatter.image] ?? undefined;
const heroPosition = frontmatter.imagePosition ?? "object-center";
// OG image: an absolute, sized ImageKit URL from the R2 key.
const ogImageSrc = heroImage
  ? imagekitUrl(`https://cdn.shrtr.com/${heroImage}`, { w: 1200 })
  : undefined;
---

<Layout title={frontmatter.title} description={frontmatter.description} image={ogImageSrc}>

  <PageHero
    label={frontmatter.label}
    title={frontmatter.title}
    subtitle={frontmatter.subtitle}
    image={heroImage}
    imageAlt={frontmatter.title}
    imagePosition={heroPosition}
  />

  <div class="py-16 bg-surface">
    <Container>
      <div class="mx-auto prose prose-lg prose-slate
        prose-headings:font-serif prose-headings:font-light prose-headings:text-ink
        prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-5
        prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-3
        prose-p:text-body prose-p:leading-relaxed
        prose-a:text-brand prose-a:no-underline hover:prose-a:underline
        prose-blockquote:border-brand prose-blockquote:text-body prose-blockquote:italic
        prose-strong:text-ink
        max-w-[80ch]">
        <slot />
      </div>
    </Container>
  </div>

</Layout>

<style is:global>
  @media screen { .printonly { display: none !important; } }
  @media print  { .printonly { display: block !important; } .noprint { display: none !important; } }
</style>
