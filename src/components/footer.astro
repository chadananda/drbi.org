---
import Container from "@components/container.astro";
import brand from "@data/site.json";

const { margin } = Astro.props;
const year = new Date().getFullYear();

// Curated footer navigation (kept tidy; avoids duplicating the same link across columns).
const explore = [
  { title: "Events & Programs", path: "/events" },
  { title: "The Arts", path: "/arts" },
  { title: "Agriculture", path: "/agriculture" },
  { title: "Memorial Gardens", path: "/memorial" },
];
const community = [
  { title: "KURE Radio 106.1 FM", path: "/radio" },
  { title: "Facility Rentals", path: "/facilities-and-rentals" },
  { title: "Volunteer with Us", path: "/working-with-us" },
  { title: "The Bahá'í Faith", path: "/the-bahai-faith" },
];
const institute = [
  { title: "About DRBI", path: "/about-us" },
  { title: "Our History", path: "/history" },
  { title: "Contact", path: "/contact-us" },
  { title: "Contribute", path: "/contribute" },
];
---

<footer class:list={["site-footer noprint", margin && "mt-16"]}>
  <div class="footer-top">
    <Container>
      <div class="footer-grid">
        <!-- Brand + contact -->
        <div class="footer-brand">
          <a href="/" class="footer-wordmark">
            <span class="fw-rose">Desert Rose</span>
            <span class="fw-sub">Bahá'í Institute · Eloy, Arizona</span>
          </a>
          <p class="footer-mission">A center for learning, the arts, agriculture, and community — open to all.</p>

          <address class="footer-contact">
            <span class="fc-line">{brand.address}</span>
            <a href={`tel:${(brand.phone||'').replace(/[^0-9+]/g,'')}`} class="fc-link">{brand.phone}</a>
            <a href={`mailto:${brand.email}`} class="fc-link">{brand.email}</a>
          </address>

          <div class="footer-social" aria-label="Social media">
            <a href="https://www.facebook.com/drbi" target="_blank" rel="noopener noreferrer" class="fs-icon" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.5 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
            </a>
            <a href={`https://www.youtube.com/channel/${brand.youtube?.channel}`} target="_blank" rel="noopener noreferrer" class="fs-icon" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M23.5 6.2a3 3 0 0 0-2.12-2.13C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.52A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.13c1.88.52 9.38.52 9.38.52s7.5 0 9.38-.52a3 3 0 0 0 2.12-2.13A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.55 15.57V8.43L15.82 12z"/></svg>
            </a>
            <a href={`mailto:${brand.email}`} class="fs-icon" aria-label="Email us">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="16" height="16"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6 9 6 9-6"/></svg>
            </a>
          </div>
        </div>

        <!-- Link columns -->
        <nav class="footer-col" aria-label="Explore">
          <h3 class="footer-heading">Explore</h3>
          <ul>{explore.map((l) => <li><a href={l.path}>{l.title}</a></li>)}</ul>
        </nav>
        <nav class="footer-col" aria-label="Community">
          <h3 class="footer-heading">Community</h3>
          <ul>{community.map((l) => <li><a href={l.path}>{l.title}</a></li>)}</ul>
        </nav>
        <nav class="footer-col" aria-label="Institute">
          <h3 class="footer-heading">Institute</h3>
          <ul>{institute.map((l) => <li><a href={l.path}>{l.title}</a></li>)}</ul>
        </nav>

        <!-- Support CTA -->
        <div class="footer-cta">
          <p class="fc-kicker">Support the work</p>
          <p class="fc-text">Your gift sustains education, the arts, and the land at Desert Rose.</p>
          <a href="/contribute" class="fc-button">Contribute</a>
        </div>
      </div>
    </Container>
  </div>

  <div class="footer-bottom">
    <Container>
      <div class="fb-row">
        <span class="fb-copy">© {year} {brand.title}. All rights reserved.</span>
        <nav class="fb-legal" aria-label="Legal">
          <a href="/terms" rel="nofollow">Terms</a>
          <span class="fb-dot" aria-hidden="true">·</span>
          <a href="/privacy" rel="nofollow">Privacy</a>
          <span class="fb-dot" aria-hidden="true">·</span>
          <a href="/login" rel="nofollow">Staff sign-in</a>
        </nav>
      </div>
    </Container>
  </div>
</footer>

<style>
  .site-footer {
    --f-bg: #211c16;
    --f-bg2: #1a160f;
    --f-ink: #ece3d3;
    --f-muted: #a99d88;
    --f-faint: #9a8f7c;
    --f-line: #372f24;
    --f-rose: #d99a5b;
    --f-rose-soft: #e9b878;
    color: var(--f-ink);
    background: var(--f-bg);
    position: relative;
  }
  /* Warm hairline of desert light along the top */
  .site-footer::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent, rgba(217,154,91,.5), transparent);
  }

  .footer-top { padding: 4rem 0 3rem; }
  .footer-grid {
    display: grid; gap: 2.75rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 680px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) {
    .footer-grid { grid-template-columns: 1.8fr 1fr 1fr 1fr 1.3fr; align-items: start; }
  }

  /* Brand */
  .footer-brand { max-width: 22rem; }
  .footer-wordmark { display: inline-flex; flex-direction: column; text-decoration: none; }
  .fw-rose { font-family: 'Merriweather', Georgia, serif; font-size: 1.55rem; font-weight: 400; color: #f4ead6; letter-spacing: .01em; line-height: 1.1; }
  .fw-sub { font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--f-rose); margin-top: .4rem; }
  .footer-mission { margin: 1.1rem 0 0; font-size: .9rem; line-height: 1.65; color: var(--f-muted); }
  .footer-contact { display: flex; flex-direction: column; gap: .2rem; margin: 1.3rem 0 0; font-style: normal; font-size: .875rem; }
  .fc-line { color: var(--f-muted); }
  .fc-link { color: var(--f-ink); text-decoration: none; width: fit-content; transition: color .15s; }
  .fc-link:hover { color: var(--f-rose-soft); }

  .footer-social { display: flex; gap: .6rem; margin-top: 1.4rem; }
  .fs-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 999px; border: 1px solid var(--f-line); color: var(--f-muted); transition: color .18s, border-color .18s, background .18s, transform .18s; }
  .fs-icon:hover { color: #201c16; background: var(--f-rose-soft); border-color: var(--f-rose-soft); transform: translateY(-2px); }

  /* Link columns */
  .footer-col { min-width: 0; }
  .footer-heading { font-family: 'Merriweather', Georgia, serif; font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--f-rose); margin: 0 0 1.1rem; }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .footer-col li { margin: 0; }
  .footer-col a {
    display: inline-flex; align-items: center; min-height: 40px; font-size: .9rem; color: var(--f-muted);
    text-decoration: none; transition: color .15s, transform .15s; position: relative;
  }
  .footer-col a::before {
    content: ""; position: absolute; left: -.85rem; width: 0; height: 1px; background: var(--f-rose);
    transition: width .2s; opacity: 0;
  }
  .footer-col a:hover { color: var(--f-ink); transform: translateX(.85rem); }
  .footer-col a:hover::before { width: .5rem; opacity: 1; }

  /* CTA */
  .footer-cta { border: 1px solid var(--f-line); border-radius: 14px; padding: 1.4rem 1.4rem 1.5rem; background: linear-gradient(160deg, rgba(217,154,91,.08), rgba(217,154,91,0)); }
  .fc-kicker { font-family: 'Merriweather', Georgia, serif; font-size: 1.02rem; color: #f4ead6; margin: 0 0 .4rem; }
  .fc-text { font-size: .82rem; line-height: 1.55; color: var(--f-muted); margin: 0 0 1.1rem; }
  .fc-button {
    display: inline-flex; align-items: center; justify-content: center; width: 100%; padding: .7rem 1.2rem;
    border-radius: 999px; font-size: .9rem; font-weight: 600; letter-spacing: .02em; text-decoration: none;
    color: #2a2116; background: linear-gradient(180deg, #e9b878, #d99a5b);
    box-shadow: 0 8px 22px -10px rgba(217,154,91,.7); transition: filter .15s, transform .12s;
  }
  .fc-button:hover { filter: brightness(1.05); transform: translateY(-1px); }

  /* Bottom bar */
  .footer-bottom { background: var(--f-bg2); border-top: 1px solid var(--f-line); padding: 1.15rem 0; }
  .fb-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem 1rem; }
  .fb-copy { font-size: .78rem; color: var(--f-faint); }
  .fb-legal { display: flex; align-items: center; gap: .6rem; }
  .fb-legal a { font-size: .78rem; color: var(--f-muted); text-decoration: none; transition: color .15s; }
  .fb-legal a:hover { color: var(--f-rose-soft); }
  .fb-dot { color: var(--f-line); }
</style>
