---
import { Image } from "astro:assets";
import { transformS3Url, imagekitUrl } from '../utils/utils.js';
import MarkdownIt from 'markdown-it';
import { getVisibleEvents } from '../lib/queries';
import { eventSlug } from '../lib/event-slug';

// Initialize markdown renderer. html:true because event descriptions come from our own D1
// (admin-entered or synced from OUR Humanitix account, which stores HTML) — trusted content.
// Without it, Humanitix's HTML descriptions render as literal <p>/<h2> tags.
const md = new MarkdownIt({
  html: true,
  linkify: true, // Auto-convert URLs to links
  typographer: true // Enable smart quotes
});
// Plain-text (tags stripped) — for sliced previews so we never cut a tag in half.
const stripHtml = (s) => (s || '').replace(/<[^>]+>/g, ' ').replace(/&[a-z]+;/gi, ' ').replace(/\s+/g, ' ').trim();

// Load visible events from D1 — already shaped to { id, data: { ...camelCase } }
const events = await getVisibleEvents();

// Parse date strings as Arizona time (UTC-7, no DST)
// If no timezone is specified, assume Arizona time
// This ensures consistent parsing regardless of where the build runs (local vs Vercel UTC)
const parseArizonaDate = (dateStr: string): Date => {
  if (!dateStr) return new Date();
  // Check if the date string already has timezone info (Z, +XX:XX, -XX:XX)
  const hasTimezone = dateStr.includes('Z') ||
                      dateStr.includes('+') ||
                      /[-]\d{2}:?\d{2}$/.test(dateStr);
  if (!hasTimezone) {
    // Arizona is always UTC-7 (no DST)
    return new Date(dateStr + '-07:00');
  }
  return new Date(dateStr);
};

// Check if registration URL is valid (not empty, not site homepage)
const hasValidRegistrationUrl = (url: string): boolean => {
  if (!url || url.trim() === '') return false;
  const normalized = url.trim().toLowerCase();
  // Consider invalid if it's just the site URL (with or without trailing slash, http or https)
  return !normalized.match(/^https?:\/\/(www\.)?drbi\.org\/?$/);
};

// Branded fallback shown when an event has no image (prevents a broken <img>).
const FALLBACK_EVENT_IMG = 'https://cdn.shrtr.com/drbi.org/site/drbi/events.webp';

// Always use the real current date for filtering
const referenceDate = new Date();

// Expand events with additionalDates into multiple display instances
const expandedEvents = [];

events.forEach(event => {
  if (!event.data.visible) return;

  // Add the primary event instance
  const primaryDate = parseArizonaDate(event.data.startDate);
  if (primaryDate > referenceDate) {
    expandedEvents.push({
      ...event,
      isPrimary: true,
      instanceIndex: 0,
      dateSource: 'primary'
    });
  }

  // Add instances for each additional date
  if (Array.isArray(event.data.additionalDates)) {
    event.data.additionalDates.forEach((additionalDate, index) => {
      const instanceDate = parseArizonaDate(additionalDate.startDate);
      if (instanceDate > referenceDate) {
        expandedEvents.push({
          ...event,
          data: {
            ...event.data,
            startDate: additionalDate.startDate,
            endDate: additionalDate.endDate
          },
          isPrimary: false,
          instanceIndex: index + 1,
          dateSource: 'additional'
        });
      }
    });
  }
});

// Sort all expanded events by date
let upcomingEvents = expandedEvents
  .sort((a, b) => parseArizonaDate(a.data.startDate).getTime() - parseArizonaDate(b.data.startDate).getTime());

const { view = 'cards', limit } = Astro.props; // 'cards', 'list', or 'list-full', optional limit

// Apply limit if provided
if (limit) {
  upcomingEvents = upcomingEvents.slice(0, limit);
}

const formatDate = (date) => {
  return parseArizonaDate(date).toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'America/Phoenix'
  });
};

const formatDateRange = (startDate, endDate) => {
  const start = parseArizonaDate(startDate);
  const end = parseArizonaDate(endDate);
  const tz = 'America/Phoenix'; // Arizona timezone (no DST)

  const startDateStr = start.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: tz
  });

  const endDateStr = end.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    timeZone: tz
  });

  if (startDateStr === endDateStr) {
    return startDateStr;
  }

  return `${startDateStr} - ${endDateStr}`;
};

const formatTime = (date) => {
  return parseArizonaDate(date).toLocaleTimeString('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
    timeZone: 'America/Phoenix'
  });
};

const formatPrice = (price) => {
  if (!price) return 'Free';
  // Humanitix-synced events store price as an array of { label, amount, currency }.
  // Show the range of paid tickets (ignore $0 entries like the "any amount" donation).
  if (Array.isArray(price)) {
    const amounts = price.map((p) => Number(p?.amount)).filter((n) => Number.isFinite(n) && n > 0);
    if (!amounts.length) return 'Free';
    const low = Math.min(...amounts), high = Math.max(...amounts);
    return low === high ? `$${low}` : `$${low} - $${high}`;
  }
  // Legacy { low, high } shape.
  if (price.low == null && price.high == null) return 'Free';
  if (price.low === price.high) return `$${price.low}`;
  return `$${price.low} - $${price.high}`;
};

// Convert straight quotes to curly quotes
const curlyQuotes = (text: string): string => {
  if (!text) return '';
  const openDouble = '\u201C';  // "
  const closeDouble = '\u201D'; // "
  const openSingle = '\u2018';  // '
  const closeSingle = '\u2019'; // '
  return text
    .replace(/(\s|^)"(\S)/g, '$1' + openDouble + '$2')
    .replace(/(\S)"(\s|$|[.,!?])/g, '$1' + closeDouble + '$2')
    .replace(/(\s|^)'(\S)/g, '$1' + openSingle + '$2')
    .replace(/(\S)'(\s|$|[.,!?])/g, '$1' + closeSingle + '$2')
    .replace(/(\w)'(\w)/g, '$1' + closeSingle + '$2');  // apostrophe
};

// Humanitix descriptions often open by restating the event name (sometimes with
// a "::" subtitle). Strip that leading echo so the card preview doesn't repeat the
// title shown directly above it.
const stripLeadingTitle = (text, name) => {
  let t = (text || '').replace(/\s+/g, ' ').trim();
  const n = (name || '').replace(/\s+/g, ' ').trim();
  if (n && t.toLowerCase().startsWith(n.toLowerCase())) {
    t = t.slice(n.length).replace(/^[\s:·—–-]+/, '');
  }
  return t;
};

// Prepare display data for all events
let firstCompactShown = false;
const displayEvents = upcomingEvents.map(event => {
  const d = event.data;
  const hasValidReg = hasValidRegistrationUrl(d.registrationUrl);
  // Multi-day programs (e.g. weekend retreats) render large; single-session/evening events
  // and recurring secondary instances render compact.
  const isMultiDay = (() => {
    const s = parseArizonaDate(d.startDate);
    const e = d.endDate ? parseArizonaDate(d.endDate) : s;
    return !isNaN(+s) && !isNaN(+e) && e.toDateString() !== s.toDateString();
  })();
  // Multi-day programs (weekend retreats, multi-session challenges) always render large.
  // Single-session/evening events render compact — except the very next one, emphasized large.
  let isMinimal;
  if (isMultiDay) {
    isMinimal = false;
  } else {
    isMinimal = firstCompactShown;
    firstCompactShown = true;
  }
  const instanceId = event.instanceIndex > 0 ? `${event.id}-${event.instanceIndex}` : event.id;

  return {
    ...event,
    isMinimal,
    instanceId,
    display: {
      name: curlyQuotes(d.name),
      shortDescription: curlyQuotes(d.shortDescription || ''),
      fullDescription: curlyQuotes(d.fullDescription || ''),
      shortDescriptionHtml: md.render(d.shortDescription || ''),
      fullDescriptionHtml: md.render(d.fullDescription || ''),
      // Show truncated preview for all events (strip HTML first so we don't cut a tag in half)
      preview: curlyQuotes(
        d.fullDescription ? stripLeadingTitle(stripHtml(d.fullDescription), d.name).slice(0, 400) + '...' : d.shortDescription || 'Join us for this transformative learning experience.'
      ),
      previewHtml: md.render(
        d.fullDescription ? stripLeadingTitle(stripHtml(d.fullDescription), d.name).slice(0, 400) + '...' : stripHtml(d.shortDescription || '')
      ),
      // Flag if description is long enough to need expansion
      isLongDescription: !hasValidReg && stripHtml(d.fullDescription || '').length > 400,
      dateRange: formatDateRange(d.startDate, d.endDate),
      time: formatTime(d.startDate),
      price: formatPrice(d.price),
      // Per-type ticket prices for the card (exclude the "any amount" sponsor donation).
      ticketPrices: (Array.isArray(d.price) ? d.price : [])
        .filter((p) => !/sponsor a youth|any amount/i.test(p?.label ?? ''))
        .map((p) => ({ label: curlyQuotes(p?.label ?? ''), amount: Number(p?.amount) > 0 ? `$${Number(p.amount)}` : 'Free' })),
      month: parseArizonaDate(d.startDate).toLocaleDateString('en-US', { month: 'short', timeZone: 'America/Phoenix' }),
      day: parseArizonaDate(d.startDate).toLocaleDateString('en-US', { day: 'numeric', timeZone: 'America/Phoenix' }),
      weekday: parseArizonaDate(d.startDate).toLocaleDateString('en-US', { weekday: 'short', timeZone: 'America/Phoenix' }),
      // Multi-day programs show two date boxes (start → end) in the tile badge;
      // single-session events show one. Same badge style either way.
      isMultiDay,
      endMonth: d.endDate ? parseArizonaDate(d.endDate).toLocaleDateString('en-US', { month: 'short', timeZone: 'America/Phoenix' }) : '',
      endDay: d.endDate ? parseArizonaDate(d.endDate).toLocaleDateString('en-US', { day: 'numeric', timeZone: 'America/Phoenix' }) : '',
      // Fall back to the branded events image when an event has no photo — avoids a broken <img>.
      mainImage: transformS3Url(d.mainImage || FALLBACK_EVENT_IMG, 450, 300),
      mainImageLarge: transformS3Url(d.mainImage || FALLBACK_EVENT_IMG, 600, 400),
      // Full-width, face-centered banner via the blogworks resize service (ImageKit).
      // Only R2-hosted images (cdn.shrtr.com) transform; external URLs pass through
      // until the sync caches them to R2. See imagekitUrl + sync-events image caching.
      mainImageBanner: imagekitUrl(d.mainImage || FALLBACK_EVENT_IMG, { w: 1000, h: 340, face: true }),
      teacherImage: d.teacherImage ? transformS3Url(d.teacherImage, 200) : null,
      teacherImageLarge: d.teacherImage ? transformS3Url(d.teacherImage, 180) : null,
    }
  };
});

---

<div class="event-calendar" data-view={view}>
  {upcomingEvents.length === 0 ? (
    <div class="no-events text-center py-8">
      <p class="text-slate-600 text-lg">No upcoming events at this time.</p>
      <p class="text-slate-600 mt-2">Check back soon for new events!</p>
    </div>
  ) : view === 'timeline' ? (
    <div class="timeline-view">
      {displayEvents.map((event) => (
        <a
          href={`/events/${eventSlug(event)}`}
          class="timeline-item"
        >
          <div class="timeline-date-block">
            <span class="timeline-weekday">{event.display.weekday}</span>
            <span class="timeline-day">{event.display.day}</span>
            <span class="timeline-month">{event.display.month}</span>
          </div>
          <div class="timeline-connector">
            <div class="timeline-dot"></div>
            <div class="timeline-line"></div>
          </div>
          <div class="timeline-content">
            {event.display.teacherImageLarge && (
              <img src={event.display.teacherImageLarge} alt={`Teacher for ${event.display.name}`} class="timeline-avatar" width="120" height="120" loading="lazy" decoding="async" />
            )}
            <div class="timeline-details">
              <h3 class="timeline-title">{event.display.name}</h3>
              <div class="timeline-meta">
                <span class="timeline-time">{event.display.time}</span>
                {event.isMinimal && <span class="timeline-recurring-badge">Recurring</span>}
              </div>
              <p class="timeline-description">{event.display.shortDescription}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class={
      view === 'cards' ? 'flex flex-wrap gap-8 md:gap-[120px] justify-center p-5' :
      view === 'list-full' ? 'events-list-full' :
      'events-list'
    }>
      {displayEvents.map((event) => (<div
          id={`event-${event.instanceId}`}
          class={view === 'cards' ? 'relative' : 'event-container'}
          data-event-start={parseArizonaDate(event.data.startDate).toISOString()}
        >
          {view === 'cards' ? (
            <>
              <article class={`relative overflow-hidden w-full ${event.isMinimal ? 'max-w-[450px] h-[200px] opacity-80' : 'max-w-[450px] h-[300px]'} m-2 rounded-lg bg-white border border-gray-300 transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-2xl`}>
                {event.isMinimal && (
                  <div class="recurring-card-badge">
                    <span class="badge-icon">🔄</span>
                    <span class="badge-text">Recurring</span>
                  </div>
                )}
                <a
                  href={`/events/${eventSlug(event)}`}
                  class="block no-underline text-inherit h-full"
                >
                  <div class="relative w-full h-full bg-cover bg-center rounded-lg overflow-hidden" style={`background-image: url(${event.display.mainImage})`}>
                    <div class="event-overlay">
                      <div class="event-content">
                        <h3 class={`event-title ${event.isMinimal ? 'text-base' : ''}`}>{event.display.name}</h3>
                        <div class="event-meta">
                          <time class="event-date">{event.display.dateRange}</time>
                          <span class="event-time">{event.display.time}</span>
                          {!event.isMinimal && event.data.price && (
                            <span class="event-price">{event.display.price}</span>
                          )}
                        </div>
                      </div>
                    </div>
                  </div>
                </a>
              </article>
              {!event.isMinimal && event.display.teacherImage && (
                <div class="hidden md:block absolute top-0 -left-[90px] w-[150px] h-[160px] rounded-[30%] overflow-hidden border-[3px] border-white shadow-lg z-10 pointer-events-none">
                  <img src={event.display.teacherImage} alt={`Teacher for ${event.display.name}`} class="w-full h-full object-cover" />
                </div>
              )}
            </>
          ) : view === 'list-full' ? (
            <a href={`/events/${eventSlug(event)}`} class={`ev-tile ${event.isMinimal ? 'ev-tile--sm' : 'ev-tile--lg'}`} aria-label={event.display.name}>
              <div class="ev-tile-img" style={`background-image:url(${event.display.mainImageBanner})`}></div>
              <div class="ev-tile-content">
                {event.display.isMultiDay ? (
                  <div class="ev-tile-daterange">
                    <div class="ev-tile-date">
                      <span class="ev-tile-month">{event.display.month}</span>
                      <span class="ev-tile-day">{event.display.day}</span>
                    </div>
                    <span class="ev-tile-arrow" aria-hidden="true">→</span>
                    <div class="ev-tile-date">
                      <span class="ev-tile-month">{event.display.endMonth}</span>
                      <span class="ev-tile-day">{event.display.endDay}</span>
                    </div>
                  </div>
                ) : (
                  <div class="ev-tile-date">
                    <span class="ev-tile-month">{event.display.month}</span>
                    <span class="ev-tile-day">{event.display.day}</span>
                  </div>
                )}
                <div class="ev-tile-main">
                  <h3 class="ev-tile-title">{event.display.name}</h3>
                  <div class="ev-tile-meta">
                    <span>{event.display.dateRange}</span>
                    <span class="ev-dot" aria-hidden="true">·</span>
                    <span>{event.display.time}</span>
                    {event.display.ticketPrices.length > 0 && (
                      <><span class="ev-dot" aria-hidden="true">·</span><span>from {event.display.ticketPrices[0].amount}</span></>
                    )}
                  </div>
                  {!event.isMinimal && event.display.shortDescription && (
                    <p class="ev-tile-desc">{event.display.shortDescription}</p>
                  )}
                </div>
                <span class="ev-tile-cta">See details <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ) : (
            <article class={`event-list-item ${event.isMinimal ? 'opacity-70' : ''}`}>
              <div class="list-event">
                <div class="list-date">
                  <div class="month">{event.display.month}</div>
                  <div class="day">{event.display.day}</div>
                  {event.isMinimal && (
                    <div class="recurring-list-badge">🔄</div>
                  )}
                </div>
                <div class="list-content">
                  <h3 class={`list-title ${event.isMinimal ? 'text-base' : ''}`}>
                    <a href={`/events/${eventSlug(event)}`}>{event.display.name}</a>
                  </h3>
                  <div class="list-meta">
                    <span class="time-icon" aria-hidden="true">🕐&nbsp;</span><time>{event.display.time}</time>
                    {!event.isMinimal && event.data.price && (
                      <>
                        <span class="separator" aria-hidden="true">•</span>
                        <span class="price-icon" aria-hidden="true">💰&nbsp;</span><span class="price">{event.display.price}</span>
                      </>
                    )}
                  </div>
                  {!event.isMinimal && (
                    <div class="list-description" set:html={event.display.shortDescriptionHtml}></div>
                  )}
                </div>
                <div class="list-actions">
                  <a href={`/admin/events/${event.data.id}`} class="edit-btn">
                    <span class="edit-icon" aria-hidden="true">✏️&nbsp;</span>
                    <span class="edit-text">Edit</span>
                  </a>
                </div>
              </div>
            </article>
          )}
        </div>
      ))}
    </div>
  )}
</div>

<script>
  // Hide events that have passed since the static build
  function hideExpiredEvents() {
    const now = new Date();
    const eventElements = document.querySelectorAll('[data-event-start]');

    eventElements.forEach((element) => {
      const startDate = element.getAttribute('data-event-start');
      if (startDate) {
        const eventDate = new Date(startDate);
        if (eventDate <= now) {
          element.classList.add('event-expired');
        }
      }
    });
  }

  // Run on page load
  hideExpiredEvents();

  // Auto-expand and scroll to event from hash
  function handleHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const targetEl = document.querySelector(hash);
    if (!targetEl) return;

    // Extract event ID from the hash (remove #event- prefix)
    const eventId = hash.replace('#event-', '');

    // Expand if it's a collapsed minimal event
    const contentEl = targetEl.querySelector(`.expandable-content[data-event-id="${eventId}"]`);
    if (contentEl && contentEl.classList.contains('collapsed')) {
      contentEl.classList.remove('collapsed');
      const btn = targetEl.querySelector(`.show-more-btn[data-event-id="${eventId}"]`);
      if (btn) {
        btn.setAttribute('aria-expanded', 'true');
        btn.querySelector('.btn-text').textContent = 'Show Less';
        btn.querySelector('.btn-icon').textContent = '↑';
      }
    }

    // Scroll into view
    setTimeout(() => {
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }

  handleHash();
  window.addEventListener('hashchange', handleHash);

  // Toggle description expansion
  window.toggleDescription = function(eventId) {
    const previewEl = document.querySelector(`[data-event-id="${eventId}"].event-preview-text`);
    const buttonEl = document.querySelector(`[data-event-id="${eventId}"].show-more-btn`);

    if (!previewEl || !buttonEl) return;

    const isExpanded = buttonEl.classList.contains('expanded');
    const previewHtml = previewEl.getAttribute('data-preview-html');
    const fullHtml = previewEl.getAttribute('data-full-html');

    if (isExpanded) {
      // Collapse
      previewEl.innerHTML = previewHtml;
      buttonEl.classList.remove('expanded');
      buttonEl.setAttribute('aria-expanded', 'false');
      buttonEl.querySelector('.btn-text').textContent = 'Show More';
      buttonEl.querySelector('.btn-icon').textContent = '↓';
    } else {
      // Expand
      previewEl.innerHTML = fullHtml;
      buttonEl.classList.add('expanded');
      buttonEl.setAttribute('aria-expanded', 'true');
      buttonEl.querySelector('.btn-text').textContent = 'Show Less';
      buttonEl.querySelector('.btn-icon').textContent = '↑';
    }
  };

  // Toggle minimal event expansion
  window.toggleMinimalEvent = function(eventId) {
    const contentEl = document.querySelector(`.expandable-content[data-event-id="${eventId}"]`);
    const buttonEl = document.querySelector(`[data-event-id="${eventId}"].show-more-btn`);

    if (!contentEl || !buttonEl) return;

    const isCollapsed = contentEl.classList.contains('collapsed');

    if (isCollapsed) {
      // Expand
      contentEl.classList.remove('collapsed');
      buttonEl.setAttribute('aria-expanded', 'true');
      buttonEl.querySelector('.btn-text').textContent = 'Show Less';
      buttonEl.querySelector('.btn-icon').textContent = '↑';
    } else {
      // Collapse
      contentEl.classList.add('collapsed');
      buttonEl.setAttribute('aria-expanded', 'false');
      buttonEl.querySelector('.btn-text').textContent = 'Show More';
      buttonEl.querySelector('.btn-icon').textContent = '↓';
    }
  };

  // Toggle recurring event dates
  window.toggleRecurringDates = function(groupId) {
    const collapsedEl = document.querySelector(`.dates-collapsed[data-group-id="${groupId}"]`);
    const expandedEl = document.querySelector(`.dates-expanded[data-group-id="${groupId}"]`);

    if (!collapsedEl || !expandedEl) return;

    const isExpanded = expandedEl.style.display !== 'none';

    if (isExpanded) {
      // Collapse
      collapsedEl.style.display = 'block';
      expandedEl.style.display = 'none';
    } else {
      // Expand
      collapsedEl.style.display = 'none';
      expandedEl.style.display = 'block';
    }
  };
</script>

<style>
/* Hide expired events */
.event-expired {
  display: none !important;
}

/* Keep only the complex gradient that can't be done with Tailwind */
.event-overlay {
  position: absolute;
  bottom: -10px;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.5) 50%, transparent 100%);
  padding: 25px 20px;
  color: white;
}

.event-content {
  position: relative;
  z-index: 2;
}

.event-title {
  font-size: 1.4rem;
  font-weight: 600;
  color: white;
  margin: 0 0 8px 0;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}

.event-meta {
  margin-bottom: 12px;
  font-size: 0.875rem;
  color: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.event-date {
  font-weight: 600;
  color: rgba(255, 255, 255, 1);
  text-shadow: 0 1px 2px rgba(0,0,0,0.5);
}

.event-time {
  color: rgba(255, 255, 255, 0.8);
}

.event-location {
  color: rgba(255, 255, 255, 0.8);
}

.event-price {
  font-weight: 600;
  color: rgb(134, 239, 172);
  text-shadow: 0 1px 2px rgba(0,0,0,0.5);
}

.event-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.highlight-tag {
  background-color: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  padding: 3px 8px;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 500;
  border: 1px solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(4px);
}

/* List View */
.events-list {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
}

