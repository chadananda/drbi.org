/* Responsive Design */
@media (max-width: 768px) {
  .events-grid {
    padding: 10px;
    gap: 15px;
  }
  
  .event-card {
    flex: 0 1 280px;
    margin: 5px;
  }
  
  .list-event {
    flex-direction: column;
    gap: 12px;
  }
  
  .list-date {
    align-self: flex-start;
  }
}

/* List Full View */
.events-list-full {
  /* This list is nested inside a narrow `.prose` reading column (~655px) but
     an events grid needs room. Break out and self-center on the viewport. */
  width: min(900px, calc(100vw - 2rem));
  max-width: none;
  margin-left: 50%;
  transform: translateX(-50%);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
}

/* Image-backed event tiles (list-full view) — the whole tile links to the detail page. */
.ev-tile {
  position: relative; display: block; border-radius: 16px; overflow: hidden;
  text-decoration: none; color: #fff; box-shadow: 0 12px 30px -14px rgba(0,0,0,.45);
  transition: transform .25s ease, box-shadow .25s ease;
}
.ev-tile:hover { transform: translateY(-3px); box-shadow: 0 26px 54px -22px rgba(0,0,0,.55); }
/* Force white text over the image — beats the .prose h3/a/p colors this list is nested inside. */
.ev-tile, .ev-tile .ev-tile-title, .ev-tile .ev-tile-meta, .ev-tile .ev-tile-desc, .ev-tile .ev-tile-cta, .ev-tile .ev-dot { color: #fff; }
.ev-tile--lg { min-height: 340px; }
.ev-tile--sm { min-height: 150px; }
/* De-emphasize secondary one-day events: indent them beneath the emphasized (next + retreat) programs. */
@media (min-width: 641px) { .ev-tile--sm { margin-left: 3.5rem; } }
.ev-tile-img { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform .55s ease; }
.ev-tile:hover .ev-tile-img { transform: scale(1.05); }
.ev-tile::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(10,7,3,0) 0%, rgba(10,7,3,0) 48%, rgba(10,7,3,.45) 72%, rgba(10,7,3,.9) 100%);
}
.ev-tile-content {
  position: relative; z-index: 1; display: flex; align-items: flex-end; gap: 1.1rem;
  min-height: inherit; padding: 1.2rem 1.4rem;
}
.ev-tile--lg .ev-tile-content { padding: 1.9rem 2.1rem; }
.ev-tile-date {
  flex-shrink: 0; align-self: flex-start; text-align: center; line-height: 1;
  background: rgba(255,255,255,.95); color: #2a1c0b; border-radius: 12px; padding: .5rem .7rem .45rem;
  box-shadow: 0 4px 12px rgba(0,0,0,.25);
}
.ev-tile-month { display: block; font-size: .68rem; font-weight: 700; letter-spacing: .12em; color: #a04607; }
.ev-tile-day { display: block; font-family: 'Merriweather', Georgia, serif; font-size: 1.7rem; font-weight: 700; margin-top: .12rem; }
.ev-tile-daterange { display: flex; align-items: center; gap: .45rem; align-self: flex-start; }
.ev-tile-daterange .ev-tile-date { align-self: auto; }
.ev-tile-arrow { color: #fff; font-weight: 700; font-size: 1.15rem; text-shadow: 0 1px 3px rgba(0,0,0,.55); }
.ev-tile-main { flex: 1; min-width: 0; }
.ev-tile-title { font-family: 'Merriweather', Georgia, serif; font-weight: 400; line-height: 1.15; margin: 0 0 .4rem; font-size: 1.55rem; text-shadow: 0 1px 4px rgba(0,0,0,.55); }
.ev-tile--sm .ev-tile-title { font-size: 1.18rem; margin-bottom: .25rem; }
.ev-tile-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; font-size: .86rem; opacity: .95; text-shadow: 0 1px 3px rgba(0,0,0,.5); }
.ev-dot { opacity: .55; }
.ev-tile-desc { margin: .65rem 0 0; font-size: .93rem; line-height: 1.5; opacity: .93; max-width: 44rem; text-shadow: 0 1px 3px rgba(0,0,0,.5); }
.ev-tile-cta { flex-shrink: 0; align-self: flex-end; font-weight: 600; font-size: .9rem; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,.5); }
@media (max-width: 640px) {
  .ev-tile-content { flex-direction: column; align-items: flex-start; gap: .8rem; }
  .ev-tile-cta { align-self: flex-start; }
  .ev-tile-title { font-size: 1.35rem; }
}

