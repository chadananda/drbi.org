---
// Conversion-focused featured-event cards for the homepage: dramatic date, live countdown,
// and a strong "reserve" CTA. Enticing sign-ups is the homepage's primary job.
import { getVisibleEvents } from "../lib/queries";
import { eventSlug } from "../lib/event-slug";
import { imagekitUrl } from "../utils/utils.js";

const { limit = 2 } = Astro.props;
const FALLBACK_EVENT_IMG = "https://cdn.shrtr.com/drbi.org/site/drbi/events.webp";
const now = new Date();

const all = await getVisibleEvents().catch(() => []);
const upcoming = all
  .filter((e) => e?.data?.visible !== false)
  .map((e) => ({ ...e, _start: new Date(e.data.startDate), _end: new Date(e.data.endDate || e.data.startDate) }))
  .filter((e) => !isNaN(e._start) && e._end >= now)
  .sort((a, b) => a._start - b._start)
  .slice(0, limit)
  // Emphasis: the NEXT event (first upcoming) and any multi-day program (retreat/intensive)
  // render large; single-session events after the first render compact.
  .map((e, i) => ({ ...e, _large: i === 0 || e._end.toDateString() !== e._start.toDateString() }));

const AZ = "America/Phoenix";
const monthOf = (d) => d.toLocaleDateString("en-US", { month: "short", timeZone: AZ }).toUpperCase();
const dayRange = (s, e) => {
  if (!e || +e === +s || e.toDateString() === s.toDateString()) return String(s.getDate());
  const sameMonth = s.getMonth() === e.getMonth() && s.getFullYear() === e.getFullYear();
  return sameMonth ? `${s.getDate()}–${e.getDate()}` : `${s.getDate()} ${monthOf(s)} – ${e.getDate()} ${monthOf(e)}`;
};
const weekdayOf = (s, e) => {
  const w = (d) => d.toLocaleDateString("en-US", { weekday: "long", timeZone: AZ });
  if (!e || e.toDateString() === s.toDateString()) return w(s);
  return `${w(s)}–${e.toLocaleDateString("en-US", { weekday: "short", timeZone: AZ })}`;
};
const stripHtml = (s) => (s || "").replace(/<[^>]+>/g, " ").replace(/&[a-z]+;/gi, " ").replace(/\s+/g, " ").trim();
const previewOf = (ev) => {
  let t = stripHtml(ev.data.fullDescription || ev.data.shortDescription || "");
  const n = (ev.data.name || "").trim();
  if (n && t.toLowerCase().startsWith(n.toLowerCase())) t = t.slice(n.length).replace(/^[\s:·—–-]+/, "");
  t = t.replace(/\s+::\s+/g, " — ");
  return t.length > 150 ? t.slice(0, 150).replace(/\s+\S*$/, "") + "…" : t;
};
const priceOf = (price) => {
  if (!Array.isArray(price)) return "";
  const amts = price.map((p) => Number(p?.amount)).filter((n) => Number.isFinite(n) && n > 0);
  if (!amts.length) return "Free";
  return `$${Math.min(...amts)}`;
};
const locOf = (ev) => {
  const l = ev.data.location || {};
  return l.online ? "Online" : (l.venue || "Desert Rose, Eloy AZ");
};
---

{upcoming.length === 0 ? (
  <p class="he-empty">No upcoming programs are scheduled right now — check back soon.</p>
) : (
  <div class="home-events">
    {upcoming.map((ev) => (
      <article class={`he-card ${ev._large ? "he-card--lg" : "he-card--sm"}`}>
        <a href={`/events/${eventSlug(ev)}`} class="he-media" aria-label={ev.data.name}>
          <img src={imagekitUrl(ev.data.mainImage || FALLBACK_EVENT_IMG, { w: 640, h: 520, face: true })} alt={ev.data.name} loading="lazy" decoding="async" width="640" height="520" />
        </a>
        <span class="he-countdown" data-event-start={ev.data.startDate} aria-hidden="true"></span>

        <div class="he-body">
          <div class="he-datebox">
            <span class="he-month">{monthOf(ev._start)}</span>
            <span class="he-days">{dayRange(ev._start, ev._end)}</span>
            <span class="he-year">{ev._start.getFullYear()}</span>
          </div>
          <div class="he-main">
            <p class="he-weekday">{weekdayOf(ev._start, ev._end)}</p>
            <h3 class="he-title"><a href={`/events/${eventSlug(ev)}`}>{ev.data.name}</a></h3>
            {previewOf(ev) && <p class="he-desc">{previewOf(ev)}</p>}
            <div class="he-actions">
              <a href={`/events/${eventSlug(ev)}`} class="he-cta">{ev.data.registrationUrl ? "Reserve your spot" : "See details"} &rarr;</a>
              <span class="he-meta">
                <span>{locOf(ev)}</span>
                {priceOf(ev.data.price) && <span class="he-dot">&middot;</span>}
                {priceOf(ev.data.price) && <span class="he-price">from {priceOf(ev.data.price)}</span>}
              </span>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
)}

<style>
  .home-events { display: flex; flex-direction: column; gap: 1.75rem; max-width: 62rem; margin: 0 auto; }
  .he-empty { text-align: center; color: var(--color-muted); font-size: 1rem; }

  .he-card {
    position: relative;
    display: grid; grid-template-columns: 1fr; background: var(--color-surface);
    border: 1px solid var(--color-line); border-radius: 20px;
    box-shadow: 0 1px 2px rgba(60,45,20,.05); transition: box-shadow .25s, transform .25s, border-color .25s;
  }
  @media (min-width: 760px) {
    .he-card--lg { grid-template-columns: 17rem 1fr; }
    .he-card--sm { grid-template-columns: 12rem 1fr; }
  }
  .he-card:hover { box-shadow: 0 26px 50px -26px rgba(70,50,20,.4); transform: translateY(-3px); border-color: #e6d4b4; }

  /* Media — clips its own corners + zoom; image is absolutely filled so the CARD height is
     driven by the content (the event), never by the raw image's aspect ratio. */
  .he-media {
    position: relative; display: block; overflow: hidden; background: #f3efe8;
    min-height: 220px; border-radius: 20px 20px 0 0;
  }
  @media (min-width: 760px) { .he-media { min-height: 0; border-radius: 20px 0 0 20px; } }
  .he-media img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center; display: block; transition: transform .55s ease;
  }
  .he-card:hover .he-media img { transform: scale(1.05); }

  /* Countdown straddles the image edge (image/body seam on desktop, image bottom on mobile)
     rather than covering the photo. Lives on the card so the media's clip doesn't crop it. */
  .he-countdown {
    position: absolute; top: 220px; left: 1.1rem; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: .35rem; z-index: 2;
    padding: .32rem .7rem; border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; color: #2a1c0b; background: rgba(255,255,255,.95); backdrop-filter: blur(4px);
    box-shadow: 0 3px 12px rgba(0,0,0,.22); opacity: 0; transition: opacity .3s; white-space: nowrap;
  }
  @media (min-width: 760px) {
    .he-countdown { top: auto; bottom: 1.3rem; left: 17rem; transform: translateX(-50%); }
  }
  .he-countdown.ready { opacity: 1; }
  .he-countdown.urgent { color: #fff; background: var(--color-brand); }

  .he-body { display: grid; grid-template-columns: auto 1fr; gap: 1.4rem; padding: 1.7rem 1.8rem 1.8rem; align-items: start; }

  /* Dramatic date box */
  .he-datebox {
    display: flex; flex-direction: column; align-items: center; text-align: center; flex-shrink: 0;
    min-width: 4.6rem; padding: .7rem .7rem .55rem; border-radius: 14px;
    background: var(--color-brand-soft); border: 1px solid #efe0c6; line-height: 1;
  }
  .he-month { font-size: .74rem; font-weight: 700; letter-spacing: .14em; color: var(--color-brand); }
  .he-days { font-family: 'Merriweather', Georgia, serif; font-size: 2.15rem; font-weight: 700; color: var(--color-ink); margin: .18rem 0; letter-spacing: -.01em; }
  .he-year { font-size: .72rem; color: var(--color-muted); font-variant-numeric: tabular-nums; }

  .he-main { min-width: 0; }
  .he-weekday { font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); margin: .1rem 0 .5rem; }
  .he-title { font-family: 'Merriweather', Georgia, serif; font-weight: 400; font-size: 1.55rem; line-height: 1.2; margin: 0; }
  .he-title a { color: var(--color-ink); text-decoration: none; transition: color .15s; }
  .he-card:hover .he-title a { color: var(--color-brand-deep); }
  .he-desc { margin: .7rem 0 0; font-size: .95rem; line-height: 1.6; color: var(--color-body); }

  .he-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.1rem; margin-top: 1.25rem; }
  .he-cta {
    display: inline-flex; align-items: center; padding: .62rem 1.3rem; border-radius: 999px;
    font-size: .9rem; font-weight: 600; letter-spacing: .01em; text-decoration: none; color: #fff;
    background: linear-gradient(180deg, #c05f14, #a04607); box-shadow: 0 10px 22px -10px rgba(160,70,7,.65);
    transition: filter .15s, transform .12s;
  }
  .he-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .he-meta { display: inline-flex; align-items: center; gap: .45rem; font-size: .84rem; color: var(--color-muted); }
  .he-dot { color: #cbbfac; }
  .he-price { font-weight: 600; color: var(--color-brand-deep); }

  /* Compact variant — secondary single-session events (smaller image, tighter body, no blurb). */
  .he-card--sm .he-media { min-height: 150px; }
  .he-card--sm .he-body { padding: 1.15rem 1.55rem 1.2rem; gap: 1.1rem; }
  .he-card--sm .he-datebox { min-width: 3.9rem; padding: .55rem .55rem .45rem; }
  .he-card--sm .he-days { font-size: 1.55rem; }
  .he-card--sm .he-weekday { margin-bottom: .3rem; }
  .he-card--sm .he-title { font-size: 1.18rem; }
  .he-card--sm .he-desc { display: none; }
  .he-card--sm .he-actions { margin-top: .85rem; }
  .he-card--sm .he-countdown { top: 150px; }
  @media (min-width: 760px) {
    .he-card--sm .he-countdown { top: auto; left: 12rem; }
    /* Indent secondary one-day events so the emphasized (next + retreat) programs lead. */
    .he-card--sm { margin-left: 3.5rem; }
  }

  @media (max-width: 480px) {
    .he-body { grid-template-columns: 1fr; gap: 1rem; }
    .he-datebox { flex-direction: row; gap: .5rem; align-items: baseline; min-width: 0; width: fit-content; }
    .he-days { font-size: 1.5rem; margin: 0; }
  }
</style>

<script is:inline>
  (function () {
    var els = document.querySelectorAll('.he-countdown[data-event-start]');
    var now = Date.now();
    els.forEach(function (el) {
      var start = new Date(el.getAttribute('data-event-start')).getTime();
      if (isNaN(start)) return;
      var days = Math.ceil((start - now) / 86400000);
      var t;
      if (days < 0) t = 'Happening now';
      else if (days === 0) t = 'Starts today';
      else if (days === 1) t = 'Tomorrow';
      else if (days <= 45) t = days + ' days away';
      else { var m = Math.round(days / 30); t = 'In ' + m + ' month' + (m === 1 ? '' : 's'); }
      el.textContent = t;
      el.classList.add('ready');
      if (days >= 0 && days <= 10) el.classList.add('urgent');
    });
  })();
</script>
