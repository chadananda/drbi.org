---
// Slim admin top bar: breadcrumb (left) + View site / user menu (right). Replaces the public navbar.
import AdminIcon from "@components/admin/AdminIcon.astro";
interface Props { title?: string; user?: any; }
const { title = "Dashboard", user = null } = Astro.props;
const name = user?.name || user?.email || "Admin";
const role = (user?.role || "").replace(/^\w/, (c: string) => c.toUpperCase()) || "Staff";
const avatar = user?.avatar || "";
const initials = String(name).trim().split(/\s+/).map((s: string) => s[0]).slice(0, 2).join("").toUpperCase() || "A";
---
<header class="a-topbar">
  <div class="a-topbar-left">
    <button id="adminMobileMenu" type="button" class="a-topbar-burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="a-crumbs" aria-label="Breadcrumb">
      <span class="a-crumb-root">Admin</span>
      <span class="a-crumb-sep">/</span>
      <span class="a-crumb-here">{title}</span>
    </nav>
  </div>

  <div class="a-topbar-right">
    <a href="/" target="_blank" rel="noopener" class="a-topbar-link">
      View site <AdminIcon name="external" size={14} />
    </a>
    <div class="a-usermenu" id="aUserMenu">
      <button type="button" class="a-user-chip" id="aUserBtn" aria-haspopup="true" aria-expanded="false">
        {avatar
          ? <img src={avatar} alt="" class="a-avatar-img" />
          : <span class="a-avatar">{initials}</span>}
        <span class="a-user-meta">
          <span class="a-user-name">{name}</span>
          <span class="a-user-role">{role}</span>
        </span>
        <AdminIcon name="chevron-down" size={15} class="a-user-caret" />
      </button>
      <div class="a-user-pop" id="aUserPop" role="menu">
        <a href="/admin/settings" role="menuitem" class="a-user-item"><AdminIcon name="settings" size={16} /> Settings</a>
        <a href="/" target="_blank" rel="noopener" role="menuitem" class="a-user-item"><AdminIcon name="external" size={16} /> View site</a>
        <form method="POST" action="/api/auth/logout" class="a-user-logout">
          <button type="submit" role="menuitem" class="a-user-item"><AdminIcon name="logout" size={16} /> Log out</button>
        </form>
      </div>
    </div>
  </div>
</header>

<style>
  .a-topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between;
    height: 60px; padding: 0 clamp(1rem, 3vw, 1.75rem); background: rgba(250,249,246,.85); backdrop-filter: saturate(1.1) blur(8px);
    border-bottom: 1px solid var(--a-line); }
  .a-topbar-left, .a-topbar-right { display: flex; align-items: center; gap: .9rem; }

  .a-crumbs { display: flex; align-items: center; gap: .55rem; font-size: .95rem; }
  .a-crumb-root { color: var(--a-muted); }
  .a-crumb-sep { color: #ccc4b6; }
  .a-crumb-here { font-family: 'Fraunces', Georgia, serif; font-weight: 500; color: var(--a-ink); }

  .a-topbar-link { display: inline-flex; align-items: center; gap: .35rem; font-size: .85rem; font-weight: 600; color: var(--a-ink-2); text-decoration: none; padding: .4rem .7rem; border-radius: 999px; transition: background .15s, color .15s; }
  .a-topbar-link:hover { background: #efe9dd; color: var(--a-ink); }

  .a-usermenu { position: relative; }
  .a-user-chip { display: flex; align-items: center; gap: .6rem; background: transparent; border: 1px solid transparent; border-radius: 999px; padding: .3rem .5rem .3rem .35rem; cursor: pointer; transition: background .15s, border-color .15s; }
  .a-user-chip:hover { background: var(--a-panel); border-color: var(--a-line); }
  .a-avatar, .a-avatar-img { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; }
  .a-avatar { display: grid; place-items: center; background: linear-gradient(180deg,#2a2620,#1c1a16); color: #e9dcc4; font-size: .72rem; font-weight: 700; letter-spacing: .02em; }
  .a-avatar-img { object-fit: cover; }
  .a-user-meta { display: flex; flex-direction: column; line-height: 1.15; text-align: left; }
  .a-user-name { font-size: .82rem; font-weight: 600; color: var(--a-ink); }
  .a-user-role { font-size: .7rem; color: var(--a-muted); }
  .a-user-caret { color: var(--a-muted); }

  .a-user-pop { position: absolute; right: 0; top: calc(100% + 8px); min-width: 190px; background: var(--a-panel);
    border: 1px solid var(--a-line); border-radius: var(--a-radius-sm); box-shadow: 0 12px 34px -12px rgba(40,30,10,.28);
    padding: .35rem; opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .15s, transform .15s, visibility .15s; }
  .a-usermenu.open .a-user-pop { opacity: 1; visibility: visible; transform: none; }
  .a-user-item { display: flex; align-items: center; gap: .6rem; width: 100%; padding: .5rem .6rem; border-radius: 7px; font-size: .85rem; color: var(--a-ink-2); text-decoration: none; background: transparent; border: none; cursor: pointer; text-align: left; }
  .a-user-item:hover { background: var(--a-panel-2); color: var(--a-ink); }
  .a-user-logout { border-top: 1px solid var(--a-line-2); margin-top: .25rem; padding-top: .25rem; }
  .a-user-logout .a-user-item { color: var(--a-red); }

  .a-topbar-burger { display: none; flex-direction: column; gap: 4px; width: 38px; height: 38px; align-items: center; justify-content: center; background: transparent; border: 1px solid var(--a-line); border-radius: 9px; cursor: pointer; }
  .a-topbar-burger span { width: 16px; height: 1.6px; background: var(--a-ink-2); border-radius: 2px; }
  @media (max-width: 900px) { .a-topbar-burger { display: flex; } .a-user-meta { display: none; } }
</style>

<script>
  const menu = document.getElementById('aUserMenu');
  const btn = document.getElementById('aUserBtn');
  btn?.addEventListener('click', (e) => { e.stopPropagation(); menu?.classList.toggle('open'); btn.setAttribute('aria-expanded', String(menu?.classList.contains('open'))); });
  document.addEventListener('click', (e) => { if (menu && !menu.contains(e.target as Node)) menu.classList.remove('open'); });
</script>
