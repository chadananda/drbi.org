---
// Dark warm sidebar rail: DRBI wordmark, uniform line-icon nav, brass active state.
import AdminIcon from "@components/admin/AdminIcon.astro";
const path = Astro.url.pathname;
const user = Astro.props.user ?? Astro.locals?.user ?? null;
const name = user?.name || user?.email || "Admin";
const role = (user?.role || "staff").replace(/^\w/, (c: string) => c.toUpperCase());
const initials = String(name).trim().split(/\s+/).map((s: string) => s[0]).slice(0, 2).join("").toUpperCase() || "A";

const on = (p: string, exact = false) => exact ? path === p : path.startsWith(p);
const nav = [
  { title: "Dashboard", icon: "dashboard", href: "/admin", active: path === "/admin" },
  { title: "Analytics", icon: "analytics", href: "/admin/analytics", active: on("/admin/analytics") },
  { title: "Content", icon: "content", href: "/admin/posts", active: on("/admin/posts") || on("/admin/memorial") || on("/admin/news") || on("/admin/articles") },
  { title: "Events", icon: "events", href: "/admin/events", active: on("/admin/events") },
  { title: "Organization", icon: "organization", items: [
    { title: "Categories", href: "/admin/categories", active: on("/admin/categories") },
    { title: "Topics", href: "/admin/topics", active: on("/admin/topics") },
    { title: "Tags", href: "/admin/tags", active: on("/admin/tags") },
  ]},
  { title: "Media", icon: "media", items: [
    { title: "Media Library", href: "/admin/media", active: path === "/admin/media" },
    { title: "Upload Files", href: "/admin/media/upload", active: path === "/admin/media/upload" },
  ]},
  { title: "Team", icon: "team", href: "/admin/team", active: on("/admin/team") },
  { title: "Users", icon: "users", href: "/admin/users", active: on("/admin/users") },
  { title: "Settings", icon: "settings", href: "/admin/settings", active: path === "/admin/settings" },
];
---
<aside class="admin-sidebar" id="adminSidebar">
  <a href="/admin" class="a-brand">
    <span class="a-brand-mark">DRBI</span>
    <span class="a-brand-sub">Content Studio</span>
  </a>

  <nav class="a-side-nav" aria-label="Admin">
    {nav.map((item) => item.items ? (
      <div class="a-nav-group" data-open={item.items.some((s) => s.active) ? "true" : "false"}>
        <button type="button" class="a-nav-link a-nav-toggle" aria-expanded={item.items.some((s) => s.active) ? "true" : "false"}>
          <AdminIcon name={item.icon} size={19} class="a-nav-ic" />
          <span class="a-nav-label">{item.title}</span>
          <AdminIcon name="chevron" size={15} class="a-nav-caret" />
        </button>
        <div class="a-nav-sub">
          {item.items.map((s) => (
            <a href={s.href} class={`a-nav-subitem ${s.active ? "is-active" : ""}`}>{s.title}</a>
          ))}
        </div>
      </div>
    ) : (
      <a href={item.href} class={`a-nav-link ${item.active ? "is-active" : ""}`}>
        <AdminIcon name={item.icon} size={19} class="a-nav-ic" />
        <span class="a-nav-label">{item.title}</span>
      </a>
    ))}
  </nav>

  <div class="a-side-foot">
    <span class="a-side-avatar">{initials}</span>
    <span class="a-side-user">
      <span class="a-side-name">{name}</span>
      <span class="a-side-role">{role}</span>
    </span>
  </div>
</aside>

<style>
  .admin-sidebar {
    width: 258px; flex-shrink: 0; align-self: stretch;
    background: var(--a-side); color: var(--a-side-ink);
    display: flex; flex-direction: column;
    position: sticky; top: 0; height: 100vh;
    border-right: 1px solid var(--a-side-line);
  }

  .a-brand { display: flex; flex-direction: column; gap: 2px; padding: 1.4rem 1.5rem 1.25rem; text-decoration: none; border-bottom: 1px solid var(--a-side-line); }
  .a-brand-mark { font-family: 'Fraunces', Georgia, serif; font-weight: 500; font-size: 1.4rem; letter-spacing: .04em; color: #f4ecdc; }
  .a-brand-sub { font-size: .62rem; text-transform: uppercase; letter-spacing: .28em; color: var(--a-side-accent); font-weight: 600; }

  .a-side-nav { flex: 1; overflow-y: auto; padding: .85rem .7rem; display: flex; flex-direction: column; gap: 2px; }
  .a-side-nav::-webkit-scrollbar { width: 8px; }
  .a-side-nav::-webkit-scrollbar-thumb { background: #38322791; border-radius: 8px; }

  .a-nav-link { display: flex; align-items: center; gap: .75rem; width: 100%; padding: .6rem .7rem; border-radius: 9px;
    color: var(--a-side-ink); font-size: .9rem; font-weight: 500; text-decoration: none; background: transparent; border: none; cursor: pointer;
    position: relative; transition: background .15s, color .15s; }
  .a-nav-link:hover { background: var(--a-side-2); color: var(--a-side-active); }
  .a-nav-ic { color: var(--a-side-muted); transition: color .15s; }
  .a-nav-link:hover .a-nav-ic { color: var(--a-side-ink); }
  .a-nav-label { flex: 1; text-align: left; }

  .a-nav-link.is-active { background: linear-gradient(90deg, rgba(207,154,78,.16), rgba(207,154,78,.05)); color: #f7efe0; }
  .a-nav-link.is-active .a-nav-ic { color: var(--a-side-accent); }
  .a-nav-link.is-active::before { content: ""; position: absolute; left: -.7rem; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; background: var(--a-side-accent); border-radius: 0 3px 3px 0; }

  .a-nav-caret { color: var(--a-side-muted); transition: transform .2s; }
  .a-nav-group[data-open="true"] .a-nav-caret { transform: rotate(90deg); }
  .a-nav-sub { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .22s ease; }
  .a-nav-group[data-open="true"] .a-nav-sub { grid-template-rows: 1fr; }
  .a-nav-sub > div, .a-nav-sub { overflow: hidden; }
  .a-nav-sub { padding-left: 2.55rem; }
  .a-nav-subitem { display: block; padding: .42rem .6rem; margin: 1px 0; border-radius: 7px; font-size: .84rem; color: var(--a-side-muted); text-decoration: none; transition: color .15s, background .15s; }
  .a-nav-subitem:hover { color: var(--a-side-ink); background: var(--a-side-2); }
  .a-nav-subitem.is-active { color: var(--a-side-accent); font-weight: 600; }

  .a-side-foot { display: flex; align-items: center; gap: .65rem; padding: .85rem 1rem; border-top: 1px solid var(--a-side-line); }
  .a-side-avatar { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: #2e2a22; color: #e9dcc4; font-size: .72rem; font-weight: 700; flex-shrink: 0; }
  .a-side-user { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
  .a-side-name { font-size: .82rem; font-weight: 600; color: #ece4d6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .a-side-role { font-size: .7rem; color: var(--a-side-muted); }

  @media (max-width: 900px) {
    .admin-sidebar { position: fixed; left: 0; top: 0; z-index: 50; transform: translateX(-100%); transition: transform .28s ease; box-shadow: 0 0 60px rgba(0,0,0,.4); }
    .admin-sidebar.mobile-open { transform: none; }
  }
</style>

<script>
  document.querySelectorAll('.a-nav-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const g = btn.closest('.a-nav-group');
      const open = g?.getAttribute('data-open') === 'true';
      g?.setAttribute('data-open', String(!open));
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
