---
import Container from "@components/container.astro";
import { StickyHeader } from "astro-navbar";
import SiteLogo from "@components/siteLogo.astro";
import links from "@data/siteLinks.json";
import { adminNavForRole } from "@lib/admin-nav";
import AdminIcon from "@components/admin/AdminIcon.astro";
const menuLinks = links.menuLinks;
const currentPath = Astro.url.pathname;

// Auth state (set on every request by middleware.ts). Sign-in happens right here in
// the navbar popover — there is no login page.
const user = Astro.locals?.user ?? null;
const isStaff = !!user && ['superadmin', 'admin', 'editor', 'author'].includes(user.role);
const avatarUrl = (user as any)?.avatar || '';
const adminLinks = isStaff ? adminNavForRole(user!.role) : [];
const email = (user as any)?.email || '';
const roleLabel = user ? String(user.role).replace(/^\w/, (c: string) => c.toUpperCase()) : '';
const initials = user ? String(user.name || user.email || '?').trim().split(/\s+/).map((s: string) => s[0]).slice(0, 2).join('').toUpperCase() : '?';
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '';
---

<StickyHeader
  class="sticky top-0 border-b transition-all z-50"
  scrollY={50}
  defaultClass="py-2 border-transparent"
  activeClass="py-2 bg-white/80 border-gray-200 backdrop-blur-lg">
  <Container>
    <div class="flex items-center justify-between gap-2 relative z-10" transition:animate="none">
      <!-- Logo -->
      <div id="logo" class="flex items-center shrink-0">
        <SiteLogo />
      </div>

      <!-- Priority+ links: shows as many as fit; the rest are moved into the hamburger by JS -->
      <nav id="primary-nav" aria-label="Primary" class="flex flex-1 min-w-0 items-center justify-center gap-1 overflow-hidden noprint">
        {menuLinks.map((item) => {
          const isCurrent = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
          return (
            <a href={item.path} data-astro-reload
              aria-current={isCurrent ? "page" : undefined}
              class:list={["nav-link whitespace-nowrap px-3 py-2 text-sm hover:text-amber-700 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-500 focus-visible:outline-none transition rounded-full", isCurrent ? "text-amber-700 font-medium" : "text-gray-600"]}>
              {item.title}
            </a>
          );
        })}
      </nav>

      <!-- Right controls: Contribute · hamburger (only when links overflow) · profile -->
      <div class="flex items-center gap-2 shrink-0 noprint">
        <a href="/contribute" data-astro-reload
          class="hidden sm:inline-flex px-5 py-2 text-sm font-medium text-white bg-amber-700 hover:bg-amber-600 rounded-full transition duration-200">
          Contribute
        </a>

        <!-- Hamburger — hidden until JS detects overflow -->
        <button id="nav-more" type="button" aria-label="More menu" aria-expanded="false" aria-controls="nav-overflow"
          class="hidden items-center justify-center w-10 h-10 rounded-full text-gray-700 hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-500 focus-visible:outline-none transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Profile / account — opens the login/account popover in place (no login page) -->
        <div class="relative shrink-0">
          <button id="account-btn" type="button" aria-label="Account" title="Account" aria-expanded="false" aria-controls="account-menu"
            class:list={["inline-flex items-center justify-center w-10 h-10 rounded-full overflow-hidden text-gray-700 hover:bg-gray-100 hover:text-amber-700 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-amber-500 focus-visible:outline-none transition", isStaff ? "ring-2 ring-green-500" : user ? "ring-2 ring-amber-500" : "ring-1 ring-gray-200"]}>
            {avatarUrl ? (
              <img src={avatarUrl} alt="" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            )}
          </button>

          <div id="account-menu" class="acct-menu hidden absolute right-0 top-full mt-2 w-72 z-50 text-left">
            {user ? (
              <div>
                <div class="acct-head">
                  {avatarUrl ? (
                    <img src={avatarUrl} alt="" referrerpolicy="no-referrer" class="acct-avatar-img" />
                  ) : (
                    <span class="acct-avatar">{initials}</span>
                  )}
                  <div class="acct-id">
                    <p class="acct-name">{user.name || user.email}</p>
                    {email && <p class="acct-email">{email}</p>}
                  </div>
                </div>
                <span class="acct-role">{roleLabel}</span>
                {adminLinks.length > 0 && (
                  <nav aria-label="Admin sections" class="acct-links">
                    {adminLinks.map((l) => (
                      <a href={l.href} class="acct-item"><AdminIcon name={l.icon} size={16} /> {l.title}</a>
                    ))}
                  </nav>
                )}
                <div class="acct-foot">
                  <button id="signout-btn" type="button" class="acct-item acct-signout"><AdminIcon name="logout" size={16} /> Sign out</button>
                </div>
              </div>
            ) : (
              <div>
                <div class="flex items-center justify-between mb-3">
                  <p class="text-sm font-semibold text-gray-900">Sign in</p>
                  <button id="nav-signin-close" type="button" aria-label="Close sign-in panel" class="inline-flex items-center justify-center w-8 h-8 text-gray-600 hover:text-gray-700 focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:outline-none rounded">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>
                </div>
                {googleClientId && (
                  <div class="mb-3">
                    {/* The One Tap config (#g_id_onload) lives at the top level, NOT here —
                        GIS mis-places the prompt when its config is inside a display:none popover. */}
                    <div class="g_id_signin" data-type="standard" data-width="256"></div>
                  </div>
                )}
                <form id="nav-magic-form" class="space-y-2">
                  <label for="nav-magic-email" class="sr-only">Email address</label>
                  <input type="email" id="nav-magic-email" name="email" required placeholder="you@example.com"
                    autocomplete="email" inputmode="email"
                    class="w-full border border-gray-300 rounded-lg py-2 px-3 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-amber-500" />
                  <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-amber-700 hover:bg-amber-600 rounded-full transition">Email me a sign-in link</button>
                </form>
                <details class="mt-3">
                  <summary class="text-xs text-gray-600 cursor-pointer">Superadmin password</summary>
                  <form id="nav-pass-form" class="mt-2 space-y-2">
                    <label for="nav-pass-email" class="sr-only">Email address</label>
                    <input type="email" id="nav-pass-email" name="email" placeholder="Email" required autocomplete="email" class="w-full border border-gray-300 rounded-lg py-2 px-3 text-sm" />
                    <label for="nav-pass-password" class="sr-only">Password</label>
                    <input type="password" id="nav-pass-password" name="password" placeholder="Password" required autocomplete="current-password" class="w-full border border-gray-300 rounded-lg py-2 px-3 text-sm" />
                    <button type="submit" class="w-full px-4 py-2 text-sm text-white bg-gray-700 hover:bg-gray-900 rounded-full transition">Sign in</button>
                  </form>
                </details>
                <p id="nav-auth-msg" class="text-sm mt-2" role="status" aria-live="polite"></p>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Overflow dropdown (holds the links that didn't fit) -->
      <div id="nav-overflow" class="hidden absolute right-0 top-full mt-2 w-60 bg-white border border-gray-200 rounded-xl shadow-lg py-2 z-50">
        <div id="nav-overflow-list" class="flex flex-col"></div>
        <div id="nav-overflow-cta" class="sm:hidden mt-2 px-3 pt-2 border-t border-gray-100">
          <a href="/contribute" data-astro-reload
            class="flex justify-center px-5 py-2 text-sm font-medium text-white bg-amber-700 hover:bg-amber-600 rounded-full transition">
            Contribute
          </a>
        </div>
      </div>
    </div>
  </Container>
</StickyHeader>

<style>
  /* In the dropdown, links stack full-width and lose the pill hover for a cleaner list */
  #nav-overflow-list .nav-link { display: block; border-radius: 0.5rem; }

  /* Refined account menu — consistent across the public site and the admin. */
  .acct-menu { background: #fff; border: 1px solid #e7e2d8; border-radius: 12px; padding: .4rem; box-shadow: 0 14px 40px -14px rgba(40,30,10,.3); }
  .acct-head { display: flex; align-items: center; gap: .7rem; padding: .55rem .55rem .65rem; }
  .acct-avatar-img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .acct-avatar { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; background: linear-gradient(180deg,#2a2620,#1c1a16); color: #e9dcc4; font-weight: 700; font-size: .82rem; }
  .acct-id { min-width: 0; }
  .acct-name { font-size: .9rem; font-weight: 600; color: #1c1a17; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acct-email { font-size: .74rem; color: #8b847a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acct-role { display: inline-block; margin: 0 .55rem .55rem; padding: .16rem .5rem; border-radius: 999px; font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: #8a5a22; background: #f4ecdd; }
  .acct-links { display: flex; flex-direction: column; padding: .3rem 0; border-top: 1px solid #f0ece4; max-height: 19rem; overflow-y: auto; }
  .acct-item { display: flex; align-items: center; gap: .65rem; width: 100%; padding: .5rem .6rem; border-radius: 8px; font-size: .86rem; color: #57524a; text-decoration: none; background: transparent; border: none; cursor: pointer; text-align: left; transition: background .15s, color .15s; }
  .acct-item:hover { background: #faf7f1; color: #1c1a17; }
  .acct-item svg { color: #a99f8f; transition: color .15s; }
  .acct-item:hover svg { color: #a9742f; }
  .acct-foot { border-top: 1px solid #f0ece4; margin-top: .1rem; padding-top: .2rem; }
  .acct-signout, .acct-signout:hover { color: #a8443b; }
  .acct-signout svg, .acct-signout:hover svg { color: #a8443b; }
</style>

<script>
  function setupResponsiveNav() {
    const nav = document.getElementById('primary-nav');
    const list = document.getElementById('nav-overflow-list');
    const panel = document.getElementById('nav-overflow');
    const moreBtn = document.getElementById('nav-more');
    if (!nav || !list || !panel || !moreBtn) return;
    if (nav.dataset.priorityNav === 'on') return; // already initialised for this DOM
    nav.dataset.priorityNav = 'on';

    const closePanel = () => { panel.classList.add('hidden'); moreBtn.setAttribute('aria-expanded', 'false'); };
    const openPanel = () => { if (!list.children.length) return; panel.classList.remove('hidden'); moreBtn.setAttribute('aria-expanded', 'true'); };

    function reflow() {
      // Move everything back into the row, then push overflow (from the end) into the dropdown.
      while (list.firstElementChild) nav.appendChild(list.firstElementChild);
      let guard = 100;
      while (nav.scrollWidth > nav.clientWidth + 1 && nav.lastElementChild && guard-- > 0) {
        list.insertBefore(nav.lastElementChild, list.firstElementChild);
      }
      const hasOverflow = list.children.length > 0;
      // Toggle both: Tailwind's `inline-flex` would otherwise win over `hidden` in source order.
      moreBtn.classList.toggle('hidden', !hasOverflow);
      moreBtn.classList.toggle('inline-flex', hasOverflow);
      if (!hasOverflow) closePanel();
    }

    moreBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      panel.classList.contains('hidden') ? openPanel() : closePanel();
    });
    document.addEventListener('click', (e) => {
      if (!panel.contains(e.target) && e.target !== moreBtn && !moreBtn.contains(e.target)) closePanel();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });
    list.addEventListener('click', () => closePanel());

    reflow();
    if (window.ResizeObserver) new ResizeObserver(() => reflow()).observe(document.body);
    window.addEventListener('resize', reflow);
    window.addEventListener('load', reflow); // fonts/logo may shift widths after load
  }

  if (document.readyState !== 'loading') setupResponsiveNav();
  else document.addEventListener('DOMContentLoaded', setupResponsiveNav);
  document.addEventListener('astro:page-load', setupResponsiveNav);
</script>

{!user && googleClientId && (
  <Fragment>
    {/* auto_prompt is OFF: Google's One Tap prompt is FedCM-controlled and floats over the
        navbar with no way to reposition it (mandatory FedCM since Aug 2025). Instead we
        auto-open our own popover (below the profile button) — see the script below. This
        g_id_onload only configures GIS so the rendered "Sign in with Google" button works. */}
    <div id="g_id_onload" data-client_id={googleClientId} data-callback="handleNavGoogle" data-auto_prompt="false"></div>
    {/* gsi/client (~200KB incl. its button + font) is lazy-loaded on first interaction — see the
        loader in the script below — so it never sits on the initial/LCP critical path. */}
  </Fragment>
)}

<script is:inline>
  (function () {
    const btn = document.getElementById('account-btn');
    const menu = document.getElementById('account-menu');
    if (!btn || !menu) return;
    const msgEl = () => document.getElementById('nav-auth-msg');
    const setMsg = (text, ok) => { const m = msgEl(); if (m) { m.textContent = text; m.className = 'text-sm mt-2 ' + (ok ? 'text-green-600' : 'text-red-500'); } };
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const isOpen = () => !menu.classList.contains('hidden');
    const open = () => { menu.classList.remove('hidden'); btn.setAttribute('aria-expanded', 'true'); };
    const close = () => { menu.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); };
    // Wire the button/click-away/escape toggle. onClose lets the signed-out popover also mark
    // itself "seen" so it doesn't auto-reopen.
    const wireToggle = (onClose) => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); isOpen() ? onClose() : open(); });
      document.addEventListener('click', (e) => { if (isOpen() && !menu.contains(e.target) && !btn.contains(e.target)) onClose(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) onClose(); });
    };

    // Google One Tap / button callback (auto-prompts when signed into Google). Always defined.
    window.handleNavGoogle = async (response) => {
      try {
        const r = await fetch('/api/auth/google', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ credential: response.credential }) });
        const data = await r.json();
        if (data.ok) { location.reload(); }
        else { setMsg(data.error === 'account-disabled' ? 'That account has been disabled. Contact an administrator.' : 'Google sign-in failed.', false); }
      } catch { setMsg('Google sign-in failed.', false); }
    };
    // Sign out — delegated, so it works whether the menu was server-rendered or hydrated in.
    document.addEventListener('click', (e) => {
      const t = e.target.closest && e.target.closest('#signout-btn');
      if (!t) return;
      e.preventDefault();
      fetch('/api/auth/logout', { method: 'POST' }).catch(() => {}).then(() => location.reload());
    });

    // Line-icon set (subset of AdminIcon) for the hydrated account menu's admin links.
    const ICONS = {
      dashboard: '<rect width="7" height="9" x="3" y="3" rx="1.5"/><rect width="7" height="5" x="14" y="3" rx="1.5"/><rect width="7" height="9" x="14" y="12" rx="1.5"/><rect width="7" height="5" x="3" y="16" rx="1.5"/>',
      content: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/>',
      media: '<rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>',
      events: '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/>',
      tag: '<path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z"/><circle cx="7.5" cy="7.5" r="1.2"/>',
      organization: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
      analytics: '<path d="M3 3v18h18"/><rect x="7" y="13" width="3" height="5" rx="1"/><rect x="12" y="9" width="3" height="9" rx="1"/><rect x="17" y="5" width="3" height="13" rx="1"/>',
      team: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
      settings: '<path d="M12.2 2h-.4a2 2 0 0 0-2 2v.2a2 2 0 0 1-1 1.7l-.4.3a2 2 0 0 1-2 0l-.2-.1a2 2 0 0 0-2.7.7l-.2.4a2 2 0 0 0 .7 2.7l.2.1a2 2 0 0 1 1 1.7v.5a2 2 0 0 1-1 1.7l-.2.1a2 2 0 0 0-.7 2.7l.2.4a2 2 0 0 0 2.7.7l.2-.1a2 2 0 0 1 2 0l.4.3a2 2 0 0 1 1 1.7V20a2 2 0 0 0 2 2h.4a2 2 0 0 0 2-2v-.2a2 2 0 0 1 1-1.7l.4-.3a2 2 0 0 1 2 0l.2.1a2 2 0 0 0 2.7-.7l.2-.4a2 2 0 0 0-.7-2.7l-.2-.1a2 2 0 0 1-1-1.7v-.5a2 2 0 0 1 1-1.7l.2-.1a2 2 0 0 0 .7-2.7l-.2-.4a2 2 0 0 0-2.7-.7l-.2.1a2 2 0 0 1-2 0l-.4-.3a2 2 0 0 1-1-1.7V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
      users: '<path d="M2.6 17.4A2 2 0 0 0 2 18.8V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.2a2 2 0 0 0 1.4-.6l.8-.8a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".6" fill="currentColor" stroke="none"/>',
      logout: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>',
    };
    const icon = (name) => `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${ICONS[name] || ''}</svg>`;

    // The signed-out UI: lazy Google, magic-link/password forms, and the once-per-session
    // auto-open popover that replaces Google's over-the-navbar One Tap.
    const setupSignedOut = () => {
      if (document.getElementById('g_id_onload')) {
        let gsiLoaded = false;
        const loadGsi = () => {
          if (gsiLoaded || document.getElementById('gsi-client-script')) return;
          gsiLoaded = true;
          const s = document.createElement('script');
          s.id = 'gsi-client-script'; s.src = 'https://accounts.google.com/gsi/client'; s.async = true;
          document.head.appendChild(s);
        };
        ['pointermove', 'pointerdown', 'keydown', 'touchstart', 'scroll'].forEach((ev) =>
          window.addEventListener(ev, loadGsi, { once: true, passive: true }));
      }

      const PROMPTED = 'drbi_login_prompted';
      const wasPrompted = () => { try { return sessionStorage.getItem(PROMPTED) === '1'; } catch (e) { return false; } };
      const markPrompted = () => { try { sessionStorage.setItem(PROMPTED, '1'); } catch (e) {} };
      const dismiss = () => { close(); markPrompted(); };
      wireToggle(dismiss);
      document.getElementById('nav-signin-close')?.addEventListener('click', (e) => { e.stopPropagation(); dismiss(); });

      const params = new URLSearchParams(location.search);
      const forced = params.get('signin') === '1' || !!params.get('auth_error');
      if (params.get('signin') === '1') open();
      const err = params.get('auth_error');
      if (err) { setMsg(err === 'invalid-or-expired' ? 'That sign-in link was invalid or expired. Request a new one.' : 'That account has been disabled. Contact an administrator.', false); open(); }
      if (!forced && !wasPrompted()) setTimeout(() => { if (!isOpen()) { open(); markPrompted(); } }, 900);

      document.getElementById('nav-magic-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('nav-magic-email').value.trim();
        await fetch('/api/auth/request-link', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) }).catch(() => {});
        setMsg('If that email is authorized, a sign-in link is on its way. Check your inbox.', true);
      });
      document.getElementById('nav-pass-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const r = await fetch('/api/auth/password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }) }).catch(() => null);
        const data = r && await r.json().catch(() => null);
        if (data && data.ok) { location.href = data.redirect || '/admin'; }
        else { setMsg('Invalid email or password.', false); }
      });
    };

    // Replace the anonymous popover with the signed-in account menu (built from the session probe).
    const renderSignedIn = (s) => {
      const gid = document.getElementById('g_id_onload'); if (gid) gid.remove();
      const u = s.user || {};
      btn.classList.remove('ring-1', 'ring-gray-200', 'ring-amber-500', 'ring-green-500');
      btn.classList.add('ring-2', s.isStaff ? 'ring-green-500' : 'ring-amber-500');
      btn.innerHTML = u.avatar
        ? `<img src="${esc(u.avatar)}" alt="" referrerpolicy="no-referrer" class="w-full h-full object-cover">`
        : `<span class="acct-avatar" style="width:100%;height:100%">${esc(s.initials)}</span>`;
      const links = (s.adminLinks || []).map((l) => `<a href="${esc(l.href)}" class="acct-item">${icon(l.icon)} ${esc(l.title)}</a>`).join('');
      menu.innerHTML =
        '<div>' +
          '<div class="acct-head">' +
            (u.avatar ? `<img src="${esc(u.avatar)}" alt="" referrerpolicy="no-referrer" class="acct-avatar-img">` : `<span class="acct-avatar">${esc(s.initials)}</span>`) +
            `<div class="acct-id"><p class="acct-name">${esc(u.name || u.email)}</p>${u.email ? `<p class="acct-email">${esc(u.email)}</p>` : ''}</div>` +
          '</div>' +
          `<span class="acct-role">${esc(s.roleLabel)}</span>` +
          (links ? `<nav aria-label="Admin sections" class="acct-links">${links}</nav>` : '') +
          '<div class="acct-foot"><button id="signout-btn" type="button" class="acct-item acct-signout">' + icon('logout') + ' Sign out</button></div>' +
        '</div>';
      wireToggle(close);
    };

    if (document.getElementById('nav-magic-form')) {
      // Navbar was rendered anonymous (prerendered / edge-cached page, or a real signed-out visitor).
      // Probe the session and hydrate the account button if we're actually signed in.
      fetch('/api/auth/session', { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : { user: null }))
        .then((s) => { s && s.user ? renderSignedIn(s) : setupSignedOut(); })
        .catch(() => setupSignedOut());
    } else {
      // Server already rendered the signed-in menu (SSR page) — just wire the dropdown.
      wireToggle(close);
    }
  })();
</script>
