---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";

// Astro renders this for uncaught server errors. `error` is passed in production only.
const { error } = Astro.props;
if (error) console.error("500:", error instanceof Error ? error.stack : error);
---

<Layout title="500 Server Error">
  <Container>
    <div class="min-h-[calc(100vh-20rem)] flex items-center justify-center">
      <div class="mt-16 text-center">
        <h1
          class="text-6xl lg:text-9xl font-bold lg:tracking-tight bg-gradient-to-b from-indigo-600 to-indigo-300 bg-clip-text text-transparent">
          500
        </h1>
        <p class="text-lg lg:text-2xl font-serif font-medium mt-4 text-body">
          Something went wrong on our end.
        </p>
        <p class="mt-3 text-muted">
          The problem has been logged. Please try again in a moment — if it keeps
          happening, let us know and we&rsquo;ll look into it.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Link href="/" style="outline">Back to Home</Link>
          <Link href="/events" style="outline">Upcoming Events</Link>
          <Link href="/contact-us" style="outline">Contact Us</Link>
        </div>
        <nav class="mt-12" aria-label="Key sections">
          <p class="text-sm text-muted mb-4">Or jump to a section:</p>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
            <a href="/about-us" class="text-brand hover:underline">About DRBI</a>
            <a href="/events" class="text-brand hover:underline">Events &amp; Programs</a>
            <a href="/memorial" class="text-brand hover:underline">Memorial Gardens</a>
            <a href="/working-with-us" class="text-brand hover:underline">Volunteer</a>
            <a href="/contribute" class="text-brand hover:underline">Contribute</a>
            <a href="/contact-us" class="text-brand hover:underline">Contact</a>
          </div>
        </nav>
      </div>
    </div>
  </Container>
</Layout>
