---
export const prerender = false;

import { ClientRouter } from "astro:transitions";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import { getCategories } from "@utils/utils.js";
import CategoryCard from "@components/article/categoryCard.astro";

const categories = await getCategories()
---

<Layout title="Article Categories" description="Browse articles and resources from Desert Rose Bahai Institute organized by category — education, agriculture, arts, community, and more.">
  <Container>
    <Sectionhead>
      <Fragment slot="title"> Site Categories </Fragment>
      <Fragment slot="desc"> {categories.length} Categories  </Fragment>
    </Sectionhead>

      {Array.isArray(categories) && categories.length > 0 ? (
        <div class="flex flex-wrap justify-center gap-20 mt-5 pb-40">
          {categories.map((cat) => (
            <div class="w-full max-w-96"> <CategoryCard slug={cat.id} size="md" category={cat} /> </div>
          ))}
          <ClientRouter/>
        </div>
      ) : (
        <div class="text-center py-20 text-body">
          <p class="text-xl mb-3">No categories yet.</p>
          <p class="text-sm"><a href="/" class="text-brand hover:underline">Return home</a>.</p>
        </div>
      )}

  </Container>
</Layout>
