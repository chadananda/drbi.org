---
export const prerender = false;

import Layout from  "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import AuthorCard from "@components/article/authorCard.astro";
import { getTeam } from "@utils/utils.js";

const authors = await getTeam(({data}) => !data.draft);
// const author_slugs = authors.map((author) => author.id);
---

<Layout title="All Authors" description="Meet the authors and contributors who write for Desert Rose Bahai Institute — scholars, educators, and members of the DRBI community.">
  <Container>
    <Sectionhead>
      <Fragment slot="title"> All Authors </Fragment>
      <Fragment slot="desc"> found in the knowledge base </Fragment>
    </Sectionhead>

    {Array.isArray(authors) && authors.length > 0 ? (
      <div class="flex flex-wrap justify-center gap-5 mt-5">
        {authors.map(author => (
          <div class="flex-none"> <AuthorCard size="sm" author={author}/> </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-slate-600">
        <p class="text-xl mb-3">No authors listed yet.</p>
        <p class="text-sm"><a href="/" class="text-amber-700 hover:underline">Return home</a>.</p>
      </div>
    )}

  </Container>
</Layout>
