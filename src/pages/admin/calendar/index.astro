---
// Team calendar editor. Add/edit/delete calendar_items (classes, Holy Days, community dates,
// and multi-day "reserved" holds) that show on the public /calendar alongside the events feed.
// Events themselves stay editable under /admin/events and are shown here read-only.
export const prerender = false;
import Layout from '@layouts/AdminLayout.astro';
import { getCalendarItem, getOption } from '@lib/queries';
import { getAirbnbBlocks } from '@lib/airbnb';
import { getAdminCalendarEntries } from '@lib/calendar';

const airbnbUrl = (await getOption('airbnb_listing_url')) || '';
const airbnbIcal = (await getOption('airbnb_ical_url')) || '';
const airbnbBlocks = await getAirbnbBlocks().catch(() => []);
const exportUrl = new URL('/calendar.ics', Astro.url.origin).href;

// Unified manager rows: events + custom items + Airbnb blocks. Window to recent + future so the
// list stays focused (drop entries that ended more than ~6 weeks ago).
const cutoff = Date.now() - 42 * 864e5;
const manageRows = (await getAdminCalendarEntries().catch(() => []))
  .filter((r) => new Date(r.end || r.start).getTime() >= cutoff);

const KIND_BADGE = {
  event: { label: 'Event', bg: '#dbeafe', fg: '#1e40af' },
  item: { label: 'Item', bg: '#e0f2fe', fg: '#0e7490' },
  airbnb: { label: 'Airbnb', bg: '#fef3c7', fg: '#b45309' },
};
const rowLabelValue = (r) => (r.kind === 'item' ? r.baseTitle : (r.override ? r.override.label : '') || '');
const rowLinkValue = (r) => (r.kind === 'item' ? r.baseUrl : (r.override ? r.override.linkUrl : '') || '');
const rowHidden = (r) => (r.kind === 'item' ? !!r.itemHidden : !!(r.override && r.override.hidden));

const editId = Astro.url.searchParams.get('edit');
const editing = editId ? await getCalendarItem(editId) : null;
const saved = Astro.url.searchParams.get('saved');

const TYPES = [
  { v: 'program', label: 'Program / class' },
  { v: 'holyday', label: 'Holy Day' },
  { v: 'reserved', label: 'DRBI reserved (hold)' },
  { v: 'event', label: 'Event' },
];
const dstr = (s) => (s ? String(s).slice(0, 10) : '');
const fmt = (s) => { try { return new Date(s).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); } catch { return s; } };
---

<Layout title="Calendar — DRBI Admin">
  <div style="max-width:56rem;margin:0 auto;padding:1.5rem 1rem;">
    <h1 style="font-size:1.6rem;font-weight:700;margin:0 0 .3rem;">📅 Calendar</h1>
    <p style="color:#64748b;margin:0 0 1.5rem;">Add dated items to the public <a href="/calendar" target="_blank">calendar</a> — classes, Holy Days, community dates, and multi-day reserved holds. Events are pulled in automatically (managed under <a href="/admin/events">Events</a>).</p>

    {saved && <p style="background:#dcfce7;border:1px solid #86efac;color:#166534;padding:.5rem .8rem;border-radius:8px;">Saved.</p>}

    <!-- Airbnb availability sync -->
    <form method="POST" action="/api/admin/calendar" style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:1.1rem 1.2rem;margin-bottom:1.5rem;">
      <input type="hidden" name="op" value="set-airbnb" />
      <h2 style="font-size:1.05rem;font-weight:700;margin:0 0 .2rem;">🔗 Airbnb availability sync</h2>
      <p style="color:#64748b;font-size:.85rem;margin:0 0 1rem;">Two-way link so nothing double-books: Airbnb bookings block our calendar, and our events block Airbnb.</p>

      <label style="font-weight:600;font-size:.9rem;">Booking (listing) URL <span style="font-weight:400;color:#64748b;">— open days on the calendar link here to book</span></label>
      <input type="url" name="airbnb_listing_url" value={airbnbUrl} placeholder="https://www.airbnb.com/rooms/…" style="width:100%;padding:.5rem .7rem;border:1px solid #cbd5e1;border-radius:8px;margin:.35rem 0 1rem;" />

      <label style="font-weight:600;font-size:.9rem;">Import iCal URL <span style="font-weight:400;color:#64748b;">— from Airbnb → Listing → Availability → “Connect calendars” → Export</span></label>
      <input type="url" name="airbnb_ical_url" value={airbnbIcal} placeholder="https://www.airbnb.com/calendar/ical/…ics" style="width:100%;padding:.5rem .7rem;border:1px solid #cbd5e1;border-radius:8px;margin:.35rem 0 .3rem;" />
      <p style="color:#64748b;font-size:.8rem;margin:0 0 1rem;">
        {airbnbIcal
          ? `Currently importing ${airbnbBlocks.length} blocked date range${airbnbBlocks.length === 1 ? '' : 's'} from Airbnb (refreshes ~every 30 min).`
          : 'Not set yet — until this is added, the calendar shows only DRBI events and reserved holds.'}
      </p>

      <button type="submit" style="background:#0f172a;color:#fff;border:none;border-radius:8px;padding:.5rem 1.2rem;font-weight:600;cursor:pointer;">Save</button>

      <div style="margin-top:1.1rem;padding-top:1rem;border-top:1px solid #f1f5f9;">
        <label style="font-weight:600;font-size:.9rem;">Export iCal URL <span style="font-weight:400;color:#64748b;">— add this in Airbnb → “Connect calendars” → Import so DRBI dates block bookings</span></label>
        <input type="text" readonly value={exportUrl} onclick="this.select()" style="width:100%;padding:.5rem .7rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.35rem;background:#f8fafc;color:#334155;" />
      </div>
    </form>

    <!-- Add / edit item -->
    <form id="add" method="POST" action="/api/admin/calendar" style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:1.2rem;margin-bottom:1.5rem;">
      <input type="hidden" name="op" value="save" />
      <input type="hidden" name="id" value={editing?.id || ''} />
      <h2 style="font-size:1.05rem;font-weight:700;margin:0 0 .9rem;">{editing ? 'Edit item' : 'Add calendar item'}</h2>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem;">
        <label style="grid-column:1/3;">Title
          <input name="title" required value={editing?.title || ''} style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;" />
        </label>
        <label>Type
          <select name="type" style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;">
            {TYPES.map((t) => <option value={t.v} selected={editing?.type === t.v}>{t.label}</option>)}
          </select>
        </label>
        <label>Link URL (optional)
          <input name="link_url" value={editing?.linkUrl || ''} placeholder="/events/… or https://…" style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;" />
        </label>
        <label>Start date
          <input type="date" name="start" required value={dstr(editing?.start)} style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;" />
        </label>
        <label>End date (optional — for a range)
          <input type="date" name="end" value={dstr(editing?.end)} style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;" />
        </label>
        <label>Location (optional)
          <input name="location" value={editing?.location || ''} style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;" />
        </label>
        <label>Color (optional hex)
          <input name="color" value={editing?.color || ''} placeholder="#b45309" style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;" />
        </label>
        <label style="grid-column:1/3;">Notes (optional)
          <textarea name="notes" rows="2" style="width:100%;padding:.5rem;border:1px solid #cbd5e1;border-radius:8px;margin-top:.2rem;">{editing?.notes || ''}</textarea>
        </label>
        <label style="display:flex;align-items:center;gap:.4rem;"><input type="checkbox" name="all_day" checked={editing ? editing.allDay : true} /> All day</label>
        <label style="display:flex;align-items:center;gap:.4rem;"><input type="checkbox" name="visible" checked={editing ? editing.visible : true} /> Visible</label>
      </div>
      <div style="margin-top:1rem;display:flex;gap:.6rem;">
        <button type="submit" style="background:#a04607;color:#fff;border:none;border-radius:8px;padding:.55rem 1.3rem;font-weight:600;cursor:pointer;">{editing ? 'Update' : 'Add'}</button>
        {editing && <a href="/admin/calendar" style="align-self:center;color:#64748b;">Cancel</a>}
      </div>
    </form>

    <!-- Unified manager: label / link / hide anything on the calendar -->
    <h2 id="manage" style="font-size:1.05rem;font-weight:700;margin:0 0 .3rem;">Manage everything on the calendar ({manageRows.length})</h2>
    <p style="color:#64748b;font-size:.85rem;margin:0 0 1rem;">Rename how any entry appears, point it at a link, or hide it. Events &amp; Airbnb bookings are pulled in automatically — your changes here layer on top without altering the source. Leave a label blank to keep the original.</p>

    {manageRows.length === 0 ? (
      <p style="color:#64748b;">Nothing on the calendar yet.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:.5rem;">
        {manageRows.map((r) => (
          <form method="POST" action="/api/admin/calendar" style={`display:grid;grid-template-columns:8.5rem 1fr 1fr auto auto;gap:.5rem;align-items:center;background:#fff;border:1px solid ${rowHidden(r) ? '#fcd9a8' : '#e2e8f0'};border-radius:10px;padding:.55rem .7rem;`}>
            <input type="hidden" name="op" value="label" />
            <input type="hidden" name="entry_key" value={r.id} />
            <input type="hidden" name="entry_kind" value={r.kind} />
            <div style="min-width:0;">
              <div style="font-size:.72rem;color:#64748b;white-space:nowrap;">{fmt(r.start)}{r.end && r.end !== r.start ? ` – ${fmt(r.end)}` : ''}</div>
              <span style={`display:inline-block;margin-top:.15rem;font-size:.66rem;font-weight:700;padding:.05rem .4rem;border-radius:999px;background:${KIND_BADGE[r.kind].bg};color:${KIND_BADGE[r.kind].fg};`}>{KIND_BADGE[r.kind].label}</span>
            </div>
            <input name="label" value={rowLabelValue(r)} placeholder={r.baseTitle || '(label)'} title="Display label" style="min-width:0;padding:.4rem .55rem;border:1px solid #cbd5e1;border-radius:7px;font-size:.85rem;" />
            <input name="link_url" value={rowLinkValue(r)} placeholder={r.baseUrl || 'link (optional)'} title="Link URL" style="min-width:0;padding:.4rem .55rem;border:1px solid #cbd5e1;border-radius:7px;font-size:.85rem;" />
            <label style="display:flex;align-items:center;gap:.3rem;font-size:.78rem;color:#64748b;white-space:nowrap;" title="Hide from the public calendar">
              <input type="checkbox" name="hidden" checked={rowHidden(r)} /> Hide
            </label>
            <div style="display:flex;align-items:center;gap:.5rem;">
              <button type="submit" style="background:#0f172a;color:#fff;border:none;border-radius:7px;padding:.4rem .8rem;font-size:.82rem;font-weight:600;cursor:pointer;">Save</button>
              {r.kind === 'item' && <a href={`/admin/calendar?edit=${r.id}#add`} style="font-size:.78rem;color:#64748b;" title="Full edit (dates, type, notes)">Edit</a>}
            </div>
          </form>
        ))}
      </div>
    )}
  </div>
</Layout>
