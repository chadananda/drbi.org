---
export const prerender = false;

import Layout from '@layouts/AdminLayout.astro';
import AdminIcon from '@components/admin/AdminIcon.astro';
import { getUsers } from '@lib/queries';

const user = Astro.locals?.user;
if (!user || !['superadmin', 'admin'].includes(user.role)) return Astro.redirect('/admin');

const users = await getUsers();

// A superadmin may grant admin; an admin may grant up to editor.
const grantable = user.role === 'superadmin'
  ? [{ v: 'admin', l: 'Admin — all content + team + settings' }, { v: 'editor', l: 'Editor — all content + comments' }, { v: 'author', l: 'Author — own content only' }]
  : [{ v: 'editor', l: 'Editor — all content + comments' }, { v: 'author', l: 'Author — own content only' }];

const badge = (r: string) => r === 'superadmin' ? 'a-badge-red' : r === 'admin' ? 'a-badge-blue' : r === 'editor' ? 'a-badge-blue' : r === 'author' ? 'a-badge-green' : 'a-badge-muted';
const fmtDate = (s: any) => { try { return new Date(s).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); } catch { return ''; } };
---

<Layout title="Users & access" user={user}>
  <div class="a-page-head">
    <div>
      <h1 class="a-title">Users &amp; access</h1>
      <p class="a-subtitle">Whitelist people by email and role — they get that role the moment they sign in.</p>
    </div>
  </div>

  <div class="u-grid">
    <!-- Invite / whitelist -->
    <section class="a-card a-card-pad u-invite">
      <h2 class="a-section-title">Invite a team member</h2>
      <p class="u-hint">Adds them to the whitelist and emails a sign-in link. They're assigned the role below on first login.</p>
      <form id="inviteForm" class="u-form">
        <label class="u-field">
          <span class="a-eyebrow">Email</span>
          <input type="email" name="email" required placeholder="name@example.com" class="a-input" />
        </label>
        <label class="u-field">
          <span class="a-eyebrow">Name <span class="u-opt">(optional)</span></span>
          <input type="text" name="name" placeholder="Full name" class="a-input" />
        </label>
        <label class="u-field">
          <span class="a-eyebrow">Role</span>
          <select name="role" class="a-input">
            {grantable.map((g) => <option value={g.v}>{g.l}</option>)}
          </select>
        </label>
        <button type="submit" class="a-btn a-btn-primary u-send">
          <AdminIcon name="external" size={16} /> Send invitation
        </button>
        <p id="inviteMsg" class="u-msg" role="status"></p>
      </form>
    </section>

    <!-- Users table -->
    <section class="a-card u-list">
      <div class="u-list-head">
        <h2 class="a-section-title">People</h2>
        <span class="a-badge a-badge-muted">{users.length}</span>
      </div>
      <div class="u-table-wrap">
        <table class="a-table">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Added</th><th style="text-align:right">Actions</th></tr>
          </thead>
          <tbody>
            {users.length === 0 && (
              <tr><td colspan="6" style="text-align:center; color:var(--a-muted); padding:2rem">No users yet — invite the first above.</td></tr>
            )}
            {users.map((u) => (
              <tr>
                <td style="color:var(--a-ink); font-weight:500">{u.name || '—'}</td>
                <td>{u.email}</td>
                <td><span class={`a-badge ${badge(u.role)}`}>{u.role}</span></td>
                <td>{u.active ? <span class="a-badge a-badge-green">Active</span> : <span class="a-badge a-badge-muted">Disabled</span>}</td>
                <td class="a-num">{fmtDate(u.created_at)}</td>
                <td style="text-align:right; white-space:nowrap">
                  <a href={`/admin/users/${u.id}`} class="u-action">Edit</a>
                  {u.id !== user.id && (
                    <button class="u-action u-danger delete-user" data-user-id={u.id} data-user-name={u.name || u.email}>Delete</button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<style>
  .u-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: start; }
  @media (min-width: 1024px) { .u-grid { grid-template-columns: 340px 1fr; } }
  .u-hint { font-size: .82rem; color: var(--a-muted); margin: .3rem 0 1.1rem; line-height: 1.5; }
  .u-form { display: flex; flex-direction: column; gap: .85rem; }
  .u-field { display: flex; flex-direction: column; gap: .35rem; }
  .u-opt { text-transform: none; letter-spacing: 0; color: var(--a-muted); font-weight: 400; }
  .u-send { justify-content: center; margin-top: .3rem; }
  .u-msg { font-size: .82rem; margin: 0; min-height: 1em; }
  .u-msg.ok { color: var(--a-green); }
  .u-msg.err { color: var(--a-red); }

  .u-list-head { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 1.35rem; border-bottom: 1px solid var(--a-line); }
  .u-table-wrap { overflow-x: auto; padding: .35rem .6rem .6rem; }
  .u-action { font-size: .82rem; font-weight: 600; color: var(--a-accent-2); text-decoration: none; background: none; border: none; cursor: pointer; padding: 0 .1rem; margin-left: .9rem; }
  .u-action:first-child { margin-left: 0; }
  .u-action:hover { color: var(--a-accent); }
  .u-danger { color: var(--a-red); }
  .u-danger:hover { color: #8a2f27; }
</style>

<script>
  const form = document.getElementById('inviteForm') as HTMLFormElement | null;
  const msg = document.getElementById('inviteMsg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const fd = new FormData(form);
    const payload = { email: fd.get('email'), name: fd.get('name'), role: fd.get('role') };
    if (msg) { msg.textContent = 'Sending…'; msg.className = 'u-msg'; }
    btn.disabled = true;
    try {
      const res = await fetch('/api/admin/invite', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        if (msg) { msg.textContent = data.emailed ? `Invited as ${data.role} — a sign-in link is on its way.` : `Whitelisted as ${data.role} (email could not be sent — check email config).`; msg.className = 'u-msg ok'; }
        setTimeout(() => location.reload(), 1200);
      } else {
        if (msg) { msg.textContent = data.error || 'Could not send the invitation.'; msg.className = 'u-msg err'; }
      }
    } catch {
      if (msg) { msg.textContent = 'Network error — please try again.'; msg.className = 'u-msg err'; }
    } finally { btn.disabled = false; }
  });

  const sessionid = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith('auth_session='))?.split('=')[1] ?? '';
  document.querySelectorAll('.delete-user').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      if (!confirm(`Delete user "${el.dataset.userName}"? This cannot be undone.`)) return;
      const res = await fetch(`/api/users?id=${el.dataset.userId}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${sessionid}` } });
      if (res.ok) location.reload();
      else alert('Delete failed: ' + (await res.text()));
    });
  });
</script>
