---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHero from "@components/PageHero.astro";
import PostThumb from "@components/article/postThumb.astro";
import { getPublishedPostsByType_Content } from "@utils/content-utils.js";

const posts = await getPublishedPostsByType_Content('News');
---

<Layout title="Desert Rose News" description="News, updates, and reflections from Desert Rose Bahai Institute in Eloy, Arizona — community stories, program announcements, and life on the campus.">

  <PageHero
    label="From the community"
    title="Desert Rose News"
    subtitle="Updates, reflections, and stories from our community of learners and servants."
    image="drbi.org/site/drbi/news.webp"
    imageAlt="Desert Rose Bahai Institute"
  />

  <section class="py-24 bg-surface">
    <Container>
      {Array.isArray(posts) && posts.length > 0 ? (
        <div class="flex flex-wrap justify-center gap-14">
          {posts.map((post) => (
            <div class="flex-none w-full max-w-[300px]">
              <PostThumb post={post} />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 text-body">
          <p class="text-xl mb-3">No news articles yet.</p>
          <p class="text-sm">Check back soon, or <a href="/contact-us" class="text-brand hover:underline">contact us</a> to stay connected.</p>
        </div>
      )}
    </Container>
  </section>

</Layout>
