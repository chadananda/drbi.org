<script>
  // Reveal sections as they scroll into view (progressive enhancement — content shows without JS).
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: "0px 0px -12% 0px", threshold: 0.08 }
  );
  document.querySelectorAll(".reveal-up").forEach((el) => io.observe(el));

  // Load the Givebutter widget script only as the funds section approaches — keeps the
  // third-party JS entirely off the initial load (better LCP / no unused JS at start).
  const fundsSection = document.querySelector(".ways");
  if (fundsSection) {
    const gio = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          const s = document.createElement("script");
          s.src = "https://widgets.givebutter.com/latest.umd.cjs?acct=1qYQLHeWtFc20ZMq&p=other";
          s.async = true;
          document.body.appendChild(s);
          gio.disconnect();
        }
      },
      { rootMargin: "700px 0px" }
    );
    gio.observe(fundsSection);
  }
</script>
