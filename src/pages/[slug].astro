---
export const prerender = false;

import Layout from "@layouts/ArticleLayout.astro";
import TLDR from "src/components/article/TLDR.astro";
import PodcastPlayer from "src/components/article/PodcastPlayer.astro";
import PostComments from "src/components/article/PostComments.astro";
import RelatedArticles from "src/components/article/relatedArticles.astro";
import AuthorBio from "src/components/article/authorCard.astro";
import { mainLanguages, generateArticleImage, baseURL } from "@utils/utils.js";
import TOC from "src/components/article/TOC.astro";
import MarkDownRenderer from "src/components/md/MarkDownRenderer.astro";
import { getContentBySlug, getAllContent, getTeam, getCategories, getTopics } from "@lib/queries";

const { slug } = Astro.params;

// Fetch the content entry for this slug
const post = await getContentBySlug(slug ?? '');
if (!post) return Astro.redirect('/404');

// Fetch supporting data in parallel
const [allAuthors, allCategories, allTopics, allPosts] = await Promise.all([
  getTeam(),
  getCategories(),
  getTopics(),
  getAllContent(),
]);

// Build related articles (same language, overlapping topics, excluding self)
const burialTopics = ['memorial', 'cemetery', 'bahai-burial', 'burial', 'death'];
const postTopics = post.data?.topics ?? [];
const sameLang = allPosts.filter(p => p.data?.language === post.data?.language && p.id !== post.id);

let related = sameLang.filter(p =>
  (p.data?.topics ?? []).some(t => postTopics.includes(t))
);
if (related.length === 0 && postTopics.some(t => burialTopics.includes(t))) {
  related = sameLang.filter(p => p.collection === 'memorial').slice(0, 10);
}
if (related.length === 0) related = sameLang.slice(0, 10);

const translations = allPosts.filter(p => p.baseid && post.baseid && p.baseid === post.baseid && p.id !== post.id);

// Find author, category, topics for this post
const author = allAuthors.find(a => a.id === post.data?.author);
const category = allCategories.find(c => c.id === post.data?.category);
const topics = allTopics.filter(t => postTopics.includes(t.id ?? t.slug));

const language = post.data?.language || "en";
const isCemeteryArticle = postTopics.some(t => burialTopics.includes(t));
const dir = mainLanguages[language]?.dir ?? 'ltr';
const base_url = baseURL(Astro);

// Wide hero for the full-bleed header (cropped responsively with object-cover).
const cover_image = await generateArticleImage(post.data?.image?.src, post, base_url, 1600, 760, 'webp', 90);
const hasCover = !!post.data?.image?.src;

const prettyDate = post.data?.datePublished
  ? new Date(post.data.datePublished).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;

// Cache published content at edge for 5 min, stale-while-revalidate 1 hour
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=300, stale-while-revalidate=3600');
---
<Layout {post} {author} {category} {language}>

  {hasCover && <link rel="preload" as="image" href={cover_image?.src} />}

  <!-- Full-bleed editorial hero with the title overlaid -->
  <header class:list={["art-hero", { "art-hero--plain": !hasCover }]} dir={dir}>
    {hasCover && (
      <img {...cover_image} alt={cover_image?.alt ?? post.data?.title} class="art-hero__img" fetchpriority="high" />
    )}
    <div class="art-hero__scrim" aria-hidden="true"></div>
    <div class="art-hero__inner">
      {category?.data?.category && (
        <a href={`/categories/${category?.id}`} class="art-hero__kicker">{category?.data?.category}</a>
      )}
      <h1 class="art-hero__title">{post.data?.title}</h1>
      <div class="art-hero__meta">
        {!!author && <a href={`/authors/${author?.id}`} class="art-hero__author">{author?.data?.name}</a>}
        {prettyDate && <time class="art-hero__dot">{prettyDate}</time>}
        {topics?.map((topic) => (
          <a href={`/topics/${topic?.id}`} class="art-hero__topic">#{topic?.data?.topic}</a>
        ))}
      </div>
    </div>
  </header>

  <!-- Body — the side columns flank the TEXT, not the hero -->
  <div class="art-grid">
    <aside class="art-aside art-aside--left">
      <div class="art-sticky"><TOC {post} /></div>
    </aside>

    <article class="art-main" lang={language} dir={dir}>
      <div class="art-col">
        <TLDR {post} />
        {!!post.data?.audio && <PodcastPlayer {post} {author} />}
      </div>

      <div class="art-col art-prose prose prose-lg max-w-none mt-2 prose-headings:mt-10 prose-headings:mb-3">
        <MarkDownRenderer {post} />
      </div>

      {!!author && (
        <div class="art-col"><AuthorBio size="bio" {author} /></div>
      )}

      <div class="art-col hidden md:block">
        {isCemeteryArticle ? (
          <div class="my-12 text-center">
            <a href="/how-to-purchase-a-plot" class="art-cta">How to Purchase a Plot &rarr;</a>
          </div>
        ) : (
          <PostComments {post} />
        )}
      </div>
    </article>

    <aside class="art-aside art-aside--right">
      <div class="art-sticky"><RelatedArticles {related} {translations} /></div>
    </aside>
  </div>

</Layout>

<style>
  /* Self-hosted display face (already in /public/fonts) */
  @font-face {
    font-family: 'Fraunces';
    src: url('/fonts/fraunces-vf.woff2') format('woff2');
    font-weight: 100 900; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: 'Fraunces';
    src: url('/fonts/fraunces-italic-vf.woff2') format('woff2');
    font-weight: 100 900; font-style: italic; font-display: swap;
  }

  /* ── Full-bleed hero ───────────────────────────────────────────── */
  .art-hero {
    position: relative;
    width: 100%;
    min-height: clamp(340px, 58vh, 560px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #241c15;
    isolation: isolate;
  }
  .art-hero__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    z-index: -2;
  }
  .art-hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to top, rgba(20,15,10,.90) 0%, rgba(20,15,10,.55) 32%, rgba(20,15,10,.18) 60%, rgba(20,15,10,.05) 100%),
      linear-gradient(to right, rgba(20,15,10,.45) 0%, rgba(20,15,10,0) 55%);
  }
  .art-hero__inner {
    position: relative;
    width: 100%; max-width: 72rem;
    margin: 0 auto;
    padding: 3rem clamp(1.1rem, 5vw, 3.25rem) clamp(2rem, 5.5vh, 3.75rem);
    color: #fff;
  }
  .art-hero__kicker {
    display: inline-block;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: .74rem; letter-spacing: .26em; text-transform: uppercase;
    color: #f0cf98; text-decoration: none; margin-bottom: 1rem;
  }
  .art-hero__kicker:hover { color: #f7e2bd; }
  .art-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 440;
    font-size: clamp(2.05rem, 5.1vw, 3.75rem);
    line-height: 1.04; letter-spacing: -.015em;
    max-width: 20ch; text-wrap: balance;
    margin: 0;
    text-shadow: 0 2px 30px rgba(0,0,0,.4);
  }
  .art-hero__meta {
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: .35rem 1.1rem; margin-top: 1.25rem;
    font-size: .92rem; color: rgba(255,255,255,.82);
  }
  .art-hero__author { color: #fff; font-weight: 600; text-decoration: none; }
  .art-hero__author:hover { text-decoration: underline; }
  .art-hero__dot { color: rgba(255,255,255,.68); }
  .art-hero__topic { color: #f0cf98; text-decoration: none; font-size: .84rem; }
  .art-hero__topic:hover { color: #f7e2bd; }

  /* Plain variant when the post has no cover image */
  .art-hero--plain {
    background: radial-gradient(130% 120% at 18% 0%, #f8f2e7 0%, #efe7d6 52%, #e7dcc7 100%);
    min-height: clamp(240px, 34vh, 360px);
  }
  .art-hero--plain .art-hero__scrim { display: none; }
  .art-hero--plain .art-hero__title { color: #29231b; text-shadow: none; }
  .art-hero--plain .art-hero__kicker { color: #9a5516; }
  .art-hero--plain .art-hero__meta { color: #6f6150; }
  .art-hero--plain .art-hero__author { color: #29231b; }
  .art-hero--plain .art-hero__dot { color: #8a7a64; }
  .art-hero--plain .art-hero__topic { color: #9a5516; }

  /* ── Body grid: columns beside the TEXT ───────────────────────── */
  .art-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 82rem; margin: 0 auto;
    padding: 0 1.1rem;
  }
  .art-aside { display: none; }
  .art-sticky { position: static; }
  .art-main { min-width: 0; }
  .art-col { max-width: 44rem; margin-inline: auto; }

  /* ── Editorial prose ──────────────────────────────────────────── */
  .art-prose {
    max-width: 40rem;
    padding-top: clamp(1.75rem, 4.5vh, 3rem);
    font-family: 'Merriweather', Georgia, serif;
    font-size: 1.16rem;
    line-height: 1.85;
    color: #2d2821;
    --rule: #d8a657;
    --accent: #356b63;
    --link: #9a5516;
  }
  .art-prose :global(p) { margin: 0 0 1.4em; }
  .art-prose :global(a) {
    color: var(--link); text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: 3px;
    text-decoration-color: rgba(154,85,22,.38); transition: color .15s, text-decoration-color .15s;
  }
  .art-prose :global(a:hover) { color: #7a4211; text-decoration-color: #7a4211; }
  .art-prose :global(strong) { font-weight: 700; color: #231d16; }
  .art-prose :global(em) { color: #4a4036; }

  /* Standfirst — the opening byline/bio paragraph */
  .art-prose > :global(p:first-of-type) {
    font-size: 1.3rem; line-height: 1.68; color: #554b3e;
    padding-left: 1.1rem; border-left: 3px solid var(--rule);
  }

  /* Interview speaker labels: a bold name at the start of a line */
  .art-prose :global(p > strong:first-child) {
    color: var(--accent); font-weight: 700; letter-spacing: .005em;
  }

  /* Section headings — quoted phrases, set in Fraunces */
  .art-prose :global(h2) {
    font-family: 'Fraunces', Georgia, serif; font-weight: 450;
    font-size: clamp(1.55rem, 3.4vw, 2.05rem); line-height: 1.14;
    letter-spacing: -.012em; color: #241c15; margin: 2.6em 0 .2em;
  }
  .art-prose :global(h2)::after {
    content: ''; display: block; width: 2.4rem; height: 2px;
    background: var(--rule); margin-top: .7rem; border-radius: 2px;
  }
  .art-prose :global(h3) {
    font-family: 'Fraunces', Georgia, serif; font-weight: 500;
    font-size: 1.32rem; color: #2b2219; margin: 1.9em 0 .4em;
  }

  .art-prose :global(blockquote) {
    font-style: italic; color: #4a4036;
    border-left: 3px solid var(--rule); padding: .2rem 0 .2rem 1.3rem;
    margin: 1.7em 0;
  }
  .art-prose :global(ul), .art-prose :global(ol) { margin: 1.2em 0 1.4em; padding-left: 1.4em; }
  .art-prose :global(li) { margin: .45em 0; }
  .art-prose :global(li)::marker { color: var(--rule); }

  /* Elegant centered divider */
  .art-prose :global(hr) {
    border: 0; width: 42%; height: auto; margin: 2.6em auto;
    text-align: center; overflow: visible;
  }
  .art-prose :global(hr)::before {
    content: '❧'; color: var(--rule); font-size: 1.3rem;
    display: block; line-height: 0;
  }

  @media (min-width: 768px) {
    .art-grid {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 2rem; padding: 0 1.5rem;
    }
    .art-aside--left { display: block; }
    .art-sticky { position: sticky; top: 5rem; }
  }
  @media (min-width: 1024px) {
    .art-grid {
      grid-template-columns: 220px minmax(0, 1fr) 220px;
      gap: 2.75rem;
    }
    .art-aside--right { display: block; }
  }

  .art-cta {
    display: inline-block;
    background: #356b63; color: #fff; font-weight: 600; font-size: 1.15rem;
    padding: .95rem 2rem; border-radius: .6rem;
    text-decoration: none; box-shadow: 0 10px 24px -10px rgba(53,107,99,.6);
    transition: background .2s, transform .2s;
  }
  .art-cta:hover { background: #2b574f; transform: translateY(-1px); }
</style>
