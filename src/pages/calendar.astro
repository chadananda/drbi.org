---
// Public DRBI calendar. Aggregates events (auto) + team-managed calendar_items, rendered as
// Week (default) / Month / Year views. Custom, dependency-light: SSR embeds the data + a no-JS
// agenda fallback; a small inline script renders the views client-side (instant switching, no
// per-view URLs so the edge cache stays simple). Availability (green → Book on Airbnb) is
// computed per day. See docs/calendar-spec.md.
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHero from "@components/PageHero.astro";
import { getCalendarData } from "@lib/calendar";

const { entries, airbnbUrl } = await getCalendarData();

// Server-side agenda fallback (no-JS / SEO): next ~25 upcoming entries.
const now = new Date();
const upcoming = entries
  .filter((e) => new Date(e.end || e.start) >= now)
  .slice(0, 25);
const fmtDay = (s) => { try { return new Date(s).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: "America/Phoenix" }); } catch { return ""; } };
---

<Layout
  title="Calendar — Desert Rose Bahá'í Institute"
  description="Upcoming programs, concerts, retreats and events at Desert Rose Bahá'í Institute — and open dates you can book.">

  <PageHero
    label="What's happening"
    title="DRBI Calendar"
    subtitle="Programs, concerts, and retreats — plus open dates available to book for your own gathering."
    image="drbi.org/media/desert-sunset-hero-d350.webp"
    imageAlt="Desert sunset over Desert Rose Bahá'í Institute"
  />

  <section class="py-16 bg-surface">
    <Container>
      <div id="cal-root" data-airbnb={airbnbUrl}>
        <!-- No-JS fallback: a simple upcoming agenda. Replaced by the interactive calendar on load. -->
        <div class="cal-fallback">
          <h2 class="cal-fallback-h">Upcoming</h2>
          {upcoming.length === 0 ? (
            <p class="cal-muted">No upcoming items.</p>
          ) : (
            <ul class="cal-fallback-list">
              {upcoming.map((e) => (
                <li>
                  <span class="cal-fallback-date">{fmtDay(e.start)}</span>
                  {e.url ? <a href={e.url}>{e.title}</a> : <span>{e.title}</span>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </Container>
  </section>

  <script type="application/json" id="cal-data" is:inline set:html={JSON.stringify({ entries, airbnbUrl })}></script>

  <script is:inline>
    (function () {
      var root = document.getElementById('cal-root');
      var data;
      try { data = JSON.parse(document.getElementById('cal-data').textContent); } catch (e) { return; }
      // Parse a date value as a LOCAL day. Date-only strings ("2026-09-24") otherwise parse as UTC
      // midnight — the previous evening in Phoenix — which shifts every all-day block a day early.
      function parseDate(s) {
        if (!s) return new Date(NaN);
        var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s));
        return m ? new Date(+m[1], +m[2]-1, +m[3]) : new Date(s);
      }
      var ENTRIES = (data.entries || []).map(function (e) {
        return { title: e.title, type: e.type, variant: e.variant || '', url: e.url || '', color: e.color,
                 s: parseDate(e.start), e: parseDate(e.end || e.start) };
      }).filter(function (x) { return !isNaN(+x.s); });
      var AIRBNB = data.airbnbUrl || '';
      var TZ = 'America/Phoenix';
      var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      var DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

      function startOfDay(d) { var x = new Date(d); x.setHours(0,0,0,0); return x; }
      function addDays(d, n) { var x = new Date(d); x.setDate(x.getDate()+n); return x; }
      function firstOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
      function addMonths(d, n) { return new Date(d.getFullYear(), d.getMonth()+n, 1); }
      function sameYMD(a, b) { return a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate(); }
      function startOfWeek(d) { var x = startOfDay(d); x.setDate(x.getDate()-x.getDay()); return x; } // Sunday
      function esc(s) { return String(s==null?'':s).replace(/[&<>"]/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }

      var today = startOfDay(new Date());
      // Two stacked views on one page: this month (grid), then a rolling 12-month year that starts
      // the month AFTER this one (this month is already shown above, so we don't repeat it).
      var state = { month: firstOfMonth(today), yearStart: addMonths(firstOfMonth(today), 1), expanded: null, scrollExp: false };

      // Entries overlapping a given day (inclusive of multi-day ranges).
      function entriesOn(day) {
        var d0 = startOfDay(day).getTime(), d1 = addDays(d0, 1).getTime();
        return ENTRIES.filter(function (x) { return startOfDay(x.s).getTime() < d1 && x.e.getTime() >= d0; });
      }
      function dayState(day) {
        var es = entriesOn(day);
        var resItems = es.filter(function (x) { return x.type === 'reserved'; });
        // Turnaround/cleaning padding ('airbnb-block') blocks the day but is never labeled — the
        // public calendar shows events and actual bookings, not housekeeping.
        var labeled = resItems.filter(function (x) { return x.variant !== 'airbnb-block'; });
        var shown = es.filter(function (x) { return x.type !== 'reserved'; });
        var past = startOfDay(day) < today;
        var reserved = resItems.length > 0;
        var available = !reserved && shown.length === 0 && !past;
        var blockOnly = reserved && !labeled.length && !shown.length; // only cleaning/host block
        return { reserved: reserved, labeled: labeled, shown: shown, available: available, blockOnly: blockOnly, past: past };
      }
      function dayClasses(st, isToday) {
        return (st.blockOnly ? ' is-blocked' : (st.reserved ? ' is-reserved' : '')) +
               (st.available ? ' is-avail' : '') + (st.past ? ' is-past' : '') + (isToday ? ' is-today' : '');
      }
      // A booking/hold tag carries its type of use ("Airbnb", or a DRBI hold's title), tinted from
      // the entry's own color (--rc). Cleaning days produce no tag.
      function resTag(x) { return '<span class="cal-res-tag" style="--rc:' + x.color + '">' + esc(x.title) + '</span>'; }
      function chip(x) {
        var inner = '<span class="cal-dot" style="background:' + x.color + '"></span>' + esc(x.title);
        return x.url ? '<a class="cal-chip" href="' + esc(x.url) + '">' + inner + '</a>'
                     : '<span class="cal-chip">' + inner + '</span>';
      }
      function bookLink() {
        if (!AIRBNB) return '<span class="cal-avail">Available</span>';
        return '<a class="cal-avail cal-book" href="' + esc(AIRBNB) + '" target="_blank" rel="noopener">Available — Book →</a>';
      }

      function legend() {
        return '<div class="cal-legend">' +
          '<span><i style="background:#2563eb"></i>Event / program</span>' +
          '<span><i style="background:#7c3aed"></i>Holy Day</span>' +
          '<span><i style="background:#b45309"></i>Booked / in use</span>' +
          '<span><i class="cal-legend-avail"></i>Available to book</span></div>';
      }
      function navBtns(scope) {
        return '<div class="cal-nav">' +
          '<button data-nav="prev" data-scope="' + scope + '" aria-label="Previous">‹</button>' +
          '<button data-nav="today" data-scope="' + scope + '">Today</button>' +
          '<button data-nav="next" data-scope="' + scope + '" aria-label="Next">›</button></div>';
      }
      function sectionHead(title, sub, controls) {
        return '<div class="cal-sec-head"><h2 class="cal-sec-title">' + esc(title) + '</h2>' +
          (sub ? '<span class="cal-sec-sub">' + esc(sub) + '</span>' : '') + (controls || '') + '</div>';
      }

      function renderMonthGrid(first) {
        var m = first.getMonth();
        var gridStart = startOfWeek(first);
        var html = '<div class="cal-month"><div class="cal-month-dow">' + DOW.map(function(d){return '<span>'+d+'</span>';}).join('') + '</div><div class="cal-grid">';
        for (var i=0;i<42;i++) {
          var day = addDays(gridStart, i);
          var out = day.getMonth() !== m;
          var st = dayState(day);
          var cls = out ? ' is-out' : dayClasses(st, sameYMD(day, today));
          html += '<div class="cal-cell' + cls + '"' + ((!out && st.available && AIRBNB) ? ' data-book="1"' : '') + '>' +
            '<div class="cal-cell-num">' + day.getDate() + '</div>' +
            '<div class="cal-cell-body">' + (out ? '' : (st.labeled.map(resTag).join('') + st.shown.slice(0,3).map(function(x){
              return '<a class="cal-cell-chip" ' + (x.url?('href="'+esc(x.url)+'"'):'') + ' style="border-color:' + x.color + '"><span class="cal-dot" style="background:'+x.color+'"></span>' + esc(x.title) + '</a>';
            }).join('') + (st.shown.length>3?('<span class="cal-more">+'+(st.shown.length-3)+' more</span>'):''))) + '</div></div>';
        }
        return html + '</div></div>';
      }

      function renderMini(first, offset) {
        var m = first.getMonth();
        var gridStart = startOfWeek(first);
        var html = '<button class="cal-mini' + (state.expanded===offset?' is-exp':'') + '" data-exp="' + offset + '">' +
          '<div class="cal-mini-h">' + MONTHS[m].slice(0,3) + ' ’' + String(first.getFullYear()).slice(2) + '</div><div class="cal-mini-grid">';
        for (var i=0;i<42;i++) {
          var day = addDays(gridStart, i);
          if (day.getMonth() !== m) { html += '<i class="cal-mini-d is-out"></i>'; continue; }
          var st = dayState(day);
          var cls = st.shown.length ? 'is-event' : (st.labeled.length ? 'is-reserved' : (st.blockOnly ? 'is-blocked' : (st.available ? 'is-avail' : '')));
          html += '<i class="cal-mini-d ' + cls + '"></i>';
        }
        return html + '</div></button>';
      }

      function renderYear() {
        var html = '<div class="cal-year">';
        for (var i=0;i<12;i++) html += renderMini(addMonths(state.yearStart, i), i);
        html += '</div>';
        if (state.expanded != null) {
          var ef = addMonths(state.yearStart, state.expanded);
          html += '<div class="cal-year-exp"><div class="cal-exp-head"><span>' + MONTHS[ef.getMonth()] + ' ' + ef.getFullYear() +
            '</span><button class="cal-exp-close" data-exp-close="1" aria-label="Close">×</button></div>' + renderMonthGrid(ef) + '</div>';
        }
        return html;
      }

      function render() {
        var yEnd = addMonths(state.yearStart, 11);
        var ySub = MONTHS[state.yearStart.getMonth()].slice(0,3) + ' ' + state.yearStart.getFullYear() + ' – ' + MONTHS[yEnd.getMonth()].slice(0,3) + ' ' + yEnd.getFullYear();

        root.innerHTML = '<div class="cal">' + legend() +
          '<section class="cal-sec">' + sectionHead(MONTHS[state.month.getMonth()] + ' ' + state.month.getFullYear(), '', navBtns('month')) + renderMonthGrid(state.month) + '</section>' +
          '<section class="cal-sec">' + sectionHead('The year ahead', ySub, '') + '<p class="cal-sec-hint">Tap a month to open it.</p>' + renderYear() + '</section>' +
          '</div>';
        wire();
        if (state.scrollExp && state.expanded != null) {
          var exp = root.querySelector('.cal-year-exp');
          if (exp) exp.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        state.scrollExp = false;
      }

      function wire() {
        root.querySelectorAll('[data-nav]').forEach(function (b) { b.onclick = function () {
          var n = b.getAttribute('data-nav');
          state.month = (n === 'today') ? firstOfMonth(today) : addMonths(state.month, n==='next'?1:-1);
          render();
        }; });
        root.querySelectorAll('[data-exp]').forEach(function (b) { b.onclick = function () {
          var o = Number(b.getAttribute('data-exp'));
          state.expanded = (state.expanded === o) ? null : o;
          state.scrollExp = state.expanded != null;
          render();
        }; });
        root.querySelectorAll('[data-exp-close]').forEach(function (b) { b.onclick = function () { state.expanded = null; render(); }; });
        root.querySelectorAll('.cal-cell[data-book]').forEach(function (c) { c.onclick = function (ev) {
          if (ev.target.closest('a')) return;
          if (AIRBNB) window.open(AIRBNB, '_blank', 'noopener');
        }; });
      }

      render();
    })();
  </script>

  <style is:global>
    .cal-fallback-h { font-family: 'Merriweather', Georgia, serif; font-size: 1.4rem; margin: 0 0 1rem; }
    .cal-fallback-list { list-style: none; padding: 0; margin: 0; max-width: 40rem; }
    .cal-fallback-list li { display: flex; gap: 1rem; padding: .5rem 0; border-bottom: 1px solid var(--color-line, #e7e2d8); }
    .cal-fallback-date { color: var(--color-muted, #8b847a); min-width: 7rem; }
    .cal-muted { color: var(--color-muted, #8b847a); }

    .cal { max-width: 68rem; margin: 0 auto; }
    /* Stacked sections: week, month, year — each with its own header + nav. */
    .cal-sec { margin-bottom: 3.5rem; }
    .cal-sec-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem .9rem; margin-bottom: 1rem; }
    .cal-sec-title { font-family: 'Merriweather', Georgia, serif; font-weight: 400; font-size: 1.35rem; margin: 0; }
    .cal-sec-sub { color: var(--color-muted, #8b847a); font-size: .9rem; }
    .cal-sec-hint { color: var(--color-muted, #8b847a); font-size: .82rem; margin: 0 0 .8rem; }
    .cal-nav { display: inline-flex; gap: .3rem; margin-left: auto; }
    .cal-nav button { border: 1px solid var(--color-line, #e0d9cc); background: #fff; color: var(--color-ink, #2a1c0b); border-radius: 8px; padding: .4rem .7rem; font-size: .85rem; cursor: pointer; line-height: 1; }
    .cal-nav button:hover { border-color: var(--color-brand, #a04607); }
    .cal-legend { width: 100%; display: flex; flex-wrap: wrap; gap: .3rem 1.1rem; font-size: .78rem; color: var(--color-muted, #6b6357); margin-bottom: 1.6rem; }
    .cal-legend span { display: inline-flex; align-items: center; gap: .35rem; }
    .cal-legend i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
    .cal-legend-avail { background: #ecfdf5; border: 1px solid #6ee7b7; }
    .cal-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }

    /* Week (agenda-style rows — works at every width) */
    .cal-week { display: flex; flex-direction: column; gap: .5rem; }
    .cal-wday { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; padding: .7rem .9rem; background: #fff; border: 1px solid var(--color-line, #ece7dd); border-radius: 12px; }
    .cal-wday.is-today { border-color: var(--color-brand, #a04607); box-shadow: 0 0 0 1px var(--color-brand, #a04607); }
    .cal-wday.is-reserved { background: #fffaf2; }
    .cal-wday.is-blocked { background: #f6f5f2; }
    .cal-wday.is-past { opacity: .55; }
    .cal-wday-head { text-align: center; }
    .cal-wday-dow { display: block; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted, #8b847a); }
    .cal-wday-num { display: block; font-family: 'Merriweather', Georgia, serif; font-size: 1.6rem; line-height: 1.1; }
    .cal-wday-body { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; min-height: 1.8rem; }
    .cal-chip { display: inline-flex; align-items: center; gap: .4rem; background: var(--color-surface, #f7f3ec); border: 1px solid var(--color-line, #e7e2d8); border-radius: 999px; padding: .28rem .7rem; font-size: .85rem; color: var(--color-ink, #2a1c0b); text-decoration: none; }
    a.cal-chip:hover { border-color: var(--color-brand, #a04607); }
    /* Reserved/blocked tag: tinted from the entry's own color (--rc). Booked reads solid; a
       turnaround/host block (.is-block) reads softer so it's clearly not an actual booking. */
    .cal-res-tag { display: inline-flex; align-items: center; font-size: .78rem; font-weight: 600; color: var(--rc, #b45309); background: color-mix(in srgb, var(--rc, #b45309) 12%, #fff); border: 1px solid color-mix(in srgb, var(--rc, #b45309) 35%, #fff); border-radius: 999px; padding: .25rem .65rem; }
    .cal-res-tag.is-block { font-weight: 500; font-style: italic; opacity: .9; }
    .cal-avail { font-size: .8rem; color: #059669; }
    a.cal-book { text-decoration: none; font-weight: 600; }
    a.cal-book:hover { text-decoration: underline; }

    /* Month grid */
    .cal-month-dow { display: grid; grid-template-columns: repeat(7,1fr); text-align: center; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-muted, #8b847a); margin-bottom: .3rem; }
    .cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 4px; }
    .cal-cell { min-height: 5.2rem; background: #fff; border: 1px solid var(--color-line, #ece7dd); border-radius: 8px; padding: .3rem .35rem; overflow: hidden; }
    .cal-cell.is-out { background: #faf8f4; opacity: .55; }
    .cal-cell.is-reserved { background: #fffaf2; border-color: #fcd9a8; }
    .cal-cell.is-blocked { background: #f6f5f2; border-color: #e7e2d8; }
    .cal-cell.is-avail { background: #f3fdf8; cursor: pointer; }
    .cal-cell.is-today { border-color: var(--color-brand, #a04607); box-shadow: inset 0 0 0 1px var(--color-brand, #a04607); }
    .cal-cell-num { font-size: .78rem; color: var(--color-muted, #6b6357); font-weight: 600; margin-bottom: .2rem; }
    .cal-cell-body { display: flex; flex-direction: column; gap: 2px; }
    .cal-cell-chip { display: flex; align-items: center; gap: .3rem; font-size: .72rem; line-height: 1.15; color: var(--color-ink, #2a1c0b); text-decoration: none; border-left: 3px solid; padding: 1px 2px 1px 5px; border-radius: 3px; background: var(--color-surface, #f7f3ec); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cal-more { font-size: .68rem; color: var(--color-muted, #8b847a); }

    /* Year — 12 mini-months */
    .cal-year { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.6rem 1.4rem; }
    .cal-mini { text-align: left; background: #fff; border: 1px solid var(--color-line, #ece7dd); border-radius: 10px; padding: .7rem; cursor: pointer; }
    .cal-mini:hover { border-color: var(--color-brand, #a04607); }
    .cal-mini-h { font-weight: 600; font-size: .9rem; margin-bottom: .4rem; }
    .cal-mini-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
    .cal-mini-d { width: 100%; padding-top: 100%; border-radius: 2px; background: #f0ece4; }
    .cal-mini-d.is-out { background: transparent; }
    .cal-mini-d.is-event { background: #2563eb; }
    .cal-mini-d.is-reserved { background: #d98324; }
    .cal-mini-d.is-blocked { background: #ded8ce; }
    .cal-mini-d.is-avail { background: #a7f3d0; }
    .cal-mini.is-exp { border-color: var(--color-brand, #a04607); box-shadow: 0 0 0 1px var(--color-brand, #a04607); }

    /* Inline expansion of a year tile into a full month grid, right below the grid. */
    .cal-year-exp { margin-top: 1.1rem; border: 1px solid var(--color-line, #ece7dd); border-radius: 12px; padding: 1rem 1.1rem 1.2rem; background: #fffdf9; }
    .cal-exp-head { display: flex; align-items: center; justify-content: space-between; font-family: 'Merriweather', Georgia, serif; font-size: 1.15rem; margin-bottom: .7rem; }
    .cal-exp-close { border: none; background: none; font-size: 1.5rem; line-height: 1; color: var(--color-muted, #8b847a); cursor: pointer; padding: 0 .3rem; }
    .cal-exp-close:hover { color: var(--color-brand, #a04607); }

    @media (max-width: 720px) {
      .cal-cell { min-height: 3.6rem; }
      .cal-cell-chip { font-size: 0; padding: 3px; }
      .cal-cell-chip .cal-dot { width: 6px; height: 6px; }
      .cal-year { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 460px) {
      .cal-year { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
