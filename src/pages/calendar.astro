---
// Public DRBI calendar, community-first. Default tab = Community: month grids (this month + 5) of
// Roundhouse gatherings + DRBI events + facility rentals (Airbnb, the source of truth), flagging
// Roundhouse events whose night is rented; JS pages one month at a time, mobile adds a day list. Second tab = programs/retreats showcase + availability grid.
// Design language matches the site's letterpress programme: Fraunces/Newsreader, warm paper, brass.
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHero from "@components/PageHero.astro";
import { getCalendarData } from "@lib/calendar";
import { compareEvents } from "@lib/event-order";
import { imagekitUrl } from "../utils/utils.js";
import { getRoundhouseEvents } from "@lib/queries";
import { expandOccurrences } from "@lib/roundhouse.js";
import { getAirbnbBlocks } from "@lib/airbnb";
import { roundhouseConflict } from "@lib/airbnb-feeds.js";

const FALLBACK = "https://cdn.shrtr.com/drbi.org/site/drbi/events.webp";
const AZ = "America/Phoenix";
const { entries, airbnbUrl } = await getCalendarData();

// Grid feed: add a tiny face-cropped thumbnail to event entries so month cells can show a photo.
const gridEntries = entries.map((e) =>
  e.type === "event" ? { ...e, thumb: imagekitUrl(e.image || FALLBACK, { w: 96, h: 96, face: true }) } : e
);

// Showcase: upcoming events, sorted, with parsed dates.
const now = new Date();
const sod = (d) => { const x = new Date(d); x.setHours(0, 0, 0, 0); return x; };
const upcoming = entries
  .filter((e) => e.type === "event" && e.start)
  .map((e) => ({ ...e, _s: new Date(e.start), _e: new Date(e.end || e.start) }))
  .filter((e) => !isNaN(+e._s) && e._e >= now)
  .sort((a, b) => compareEvents(a._s, a._e, b._s, b._e));

const feature = upcoming[0] || null;
const rest = upcoming.slice(1); // the feature is highlighted above; list the remainder

// Group the remainder by month for elegant dividers.
const groups = [];
for (const e of rest) {
  const key = e._s.getFullYear() * 12 + e._s.getMonth();
  let g = groups[groups.length - 1];
  if (!g || g.key !== key) { g = { key, label: e._s.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: AZ }), items: [] }; groups.push(g); }
  g.items.push(e);
}

// Date helpers.
const moAbbr = (d) => d.toLocaleDateString("en-US", { month: "short", timeZone: AZ }).toUpperCase();
const dayN = (d) => d.toLocaleDateString("en-US", { day: "numeric", timeZone: AZ });
const azD = (d) => d.toLocaleDateString("en-CA", { timeZone: AZ });
const isRange = (e) => azD(e._e) !== azD(e._s);
const dayStamp = (e) => (isRange(e) ? `${dayN(e._s)}–${dayN(e._e)}` : dayN(e._s));
const durDays = (e) => Math.round((Date.parse(azD(e._e)) - Date.parse(azD(e._s))) / 864e5) + 1;
const whenLong = (e) => {
  const s = e._s, en = e._e;
  const wd = (d) => d.toLocaleDateString("en-US", { weekday: "long", timeZone: AZ });
  const md = (d) => d.toLocaleDateString("en-US", { month: "long", day: "numeric", timeZone: AZ });
  if (!isRange(e)) return `${wd(s)}, ${md(s)}`;
  const sameMonth = s.getMonth() === en.getMonth() && s.getFullYear() === en.getFullYear();
  return sameMonth ? `${md(s)}–${dayN(en)}, ${en.getFullYear()}` : `${md(s)} – ${md(en)}, ${en.getFullYear()}`;
};
const kindLabel = (e) => (isRange(e) ? `${durDays(e)}-day ${/(retreat|intensive|challenge)/i.test(e.title + " " + (e.category || "")) ? "retreat" : "program"}` : "");
const featImg = (e) => imagekitUrl(e.image || FALLBACK, { w: 1360, h: 760, face: true });
const rowImg = (e) => imagekitUrl(e.image || FALLBACK, { w: 220, h: 220, face: true });

// No-JS / SEO agenda fallback for the grid area.
const fmtDay = (s) => { try { return new Date(s).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: AZ }); } catch { return ""; } };
const agenda = entries.filter((e) => new Date(e.end || e.start) >= now).slice(0, 20);

// Community tab: Roundhouse events (managed at /admin/roundhouse) + DRBI events + whole-facility/Roundhouse
// rentals, laid out as Sunday-start month grids from the 1st of this month through 6 months.
const rhAll = await getRoundhouseEvents().catch(() => []);
const rhToday = now.toLocaleDateString("en-CA", { timeZone: AZ });
const rhWeekly = rhAll.filter((e) => e.repeat === "weekly" && (!e.repeatUntil || e.repeatUntil >= rhToday));
const blocks = await getAirbnbBlocks().catch(() => []);
const azDay = (d) => new Date(d).toLocaleDateString("en-CA", { timeZone: AZ });
const ymd = (t) => new Date(t).toISOString().slice(0, 10);
const addDays = (d, n) => ymd(Date.parse(d + "T00:00:00Z") + n * 864e5);
const [cy, cm] = rhToday.split("-").map(Number);
const monthStart = (i) => ymd(Date.UTC(cy, cm - 1 + i, 1));
const rhFrom = monthStart(0), rhTo = addDays(monthStart(6), -1);
const byDay = {};
const put = (d, it) => (byDay[d] ||= []).push(it);
for (const o of expandOccurrences(rhAll, rhFrom, rhTo)) put(o.date, { kind: "rh", sort: o.startTime || "", o, rented: roundhouseConflict(o.date, blocks) });
for (const e of entries) {
  if (e.type !== "event" || !e.start) continue;
  const s = azDay(e.start), en = azDay(e.end || e.start);
  if (en < rhFrom || s > rhTo) continue;
  const ev = { ...e, _s: new Date(e.start), _e: new Date(e.end || e.start) };
  for (let d = s < rhFrom ? rhFrom : s; d <= en && d <= rhTo; d = addDays(d, 1)) put(d, { kind: "drbi", sort: "", e: ev, lead: d === s });
}
for (const b of blocks) {
  if (!b.booked || (b.space !== "facility" && b.space !== "roundhouse") || (b.end || b.start) < rhFrom || b.start > rhTo) continue;
  for (let d = b.start < rhFrom ? rhFrom : b.start; d <= (b.end || b.start) && d <= rhTo; d = addDays(d, 1)) put(d, { kind: "rental", sort: "~", b, lead: d === b.start });
}
for (const d in byDay) byDay[d].sort((x, y) => x.sort.localeCompare(y.sort));
// One rental per day is enough; a stay can span several listings.
for (const d in byDay) { let seen = false; byDay[d] = byDay[d].filter((it) => it.kind !== "rental" || (!seen && (seen = true))); }
const months = Array.from({ length: 6 }, (_, i) => {
  const first = monthStart(i), last = addDays(monthStart(i + 1), -1);
  const lead = new Date(first + "T00:00:00Z").getUTCDay();
  const cells = [];
  for (let d = addDays(first, -lead); d <= last || cells.length % 7; d = addDays(d, 1)) cells.push({ d, out: d < first || d > last, items: byDay[d] || [] });
  const days = Object.keys(byDay).filter((d) => d >= first && d <= last && d >= rhToday).sort();
  return { key: first.slice(0, 7), label: new Date(first + "T12:00:00Z").toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" }), cells, days };
});
const DOW = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const rhD = (d, o) => new Date(d + "T12:00:00Z").toLocaleDateString("en-US", { ...o, timeZone: "UTC" });
const rhT = (t) => { if (!t) return ""; const [h, m] = t.split(":").map(Number); return `${((h + 11) % 12) + 1}${m ? ":" + String(m).padStart(2, "0") : ""} ${h < 12 ? "am" : "pm"}`; };
const rhTimes = (e) => (e.startTime ? rhT(e.startTime) + (e.endTime ? `–${rhT(e.endTime)}` : "") : "");
// Compact grid times: "6:30–8p", "11a–1p", "7p"; one meridiem when both ends share it.
const hm = (t) => { const [h, m] = t.split(":").map(Number); return { n: `${((h + 11) % 12) + 1}${m ? ":" + String(m).padStart(2, "0") : ""}`, ap: h < 12 ? "a" : "p" }; };
const tShort = (a, b) => { if (!a) return ""; const x = hm(a); if (!b) return x.n + x.ap; const y = hm(b); return x.ap === y.ap ? `${x.n}–${y.n}${y.ap}` : `${x.n}${x.ap}–${y.n}${y.ap}`; };
const azHM = (d) => d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: AZ });
const drbiTime = (e) => { const a = azHM(e._s), b = azHM(e._e); if (a === "00:00") return ""; return isRange(e) ? tShort(a) : tShort(a, b === a ? "" : b); };
const chipLabel = (it) => it.kind === "rh" ? it.o.title : it.kind === "drbi" ? it.e.title : "Facility rented";
const rentalSpan = (b) => b.end && b.end !== b.start ? `${rhD(b.start, { weekday: "short", month: "short", day: "numeric" })} – ${rhD(b.end, { weekday: "short", month: "short", day: "numeric" })} nights` : `${rhD(b.start, { weekday: "short", month: "short", day: "numeric" })} night`;
---

<Layout
  title="Community Calendar — Desert Rose Bahá'í Institute"
  description="Roundhouse gatherings, community events, DRBI programs and retreats at Desert Rose Bahá'í Institute in Eloy, Arizona.">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" />

  <PageHero
    label="What's happening"
    title="Community Calendar"
    subtitle="Roundhouse gatherings, community events, and DRBI programs and retreats at Desert Rose."
    image="drbi.org/media/desert-sunset-hero-d350.webp"
    imageAlt="Desert sunset over Desert Rose Bahá'í Institute"
  />

  <div class="calx">
    <Container>

      <nav class="cx-tabs" aria-label="Calendars">
        <a class="cx-tab" href="#community" data-tab="community">Community</a>
        <a class="cx-tab" href="#facility" data-tab="facility">Programs &amp; retreats</a>
      </nav>

      <div class="cx-panel" id="community" data-panel="community">
        <section class="cx-block">
          <p class="cx-kicker">The Roundhouse &amp; community</p>
          <h2 class="cx-h2">What's on this month</h2>
          <p class="cx-lede">Community gatherings in the Roundhouse run Monday evening to Thursday evening. Paying facility rentals come first: when the Roundhouse is rented, a gathering may move to the Casa Gazebo or a nearby home, so check with its organizer. Kitty Lutness coordinates the Roundhouse. To rent the facility, visit <a href="https://desertrosehost.com">desertrosehost.com</a>.</p>

          {rhWeekly.length > 0 && (
            <div class="rh-weekly">
              <div class="cx-mrule"><span>Every week</span></div>
              <ul>
                {rhWeekly.map((e) => (
                  <li>
                    <b>{rhD(e.date, { weekday: "long" })}s</b>
                    {rhTimes(e) && <span class="rh-time">{rhTimes(e)}</span>}
                    <span class="rh-title">{e.title}</span>
                    {e.organizer && <span class="rh-org">{e.organizer}</span>}
                    {e.notes && <span class="rh-notes">{e.notes}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="cal-legend">
            <span><i class="cm-k cm-k--rh"></i>Roundhouse &amp; community</span>
            <span><i class="cm-k cm-k--drbi"></i>DRBI program</span>
            <span><i class="cm-k cm-k--rental"></i>Facility rented</span>
          </div>
          <div class="cm-months">
            {months.map((m, mi) => (
              <section class="cm-month" data-cm={mi}>
                <div class="cal-sec-head">
                  <h3 class="cal-sec-title">{m.label}</h3>
                  <div class="cal-nav cm-nav">
                    <button type="button" data-cm-go="-1" disabled={mi === 0} aria-label="Previous month">‹</button>
                    <button type="button" data-cm-go="1" disabled={mi === months.length - 1} aria-label="Next month">›</button>
                  </div>
                </div>
                <div class="cal-month-dow">{DOW.map((d) => <span>{d}</span>)}</div>
                <div class="cal-grid">
                  {m.cells.map((c) => (
                    <div class:list={["cal-cell", "cm-cell", { "is-out": c.out, "is-today": c.d === rhToday, "is-past": c.d < rhToday, "is-rented": c.items.some((it) => it.kind === "rental") }]}>
                      <div class="cal-cell-num">{Number(c.d.slice(8))}</div>
                      {!c.out && (
                        <div class="cal-cell-body">
                          {c.items.map((it) => it.kind === "drbi" ? (
                            <a class:list={["cm-chip", "cm-chip--drbi", { "is-cont": !it.lead && new Date(c.d + "T12:00:00Z").getUTCDay() !== 0 }]} href={it.e.url}>{it.lead && drbiTime(it.e) && <b>{drbiTime(it.e)}</b>}<span>{chipLabel(it)}</span>
                              <span class="cm-pop" role="tooltip"><strong>{it.e.title}</strong><em>{whenLong(it.e)}{drbiTime(it.e) ? ` · ${drbiTime(it.e)}` : ""}</em>{kindLabel(it.e) && <i>{kindLabel(it.e)}</i>}<u>View event →</u></span></a>
                          ) : (
                            <span class:list={["cm-chip", `cm-chip--${it.kind}`, { "is-moved": it.rented }]} tabindex="0">
                              {it.kind === "rh" && it.o.startTime && <b>{tShort(it.o.startTime, it.o.endTime)}</b>}<span>{chipLabel(it)}</span>
                              {it.kind === "rh" ? (
                                <span class="cm-pop" role="tooltip"><strong>{it.o.title}</strong><em>{rhD(c.d, { weekday: "short", month: "short", day: "numeric" })}{rhTimes(it.o) ? ` · ${rhTimes(it.o)}` : ""}</em><i>Roundhouse{it.o.organizer ? ` · ${it.o.organizer}` : ""}</i>{it.rented && <span class="cm-pop-warn">The Roundhouse is rented this night. This gathering may move; check with the organizer.</span>}{it.o.notes && <span>{it.o.notes}</span>}</span>
                              ) : (
                                <span class="cm-pop" role="tooltip"><strong>Facility rented</strong><em>{rentalSpan(it.b)}</em><span>The Roundhouse is unavailable.</span></span>
                              )}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
                <div class="cm-list">
                  {m.days.length === 0 ? <p class="cx-empty">Nothing else is posted for {m.label} yet.</p> : m.days.map((d) => byDay[d].filter((it) => it.lead !== false).map((it) => it.kind === "rh" ? (
                    <div class="rhr">
                      <div class="cxr-date"><span class="cxr-day">{rhD(d, { day: "numeric" })}</span><span class="cxr-mo">{rhD(d, { weekday: "short" }).toUpperCase()}</span></div>
                      <div class="cxr-main">
                        <h4 class="cxr-title">{it.o.title}</h4>
                        <div class="cxr-meta">
                          {rhTimes(it.o) && <span class="cxr-dur">{rhTimes(it.o)}</span>}
                          {it.o.organizer && <span class="rh-org">{it.o.organizer}</span>}
                        </div>
                        {it.rented && <p class="rh-moved">The Roundhouse is rented this night. This gathering may move; check with the organizer.</p>}
                        {it.o.notes && it.o.repeat !== "weekly" && <p class="cxr-teaser">{it.o.notes}</p>}
                      </div>
                    </div>
                  ) : it.kind === "drbi" ? (
                    <a class="rhr rhr--link" href={it.e.url}>
                      <div class="cxr-date"><span class="cxr-day">{dayStamp(it.e)}</span><span class="cxr-mo">{moAbbr(it.e._s)}</span></div>
                      <div class="cxr-main">
                        <h4 class="cxr-title">{it.e.title}</h4>
                        <div class="cxr-meta"><span class="cx-tag cx-tag--sm">DRBI</span>{kindLabel(it.e) && <span class="cxr-dur">{kindLabel(it.e)}</span>}</div>
                      </div>
                    </a>
                  ) : (
                    <div class="rhr rhr--rental">
                      <div class="cxr-date"><span class="cxr-day">{rhD(d, { day: "numeric" })}</span><span class="cxr-mo">{rhD(d, { weekday: "short" }).toUpperCase()}</span></div>
                      <p class="rh-rental"><b>Facility rented</b> · {rentalSpan(it.b)} · Roundhouse unavailable</p>
                    </div>
                  )))}
                </div>
              </section>
            ))}
          </div>
        </section>
      </div>

      <div class="cx-panel" id="facility" data-panel="facility">

      {feature && (
        <section class="cx-block">
          <p class="cx-kicker">Next at Desert Rose</p>
          <a class="cxf" href={feature.url}>
            <div class="cxf-media">
              <img src={featImg(feature)} alt={feature.title} width="1360" height="760" loading="lazy" decoding="async" />
            </div>
            <span class="cxf-stamp"><b>{dayStamp(feature)}</b><i>{moAbbr(feature._s)}</i></span>
            <div class="cxf-body">
              {feature.category && <span class="cx-tag">{feature.category}</span>}
              <h2 class="cxf-title">{feature.title}</h2>
              <p class="cxf-when">{whenLong(feature)}{isRange(feature) ? ` · ${durDays(feature)} days` : ""} · Desert Rose, Eloy AZ</p>
              {feature.teaser && <p class="cxf-teaser">{feature.teaser}</p>}
              <span class="cxf-cta">Explore this gathering →</span>
            </div>
          </a>
        </section>
      )}

      <section class="cx-block">
        <p class="cx-kicker">The season ahead</p>
        <h2 class="cx-h2">Programs, concerts &amp; retreats</h2>
        {groups.length === 0 ? (
          <p class="cx-empty">{feature ? "Nothing more on the calendar just yet — check back soon." : "No upcoming programs are scheduled right now — check back soon."}</p>
        ) : (
          <div class="cx-season">
            {groups.map((g) => (
              <div class="cx-mgroup">
                <div class="cx-mrule"><span>{g.label}</span></div>
                {g.items.map((e) => (
                  <a class="cxr" href={e.url}>
                    <div class="cxr-date"><span class="cxr-day">{dayStamp(e)}</span><span class="cxr-mo">{moAbbr(e._s)}</span></div>
                    <div class="cxr-thumb"><img src={rowImg(e)} alt="" width="220" height="220" loading="lazy" decoding="async" /></div>
                    <div class="cxr-main">
                      <h3 class="cxr-title">{e.title}</h3>
                      <div class="cxr-meta">
                        {e.category && <span class="cx-tag cx-tag--sm">{e.category}</span>}
                        {kindLabel(e) && <span class="cxr-dur">{kindLabel(e)}</span>}
                      </div>
                      {e.teaser && <p class="cxr-teaser">{e.teaser}</p>}
                    </div>
                    <span class="cxr-go" aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        )}
      </section>

      <section class="cx-block">
        <p class="cx-kicker">Availability</p>
        <h2 class="cx-h2">Month &amp; year at a glance</h2>
        <p class="cx-lede">Green days are open for rentals. Tap a month in the year view to open it. To book the facility, visit <a href="https://desertrosehost.com">desertrosehost.com</a>.</p>

        <div id="cal-root" data-airbnb={airbnbUrl}>
          <div class="cal-fallback">
            <h3 class="cal-fallback-h">Upcoming</h3>
            {agenda.length === 0 ? (
              <p class="cx-muted">No upcoming items.</p>
            ) : (
              <ul class="cal-fallback-list">
                {agenda.map((e) => (
                  <li>
                    <span class="cal-fallback-date">{fmtDay(e.start)}</span>
                    {e.url ? <a href={e.url}>{e.title}</a> : <span>{e.title}</span>}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
      </div>

    </Container>
  </div>

  <script is:inline>
    // Tabs: hash-synced (#community default; legacy #roundhouse → community / #facility). Without JS both panels show in order.
    (function () {
      var root = document.querySelector('.calx'); if (!root) return;
      root.classList.add('cx-tabbed');
      function show() {
        var t = location.hash === '#facility' ? 'facility' : 'community';
        root.querySelectorAll('[data-panel]').forEach(function (p) { p.hidden = p.dataset.panel !== t; });
        root.querySelectorAll('[data-tab]').forEach(function (a) { a.setAttribute('aria-current', a.dataset.tab === t ? 'page' : 'false'); });
      }
      root.querySelectorAll('[data-tab]').forEach(function (a) {
        a.addEventListener('click', function (e) { e.preventDefault(); history.replaceState(null, '', '#' + a.dataset.tab); show(); });
      });
      window.addEventListener('hashchange', show);
      show();
      // Community months: one at a time with ‹ › (no JS = all stacked).
      var ms = root.querySelectorAll('.cm-month'), cur = 0;
      function page(i) { cur = Math.max(0, Math.min(ms.length - 1, i)); ms.forEach(function (m, j) { m.hidden = j !== cur; }); }
      root.querySelectorAll('[data-cm-go]').forEach(function (b) { b.addEventListener('click', function () { page(cur + Number(b.dataset.cmGo)); }); });
      if (ms.length) page(0);
    })();
  </script>

  <script type="application/json" id="cal-data" is:inline set:html={JSON.stringify({ entries: gridEntries, airbnbUrl })}></script>

  <script is:inline>
    (function () {
      var root = document.getElementById('cal-root');
      var data;
      try { data = JSON.parse(document.getElementById('cal-data').textContent); } catch (e) { return; }
      function parseDate(s) {
        if (!s) return new Date(NaN);
        var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s));
        return m ? new Date(+m[1], +m[2]-1, +m[3]) : new Date(s);
      }
      var ENTRIES = (data.entries || []).map(function (e) {
        return { title: e.title, type: e.type, variant: e.variant || '', url: e.url || '', color: e.color,
                 thumb: e.thumb || '', s: parseDate(e.start), e: parseDate(e.end || e.start) };
      }).filter(function (x) { return !isNaN(+x.s); });
      var AIRBNB = data.airbnbUrl || '';
      var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      var DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

      function startOfDay(d) { var x = new Date(d); x.setHours(0,0,0,0); return x; }
      function addDays(d, n) { var x = new Date(d); x.setDate(x.getDate()+n); return x; }
      function firstOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
      function addMonths(d, n) { return new Date(d.getFullYear(), d.getMonth()+n, 1); }
      function sameYMD(a, b) { return a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate(); }
      function startOfWeek(d) { var x = startOfDay(d); x.setDate(x.getDate()-x.getDay()); return x; }
      function esc(s) { return String(s==null?'':s).replace(/[&<>"]/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }

      var today = startOfDay(new Date());
      var state = { month: firstOfMonth(today), yearStart: addMonths(firstOfMonth(today), 1), expanded: null, scrollExp: false };

      function entriesOn(day) {
        var d0 = startOfDay(day).getTime(), d1 = addDays(d0, 1).getTime();
        return ENTRIES.filter(function (x) { return startOfDay(x.s).getTime() < d1 && x.e.getTime() >= d0; });
      }
      function dayState(day) {
        var es = entriesOn(day);
        var resItems = es.filter(function (x) { return x.type === 'reserved'; });
        var labeled = resItems.filter(function (x) { return x.variant !== 'airbnb-block'; });
        var shown = es.filter(function (x) { return x.type !== 'reserved'; });
        var past = startOfDay(day) < today;
        var reserved = resItems.length > 0;
        var available = !reserved && shown.length === 0 && !past;
        var blockOnly = reserved && !labeled.length && !shown.length;
        return { reserved: reserved, labeled: labeled, shown: shown, available: available, blockOnly: blockOnly, past: past };
      }
      function dayClasses(st, isToday) {
        return (st.blockOnly ? ' is-blocked' : (st.reserved ? ' is-reserved' : '')) +
               (st.available ? ' is-avail' : '') + (st.past ? ' is-past' : '') + (isToday ? ' is-today' : '');
      }
      function resTag(x) { return '<span class="cal-res-tag" style="--rc:' + x.color + '">' + esc(x.title) + '</span>'; }
      // A month-cell event: a photo tile on the event's start day (and at each week's start, so a
      // multi-week run is re-labeled), a slim spanning bar on the days it continues through.
      function eventTile(x, day) {
        var href = x.url ? ('href="' + esc(x.url) + '"') : '';
        var isLead = sameYMD(day, startOfDay(x.s)) || day.getDay() === 0;
        if (!isLead) return '<a class="cxm-ev cxm-ev--cont" ' + href + ' style="--rc:' + x.color + '" title="' + esc(x.title) + '"></a>';
        var img = x.thumb ? '<span class="cxm-ev-img" style="background-image:url(' + esc(x.thumb) + ')"></span>' : '';
        return '<a class="cxm-ev" ' + href + ' style="--rc:' + x.color + '">' + img + '<span class="cxm-ev-nm">' + esc(x.title) + '</span></a>';
      }
      // Events whose run starts in a given month (one row each), for the year overview cards.
      function eventsInMonth(first) {
        var m = first.getMonth(), y = first.getFullYear(), out = [], seen = {};
        for (var j = 0; j < ENTRIES.length; j++) {
          var x = ENTRIES[j];
          if (x.type === 'reserved') continue;
          if (x.s.getMonth() === m && x.s.getFullYear() === y) {
            var k = x.title + '|' + x.s.getTime();
            if (!seen[k]) { seen[k] = 1; out.push(x); }
          }
        }
        return out.sort(function (a, b) { return a.s - b.s; });
      }
      function bookLink() {
        if (!AIRBNB) return '<span class="cal-avail">Available</span>';
        return '<a class="cal-avail cal-book" href="' + esc(AIRBNB) + '" target="_blank" rel="noopener">Available — Book →</a>';
      }

      function legend() {
        return '<div class="cal-legend">' +
          '<span><i style="background:#356b63"></i>Event / program</span>' +
          '<span><i style="background:#7a5a86"></i>Holy Day</span>' +
          '<span><i style="background:#b0692c"></i>Booked / in use</span>' +
          '<span><i class="cal-legend-avail"></i>Available to book</span></div>';
      }
      function navBtns() {
        return '<div class="cal-nav">' +
          '<button data-nav="prev" aria-label="Previous month">‹</button>' +
          '<button data-nav="today">Today</button>' +
          '<button data-nav="next" aria-label="Next month">›</button></div>';
      }
      function sectionHead(title, sub, controls) {
        return '<div class="cal-sec-head"><h3 class="cal-sec-title">' + esc(title) + '</h3>' +
          (sub ? '<span class="cal-sec-sub">' + esc(sub) + '</span>' : '') + (controls || '') + '</div>';
      }

      function renderMonthGrid(first) {
        var m = first.getMonth();
        var gridStart = startOfWeek(first);
        var html = '<div class="cal-month"><div class="cal-month-dow">' + DOW.map(function(d){return '<span>'+d+'</span>';}).join('') + '</div><div class="cal-grid">';
        for (var i=0;i<42;i++) {
          var day = addDays(gridStart, i);
          var out = day.getMonth() !== m;
          var st = dayState(day);
          var cls = out ? ' is-out' : dayClasses(st, sameYMD(day, today));
          var body = '';
          if (!out) {
            body += st.labeled.map(resTag).join('');
            body += st.shown.slice(0,3).map(function (x) { return eventTile(x, day); }).join('');
            if (st.shown.length > 3) body += '<span class="cal-more">+' + (st.shown.length-3) + '</span>';
            if (st.available && AIRBNB) body += '<span class="cal-open">Open</span>';
          }
          html += '<div class="cal-cell' + cls + '"' + ((!out && st.available && AIRBNB) ? ' data-book="1"' : '') + '>' +
            '<div class="cal-cell-num">' + day.getDate() + '</div><div class="cal-cell-body">' + body + '</div></div>';
        }
        return html + '</div></div>';
      }

      function renderMini(first, offset) {
        var m = first.getMonth();
        var gridStart = startOfWeek(first);
        var html = '<button class="cal-mini' + (state.expanded===offset?' is-exp':'') + '" data-exp="' + offset + '">' +
          '<div class="cal-mini-h">' + MONTHS[m] + ' <span>’' + String(first.getFullYear()).slice(2) + '</span></div><div class="cal-mini-grid">';
        for (var i=0;i<42;i++) {
          var day = addDays(gridStart, i);
          if (day.getMonth() !== m) { html += '<i class="cal-mini-d is-out"></i>'; continue; }
          var st = dayState(day);
          var cls = st.shown.length ? 'is-event' : (st.labeled.length ? 'is-reserved' : (st.blockOnly ? 'is-blocked' : (st.available ? 'is-avail' : '')));
          html += '<i class="cal-mini-d ' + cls + '"></i>';
        }
        html += '</div>';
        // The month's events, listed with thumbnails — the year view is about what's happening.
        var evs = eventsInMonth(first);
        if (evs.length) {
          html += '<ul class="cal-mini-evs">' + evs.slice(0,3).map(function (x) {
            var span = sameYMD(startOfDay(x.s), startOfDay(x.e)) ? '' : ('–' + x.e.getDate());
            var media = x.thumb ? '<span class="cme-img" style="background-image:url(' + esc(x.thumb) + ')"></span>'
                                : '<i class="cme-dot" style="background:' + x.color + '"></i>';
            return '<li>' + media + '<b>' + x.s.getDate() + span + '</b><span class="cme-nm">' + esc(x.title) + '</span></li>';
          }).join('') + (evs.length > 3 ? '<li class="cme-more">+' + (evs.length-3) + ' more</li>' : '') + '</ul>';
        } else {
          html += '<p class="cal-mini-none">Open all month</p>';
        }
        return html + '</button>';
      }

      function renderYear() {
        var html = '<div class="cal-year">';
        for (var i=0;i<12;i++) html += renderMini(addMonths(state.yearStart, i), i);
        html += '</div>';
        if (state.expanded != null) {
          var ef = addMonths(state.yearStart, state.expanded);
          html += '<div class="cal-year-exp"><div class="cal-exp-head"><span>' + MONTHS[ef.getMonth()] + ' ' + ef.getFullYear() +
            '</span><button class="cal-exp-close" data-exp-close="1" aria-label="Close">×</button></div>' + renderMonthGrid(ef) + '</div>';
        }
        return html;
      }

      function render() {
        var yEnd = addMonths(state.yearStart, 11);
        var ySub = MONTHS[state.yearStart.getMonth()].slice(0,3) + ' ' + state.yearStart.getFullYear() + ' – ' + MONTHS[yEnd.getMonth()].slice(0,3) + ' ' + yEnd.getFullYear();
        root.innerHTML = '<div class="cal">' + legend() +
          '<div class="cal-sec">' + sectionHead(MONTHS[state.month.getMonth()] + ' ' + state.month.getFullYear(), '', navBtns()) + renderMonthGrid(state.month) + '</div>' +
          '<div class="cal-sec">' + sectionHead('The year ahead', ySub, '') + '<p class="cal-sec-hint">Tap a month to open it.</p>' + renderYear() + '</div>' +
          '</div>';
        wire();
        if (state.scrollExp && state.expanded != null) {
          var exp = root.querySelector('.cal-year-exp');
          if (exp) exp.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        state.scrollExp = false;
      }

      function wire() {
        root.querySelectorAll('[data-nav]').forEach(function (b) { b.onclick = function () {
          var n = b.getAttribute('data-nav');
          state.month = (n === 'today') ? firstOfMonth(today) : addMonths(state.month, n==='next'?1:-1);
          render();
        }; });
        root.querySelectorAll('[data-exp]').forEach(function (b) { b.onclick = function () {
          var o = Number(b.getAttribute('data-exp'));
          state.expanded = (state.expanded === o) ? null : o;
          state.scrollExp = state.expanded != null;
          render();
        }; });
        root.querySelectorAll('[data-exp-close]').forEach(function (b) { b.onclick = function () { state.expanded = null; render(); }; });
        root.querySelectorAll('.cal-cell[data-book]').forEach(function (c) { c.onclick = function (ev) {
          if (ev.target.closest('a')) return;
          if (AIRBNB) window.open(AIRBNB, '_blank', 'noopener');
        }; });
      }

      render();
    })();
  </script>

  <style is:global>
    /* ── Warm "programme" design system, scoped to the calendar ─────────────────────────── */
    .calx {
      --paper: #f6efe2; --card: #fffdf8; --ink: #2b2013; --ink2: #5f5341; --muted: #938674;
      --line: #e6dcc7; --rose: #a04607; --rose2: #8a4a12; --gold: #bd8a3f; --sage: #6f8a72;
      --shadow: 0 22px 48px -28px rgba(74,48,20,.55); --shadow-sm: 0 8px 20px -14px rgba(74,48,20,.5);
      background: var(--paper);
      background-image: radial-gradient(120% 60% at 50% -10%, rgba(189,138,63,.08), transparent 60%);
      color: var(--ink);
      font-family: 'Newsreader', Georgia, serif;
      padding: clamp(2.5rem, 6vw, 4.5rem) 0 4.5rem;
    }
    .calx :where(h2, h3) { font-family: 'Fraunces', Georgia, serif; }

    .cx-block { margin: 0 auto clamp(3rem, 7vw, 5rem); max-width: 66rem; }
    .cx-block:last-child { margin-bottom: 0; }
    .cx-kicker { font-size: .72rem; letter-spacing: .24em; text-transform: uppercase; color: var(--rose); font-family: 'Newsreader', Georgia, serif; font-weight: 600; margin: 0 0 .5rem; }
    .cx-h2 { font-weight: 400; font-size: clamp(1.6rem, 3.4vw, 2.1rem); line-height: 1.1; color: var(--ink); margin: 0 0 .5rem; letter-spacing: -.01em; }
    .cx-lede, .cx-empty { color: var(--ink2); font-size: 1.02rem; line-height: 1.6; margin: 0 0 1.6rem; max-width: 44rem; }
    .cx-muted { color: var(--muted); }
    .cx-tag { display: inline-block; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; font-family: 'Newsreader', Georgia, serif; font-weight: 600; color: var(--rose2); background: rgba(189,138,63,.14); border-radius: 999px; padding: .22rem .6rem; }
    .cx-tag--sm { font-size: .62rem; padding: .16rem .5rem; }

    /* Featured next event */
    .cxf { position: relative; display: block; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); color: #fff; text-decoration: none; isolation: isolate; }
    .cxf-media { aspect-ratio: 16 / 8.2; background: linear-gradient(135deg, #efe6d4, #e4d7bf); }
    .cxf-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
    .cxf:hover .cxf-media img { transform: scale(1.04); }
    .cxf::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(30,18,6,.86) 8%, rgba(30,18,6,.35) 42%, rgba(30,18,6,.05) 70%); z-index: 1; }
    .cxf-stamp { position: absolute; top: 1.1rem; left: 1.1rem; z-index: 2; display: grid; justify-items: center; background: rgba(255,253,248,.94); color: var(--rose2); border-radius: 12px; padding: .45rem .7rem; box-shadow: var(--shadow-sm); }
    .cxf-stamp b { font-family: 'Fraunces', Georgia, serif; font-size: 1.5rem; line-height: 1; font-weight: 500; }
    .cxf-stamp i { font-style: normal; font-size: .64rem; letter-spacing: .16em; margin-top: .12rem; color: var(--rose); }
    .cxf-body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: clamp(1.2rem, 3.5vw, 2.4rem); }
    .cxf-body .cx-tag { color: #fff; background: rgba(255,255,255,.18); backdrop-filter: blur(2px); }
    .cxf-title { font-weight: 500; font-size: clamp(1.6rem, 4.2vw, 2.9rem); line-height: 1.05; margin: .55rem 0 .35rem; color: #fff; letter-spacing: -.01em; max-width: 24ch; }
    .cxf-when { font-size: .96rem; color: rgba(255,255,255,.9); margin: 0; }
    .cxf-teaser { font-size: 1.02rem; line-height: 1.55; color: rgba(255,255,255,.82); margin: .6rem 0 0; max-width: 52ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .cxf-cta { display: inline-block; margin-top: 1rem; font-family: 'Newsreader', Georgia, serif; font-weight: 600; font-size: .95rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,.5); padding-bottom: 1px; transition: border-color .2s; }
    .cxf:hover .cxf-cta { border-color: #fff; }

    /* Season programme list */
    .cx-mgroup { margin-bottom: 1.6rem; }
    .cx-mrule { display: flex; align-items: center; gap: 1rem; margin: 0 0 .4rem; }
    .cx-mrule span { font-family: 'Fraunces', Georgia, serif; font-size: .95rem; color: var(--rose2); white-space: nowrap; }
    .cx-mrule::after { content: ""; flex: 1; height: 1px; background: linear-gradient(to right, var(--line), transparent); }

    .cxr { display: grid; grid-template-columns: 3.4rem 4.5rem 1fr auto; align-items: center; gap: 1rem; padding: .8rem .6rem; border-radius: 14px; text-decoration: none; color: inherit; transition: background .18s, transform .18s; }
    .cxr:hover { background: var(--card); box-shadow: var(--shadow-sm); transform: translateY(-1px); }
    .cxr-date { text-align: center; line-height: 1; }
    .cxr-day { display: block; font-family: 'Fraunces', Georgia, serif; font-size: 1.45rem; color: var(--ink); font-weight: 500; }
    .cxr-mo { display: block; font-size: .6rem; letter-spacing: .14em; color: var(--muted); margin-top: .15rem; }
    .cxr-thumb { width: 4.5rem; height: 4.5rem; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm); background: var(--line); }
    .cxr-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
    .cxr:hover .cxr-thumb img { transform: scale(1.06); }
    .cxr-main { min-width: 0; }
    .cxr-title { font-weight: 500; font-size: 1.2rem; line-height: 1.2; color: var(--ink); margin: 0 0 .25rem; }
    .cxr-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: .2rem; }
    .cxr-dur { font-size: .78rem; color: var(--sage); font-weight: 600; }
    .cxr-teaser { font-size: .92rem; line-height: 1.5; color: var(--ink2); margin: 0; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .cxr-go { font-size: 1.3rem; color: var(--muted); transition: transform .2s, color .2s; }
    .cxr:hover .cxr-go { color: var(--rose); transform: translateX(3px); }

    /* ── Grid section (client-rendered) ─────────────────────────────────────────────────── */
    .cal-fallback-h { font-family: 'Fraunces', Georgia, serif; font-size: 1.3rem; margin: 0 0 1rem; color: var(--ink); }
    .cal-fallback-list { list-style: none; padding: 0; margin: 0; max-width: 40rem; }
    .cal-fallback-list li { display: flex; gap: 1rem; padding: .5rem 0; border-bottom: 1px solid var(--line); }
    .cal-fallback-date { color: var(--muted); min-width: 8rem; }
    .cal-fallback-list a { color: var(--rose2); }

    .cal { max-width: 66rem; }
    .cal-sec { margin-bottom: 3rem; }
    .cal-sec:last-child { margin-bottom: 0; }
    .cal-sec-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem .9rem; margin-bottom: 1rem; }
    .cal-sec-title { font-family: 'Fraunces', Georgia, serif; font-weight: 400; font-size: 1.4rem; margin: 0; color: var(--ink); }
    .cal-sec-sub { color: var(--muted); font-size: .9rem; }
    .cal-sec-hint { color: var(--muted); font-size: .82rem; margin: 0 0 .9rem; }
    .cal-nav { display: inline-flex; gap: .3rem; margin-left: auto; }
    .cal-nav button { border: 1px solid var(--line); background: var(--card); color: var(--ink); border-radius: 8px; padding: .38rem .68rem; font-size: .85rem; cursor: pointer; line-height: 1; font-family: inherit; transition: border-color .15s, color .15s; }
    .cal-nav button:hover { border-color: var(--rose); color: var(--rose); }
    .cal-legend { display: flex; flex-wrap: wrap; gap: .35rem 1.2rem; font-size: .76rem; color: var(--ink2); margin-bottom: 1.6rem; }
    .cal-legend span { display: inline-flex; align-items: center; gap: .4rem; }
    .cal-legend i { width: 11px; height: 11px; border-radius: 3px; display: inline-block; }
    .cal-legend-avail { background: #e7f1e7; border: 1px solid var(--sage); }
    .cal-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }

    .cal-res-tag { display: inline-flex; align-items: center; font-size: .74rem; font-weight: 600; color: var(--rc, #b0692c); background: color-mix(in srgb, var(--rc, #b0692c) 12%, #fff); border: 1px solid color-mix(in srgb, var(--rc, #b0692c) 32%, #fff); border-radius: 999px; padding: .18rem .55rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cal-avail { font-size: .78rem; color: var(--sage); font-weight: 600; }
    a.cal-book { text-decoration: none; }
    a.cal-book:hover { text-decoration: underline; }

    /* Month grid */
    .cal-month-dow { display: grid; grid-template-columns: repeat(7,1fr); text-align: center; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: .4rem; }
    .cal-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 5px; }
    .cal-cell { min-height: 7rem; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: .35rem .4rem; overflow: hidden; transition: box-shadow .15s; }
    .cal-cell.is-out { background: transparent; border-color: transparent; opacity: .45; }
    .cal-cell.is-reserved { background: #fbf3e8; border-color: #f0dcc0; }
    .cal-cell.is-blocked { background: #f4f1ea; border-color: var(--line); }
    .cal-cell.is-avail { background: #f2f7f0; border-color: #d8e6d6; cursor: pointer; }
    .cal-cell.is-avail:hover { box-shadow: inset 0 0 0 1px var(--sage); }
    .cal-cell.is-today { border-color: var(--rose); box-shadow: inset 0 0 0 1px var(--rose); }
    .cal-cell.is-past { opacity: .62; }
    .cal-cell-num { font-family: 'Fraunces', Georgia, serif; font-size: .92rem; color: var(--ink2); margin-bottom: .25rem; line-height: 1; }
    .cal-cell.is-today .cal-cell-num { color: var(--rose); font-weight: 600; }
    .cal-cell-body { display: flex; flex-direction: column; gap: 3px; }
    /* Event as a small photo tile; multi-day continuations render as a slim colored bar. */
    .cxm-ev { display: block; text-decoration: none; border-radius: 7px; overflow: hidden; background: var(--card); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rc, #356b63) 26%, #fff); transition: transform .15s, box-shadow .15s; }
    .cxm-ev:hover { transform: translateY(-1px); box-shadow: inset 0 0 0 1px var(--rc, #356b63), var(--shadow-sm); }
    .cxm-ev-img { display: block; height: 2rem; background-size: cover; background-position: center; }
    .cxm-ev-nm { display: block; padding: 2px 6px; font-family: 'Fraunces', Georgia, serif; font-size: .72rem; line-height: 1.25; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-left: 3px solid var(--rc, #356b63); }
    .cxm-ev--cont { height: .42rem; border-radius: 3px; background: color-mix(in srgb, var(--rc, #356b63) 34%, #fff); box-shadow: none; }
    .cxm-ev--cont:hover { transform: none; box-shadow: none; background: color-mix(in srgb, var(--rc, #356b63) 48%, #fff); }
    .cal-open { font-size: .66rem; letter-spacing: .06em; color: var(--sage); font-weight: 600; }
    .cal-more { font-size: .66rem; color: var(--muted); padding-left: 2px; }

    /* Year — 12 month cards: a small availability grid + the month's events with thumbnails. */
    .cal-year { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 1.4rem; }
    .cal-mini { text-align: left; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1rem 1.1rem; cursor: pointer; font-family: inherit; transition: border-color .15s, box-shadow .15s, transform .15s; display: flex; flex-direction: column; }
    .cal-mini:hover { border-color: var(--rose); box-shadow: var(--shadow-sm); transform: translateY(-2px); }
    .cal-mini-h { font-family: 'Fraunces', Georgia, serif; font-size: 1.05rem; color: var(--ink); margin-bottom: .55rem; }
    .cal-mini-h span { color: var(--muted); }
    .cal-mini-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-bottom: .7rem; }
    .cal-mini-d { width: 100%; padding-top: 100%; border-radius: 2px; background: #efe9dd; }
    .cal-mini-d.is-out { background: transparent; }
    .cal-mini-d.is-event { background: #356b63; }
    .cal-mini-d.is-reserved { background: #b0692c; }
    .cal-mini-d.is-blocked { background: #ddd6c9; }
    .cal-mini-d.is-avail { background: #a9cba6; }
    .cal-mini.is-exp { border-color: var(--rose); box-shadow: 0 0 0 1px var(--rose); }
