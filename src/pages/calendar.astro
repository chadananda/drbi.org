---
// Public DRBI calendar — an editorial "what's on" experience, not just a grid. Leads with a
// featured next event and an image-rich season programme (both SSR, using event photos + pages),
// then a warm, refined Month + Year availability view (client-rendered from the embedded feed).
// Design language matches the site's letterpress programme: Fraunces/Newsreader, warm paper, brass.
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PageHero from "@components/PageHero.astro";
import { getCalendarData } from "@lib/calendar";
import { imagekitUrl } from "../utils/utils.js";

const FALLBACK = "https://cdn.shrtr.com/drbi.org/site/drbi/events.webp";
const AZ = "America/Phoenix";
const { entries, airbnbUrl } = await getCalendarData();

// Grid feed: add a tiny face-cropped thumbnail to event entries so month cells can show a photo.
const gridEntries = entries.map((e) =>
  e.type === "event" ? { ...e, thumb: imagekitUrl(e.image || FALLBACK, { w: 96, h: 96, face: true }) } : e
);

// Showcase: upcoming events, sorted, with parsed dates.
const now = new Date();
const sod = (d) => { const x = new Date(d); x.setHours(0, 0, 0, 0); return x; };
const upcoming = entries
  .filter((e) => e.type === "event" && e.start)
  .map((e) => ({ ...e, _s: new Date(e.start), _e: new Date(e.end || e.start) }))
  .filter((e) => !isNaN(+e._s) && e._e >= now)
  .sort((a, b) => a._s - b._s);

const feature = upcoming[0] || null;
const rest = upcoming.slice(1); // the feature is highlighted above; list the remainder

// Group the remainder by month for elegant dividers.
const groups = [];
for (const e of rest) {
  const key = e._s.getFullYear() * 12 + e._s.getMonth();
  let g = groups[groups.length - 1];
  if (!g || g.key !== key) { g = { key, label: e._s.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: AZ }), items: [] }; groups.push(g); }
  g.items.push(e);
}

// Date helpers.
const moAbbr = (d) => d.toLocaleDateString("en-US", { month: "short", timeZone: AZ }).toUpperCase();
const dayN = (d) => d.toLocaleDateString("en-US", { day: "numeric", timeZone: AZ });
const isRange = (e) => e._e.toDateString() !== e._s.toDateString();
const dayStamp = (e) => (isRange(e) ? `${dayN(e._s)}–${dayN(e._e)}` : dayN(e._s));
const durDays = (e) => Math.round((sod(e._e) - sod(e._s)) / 864e5) + 1;
const whenLong = (e) => {
  const s = e._s, en = e._e;
  const wd = (d) => d.toLocaleDateString("en-US", { weekday: "long", timeZone: AZ });
  const md = (d) => d.toLocaleDateString("en-US", { month: "long", day: "numeric", timeZone: AZ });
  if (!isRange(e)) return `${wd(s)}, ${md(s)}`;
  const sameMonth = s.getMonth() === en.getMonth() && s.getFullYear() === en.getFullYear();
  return sameMonth ? `${md(s)}–${dayN(en)}, ${en.getFullYear()}` : `${md(s)} – ${md(en)}, ${en.getFullYear()}`;
};
const kindLabel = (e) => (isRange(e) ? `${durDays(e)}-day ${/(retreat|intensive|challenge)/i.test(e.title + " " + (e.category || "")) ? "retreat" : "program"}` : "");
const featImg = (e) => imagekitUrl(e.image || FALLBACK, { w: 1360, h: 760, face: true });
const rowImg = (e) => imagekitUrl(e.image || FALLBACK, { w: 220, h: 220, face: true });

// No-JS / SEO agenda fallback for the grid area.
const fmtDay = (s) => { try { return new Date(s).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: AZ }); } catch { return ""; } };
const agenda = entries.filter((e) => new Date(e.end || e.start) >= now).slice(0, 20);
---

<Layout
  title="Calendar — Desert Rose Bahá'í Institute"
  description="Upcoming programs, concerts, retreats and events at Desert Rose Bahá'í Institute — and open dates you can book for your own gathering.">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" />

  <PageHero
    label="What's happening"
    title="DRBI Calendar"
    subtitle="Programs, concerts, and retreats — plus open dates available to book for your own gathering."
    image="drbi.org/media/desert-sunset-hero-d350.webp"
    imageAlt="Desert sunset over Desert Rose Bahá'í Institute"
  />

  <div class="calx">
    <Container>

      {feature && (
        <section class="cx-block">
          <p class="cx-kicker">Next at Desert Rose</p>
          <a class="cxf" href={feature.url}>
            <div class="cxf-media">
              <img src={featImg(feature)} alt={feature.title} width="1360" height="760" loading="lazy" decoding="async" />
            </div>
            <span class="cxf-stamp"><b>{dayStamp(feature)}</b><i>{moAbbr(feature._s)}</i></span>
            <div class="cxf-body">
              {feature.category && <span class="cx-tag">{feature.category}</span>}
              <h2 class="cxf-title">{feature.title}</h2>
              <p class="cxf-when">{whenLong(feature)}{isRange(feature) ? ` · ${durDays(feature)} days` : ""} · Desert Rose, Eloy AZ</p>
              {feature.teaser && <p class="cxf-teaser">{feature.teaser}</p>}
              <span class="cxf-cta">Explore this gathering →</span>
            </div>
          </a>
        </section>
      )}

      <section class="cx-block">
        <p class="cx-kicker">The season ahead</p>
        <h2 class="cx-h2">Programs, concerts &amp; retreats</h2>
        {groups.length === 0 ? (
          <p class="cx-empty">{feature ? "Nothing more on the calendar just yet — check back soon." : "No upcoming programs are scheduled right now — check back soon."}</p>
        ) : (
          <div class="cx-season">
            {groups.map((g) => (
              <div class="cx-mgroup">
                <div class="cx-mrule"><span>{g.label}</span></div>
                {g.items.map((e) => (
                  <a class="cxr" href={e.url}>
                    <div class="cxr-date"><span class="cxr-day">{dayStamp(e)}</span><span class="cxr-mo">{moAbbr(e._s)}</span></div>
                    <div class="cxr-thumb"><img src={rowImg(e)} alt="" width="220" height="220" loading="lazy" decoding="async" /></div>
                    <div class="cxr-main">
                      <h3 class="cxr-title">{e.title}</h3>
                      <div class="cxr-meta">
                        {e.category && <span class="cx-tag cx-tag--sm">{e.category}</span>}
                        {kindLabel(e) && <span class="cxr-dur">{kindLabel(e)}</span>}
                      </div>
                      {e.teaser && <p class="cxr-teaser">{e.teaser}</p>}
                    </div>
                    <span class="cxr-go" aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        )}
      </section>

      <section class="cx-block">
        <p class="cx-kicker">Availability</p>
        <h2 class="cx-h2">Month &amp; year at a glance</h2>
        <p class="cx-lede">Green days are open — available to book for your own retreat or gathering. Tap a month in the year view to open it.</p>

        <div id="cal-root" data-airbnb={airbnbUrl}>
          <div class="cal-fallback">
            <h3 class="cal-fallback-h">Upcoming</h3>
            {agenda.length === 0 ? (
              <p class="cx-muted">No upcoming items.</p>
            ) : (
              <ul class="cal-fallback-list">
                {agenda.map((e) => (
                  <li>
                    <span class="cal-fallback-date">{fmtDay(e.start)}</span>
                    {e.url ? <a href={e.url}>{e.title}</a> : <span>{e.title}</span>}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>

    </Container>
  </div>

  <script type="application/json" id="cal-data" is:inline set:html={JSON.stringify({ entries: gridEntries, airbnbUrl })}></script>

  <script is:inline>
    (function () {
      var root = document.getElementById('cal-root');
      var data;
      try { data = JSON.parse(document.getElementById('cal-data').textContent); } catch (e) { return; }
      function parseDate(s) {
        if (!s) return new Date(NaN);
        var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s));
        return m ? new Date(+m[1], +m[2]-1, +m[3]) : new Date(s);
      }
      var ENTRIES = (data.entries || []).map(function (e) {
        return { title: e.title, type: e.type, variant: e.variant || '', url: e.url || '', color: e.color,
                 thumb: e.thumb || '', s: parseDate(e.start), e: parseDate(e.end || e.start) };
      }).filter(function (x) { return !isNaN(+x.s); });
      var AIRBNB = data.airbnbUrl || '';
      var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      var DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

      function startOfDay(d) { var x = new Date(d); x.setHours(0,0,0,0); return x; }
      function addDays(d, n) { var x = new Date(d); x.setDate(x.getDate()+n); return x; }
      function firstOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
      function addMonths(d, n) { return new Date(d.getFullYear(), d.getMonth()+n, 1); }
      function sameYMD(a, b) { return a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate(); }
      function startOfWeek(d) { var x = startOfDay(d); x.setDate(x.getDate()-x.getDay()); return x; }
      function esc(s) { return String(s==null?'':s).replace(/[&<>"]/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }

      var today = startOfDay(new Date());
      var state = { month: firstOfMonth(today), yearStart: addMonths(firstOfMonth(today), 1), expanded: null, scrollExp: false };

      function entriesOn(day) {
        var d0 = startOfDay(day).getTime(), d1 = addDays(d0, 1).getTime();
        return ENTRIES.filter(function (x) { return startOfDay(x.s).getTime() < d1 && x.e.getTime() >= d0; });
      }
      function dayState(day) {
        var es = entriesOn(day);
        var resItems = es.filter(function (x) { return x.type === 'reserved'; });
        var labeled = resItems.filter(function (x) { return x.variant !== 'airbnb-block'; });
        var shown = es.filter(function (x) { return x.type !== 'reserved'; });
        var past = startOfDay(day) < today;
        var reserved = resItems.length > 0;
        var available = !reserved && shown.length === 0 && !past;
        var blockOnly = reserved && !labeled.length && !shown.length;
        return { reserved: reserved, labeled: labeled, shown: shown, available: available, blockOnly: blockOnly, past: past };
      }
      function dayClasses(st, isToday) {
        return (st.blockOnly ? ' is-blocked' : (st.reserved ? ' is-reserved' : '')) +
               (st.available ? ' is-avail' : '') + (st.past ? ' is-past' : '') + (isToday ? ' is-today' : '');
      }
      function resTag(x) { return '<span class="cal-res-tag" style="--rc:' + x.color + '">' + esc(x.title) + '</span>'; }
      function eventChip(x) {
        var media = x.thumb ? '<img class="cal-cell-thumb" src="' + esc(x.thumb) + '" alt="" loading="lazy" decoding="async"/>'
                            : '<span class="cal-dot" style="background:' + x.color + '"></span>';
        return '<a class="cal-cell-chip" ' + (x.url ? ('href="' + esc(x.url) + '"') : '') + ' style="--rc:' + x.color + '">' + media + '<span class="cal-cell-nm">' + esc(x.title) + '</span></a>';
      }
      function bookLink() {
        if (!AIRBNB) return '<span class="cal-avail">Available</span>';
        return '<a class="cal-avail cal-book" href="' + esc(AIRBNB) + '" target="_blank" rel="noopener">Available — Book →</a>';
      }

      function legend() {
        return '<div class="cal-legend">' +
          '<span><i style="background:#356b63"></i>Event / program</span>' +
          '<span><i style="background:#7a5a86"></i>Holy Day</span>' +
          '<span><i style="background:#b0692c"></i>Booked / in use</span>' +
          '<span><i class="cal-legend-avail"></i>Available to book</span></div>';
      }
      function navBtns() {
        return '<div class="cal-nav">' +
          '<button data-nav="prev" aria-label="Previous month">‹</button>' +
          '<button data-nav="today">Today</button>' +
          '<button data-nav="next" aria-label="Next month">›</button></div>';
      }
      function sectionHead(title, sub, controls) {
        return '<div class="cal-sec-head"><h3 class="cal-sec-title">' + esc(title) + '</h3>' +
          (sub ? '<span class="cal-sec-sub">' + esc(sub) + '</span>' : '') + (controls || '') + '</div>';
      }

      function renderMonthGrid(first) {
        var m = first.getMonth();
        var gridStart = startOfWeek(first);
        var html = '<div class="cal-month"><div class="cal-month-dow">' + DOW.map(function(d){return '<span>'+d+'</span>';}).join('') + '</div><div class="cal-grid">';
        for (var i=0;i<42;i++) {
          var day = addDays(gridStart, i);
          var out = day.getMonth() !== m;
          var st = dayState(day);
          var cls = out ? ' is-out' : dayClasses(st, sameYMD(day, today));
          html += '<div class="cal-cell' + cls + '"' + ((!out && st.available && AIRBNB) ? ' data-book="1"' : '') + '>' +
            '<div class="cal-cell-num">' + day.getDate() + '</div>' +
            '<div class="cal-cell-body">' + (out ? '' : (st.labeled.map(resTag).join('') + st.shown.slice(0,3).map(eventChip).join('') +
              (st.shown.length>3?('<span class="cal-more">+'+(st.shown.length-3)+' more</span>'):'') +
              (st.available && AIRBNB ? '<span class="cal-open">Open</span>' : ''))) + '</div></div>';
        }
        return html + '</div></div>';
      }

      function renderMini(first, offset) {
        var m = first.getMonth();
        var gridStart = startOfWeek(first);
        var html = '<button class="cal-mini' + (state.expanded===offset?' is-exp':'') + '" data-exp="' + offset + '">' +
          '<div class="cal-mini-h">' + MONTHS[m].slice(0,3) + ' ’' + String(first.getFullYear()).slice(2) + '</div><div class="cal-mini-grid">';
        for (var i=0;i<42;i++) {
          var day = addDays(gridStart, i);
          if (day.getMonth() !== m) { html += '<i class="cal-mini-d is-out"></i>'; continue; }
          var st = dayState(day);
          var cls = st.shown.length ? 'is-event' : (st.labeled.length ? 'is-reserved' : (st.blockOnly ? 'is-blocked' : (st.available ? 'is-avail' : '')));
          html += '<i class="cal-mini-d ' + cls + '"></i>';
        }
        return html + '</div></button>';
      }

      function renderYear() {
        var html = '<div class="cal-year">';
        for (var i=0;i<12;i++) html += renderMini(addMonths(state.yearStart, i), i);
        html += '</div>';
        if (state.expanded != null) {
          var ef = addMonths(state.yearStart, state.expanded);
          html += '<div class="cal-year-exp"><div class="cal-exp-head"><span>' + MONTHS[ef.getMonth()] + ' ' + ef.getFullYear() +
            '</span><button class="cal-exp-close" data-exp-close="1" aria-label="Close">×</button></div>' + renderMonthGrid(ef) + '</div>';
        }
        return html;
      }

      function render() {
        var yEnd = addMonths(state.yearStart, 11);
        var ySub = MONTHS[state.yearStart.getMonth()].slice(0,3) + ' ' + state.yearStart.getFullYear() + ' – ' + MONTHS[yEnd.getMonth()].slice(0,3) + ' ' + yEnd.getFullYear();
        root.innerHTML = '<div class="cal">' + legend() +
          '<div class="cal-sec">' + sectionHead(MONTHS[state.month.getMonth()] + ' ' + state.month.getFullYear(), '', navBtns()) + renderMonthGrid(state.month) + '</div>' +
          '<div class="cal-sec">' + sectionHead('The year ahead', ySub, '') + '<p class="cal-sec-hint">Tap a month to open it.</p>' + renderYear() + '</div>' +
          '</div>';
        wire();
        if (state.scrollExp && state.expanded != null) {
          var exp = root.querySelector('.cal-year-exp');
          if (exp) exp.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        state.scrollExp = false;
      }

      function wire() {
        root.querySelectorAll('[data-nav]').forEach(function (b) { b.onclick = function () {
          var n = b.getAttribute('data-nav');
          state.month = (n === 'today') ? firstOfMonth(today) : addMonths(state.month, n==='next'?1:-1);
          render();
        }; });
        root.querySelectorAll('[data-exp]').forEach(function (b) { b.onclick = function () {
          var o = Number(b.getAttribute('data-exp'));
          state.expanded = (state.expanded === o) ? null : o;
          state.scrollExp = state.expanded != null;
          render();
        }; });
        root.querySelectorAll('[data-exp-close]').forEach(function (b) { b.onclick = function () { state.expanded = null; render(); }; });
        root.querySelectorAll('.cal-cell[data-book]').forEach(function (c) { c.onclick = function (ev) {
          if (ev.target.closest('a')) return;
          if (AIRBNB) window.open(AIRBNB, '_blank', 'noopener');
        }; });
      }

      render();
    })();
  </script>

  <style is:global>
    /* ── Warm "programme" design system, scoped to the calendar ─────────────────────────── */
    .calx {
      --paper: #f6efe2; --card: #fffdf8; --ink: #2b2013; --ink2: #5f5341; --muted: #938674;
      --line: #e6dcc7; --rose: #a04607; --rose2: #8a4a12; --gold: #bd8a3f; --sage: #6f8a72;
      --shadow: 0 22px 48px -28px rgba(74,48,20,.55); --shadow-sm: 0 8px 20px -14px rgba(74,48,20,.5);
      background: var(--paper);
      background-image: radial-gradient(120% 60% at 50% -10%, rgba(189,138,63,.08), transparent 60%);
      color: var(--ink);
      font-family: 'Newsreader', Georgia, serif;
      padding: clamp(2.5rem, 6vw, 4.5rem) 0 4.5rem;
    }
    .calx :where(h2, h3) { font-family: 'Fraunces', Georgia, serif; }

    .cx-block { margin: 0 auto clamp(3rem, 7vw, 5rem); max-width: 66rem; }
    .cx-block:last-child { margin-bottom: 0; }
    .cx-kicker { font-size: .72rem; letter-spacing: .24em; text-transform: uppercase; color: var(--rose); font-family: 'Newsreader', Georgia, serif; font-weight: 600; margin: 0 0 .5rem; }
    .cx-h2 { font-weight: 400; font-size: clamp(1.6rem, 3.4vw, 2.1rem); line-height: 1.1; color: var(--ink); margin: 0 0 .5rem; letter-spacing: -.01em; }
    .cx-lede, .cx-empty { color: var(--ink2); font-size: 1.02rem; line-height: 1.6; margin: 0 0 1.6rem; max-width: 44rem; }
    .cx-muted { color: var(--muted); }
    .cx-tag { display: inline-block; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; font-family: 'Newsreader', Georgia, serif; font-weight: 600; color: var(--rose2); background: rgba(189,138,63,.14); border-radius: 999px; padding: .22rem .6rem; }
    .cx-tag--sm { font-size: .62rem; padding: .16rem .5rem; }

    /* Featured next event */
    .cxf { position: relative; display: block; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); color: #fff; text-decoration: none; isolation: isolate; }
    .cxf-media { aspect-ratio: 16 / 8.2; background: linear-gradient(135deg, #efe6d4, #e4d7bf); }
    .cxf-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
    .cxf:hover .cxf-media img { transform: scale(1.04); }
    .cxf::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(30,18,6,.86) 8%, rgba(30,18,6,.35) 42%, rgba(30,18,6,.05) 70%); z-index: 1; }
    .cxf-stamp { position: absolute; top: 1.1rem; left: 1.1rem; z-index: 2; display: grid; justify-items: center; background: rgba(255,253,248,.94); color: var(--rose2); border-radius: 12px; padding: .45rem .7rem; box-shadow: var(--shadow-sm); }
    .cxf-stamp b { font-family: 'Fraunces', Georgia, serif; font-size: 1.5rem; line-height: 1; font-weight: 500; }
    .cxf-stamp i { font-style: normal; font-size: .64rem; letter-spacing: .16em; margin-top: .12rem; color: var(--rose); }
    .cxf-body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: clamp(1.2rem, 3.5vw, 2.4rem); }
    .cxf-body .cx-tag { color: #fff; background: rgba(255,255,255,.18); backdrop-filter: blur(2px); }
    .cxf-title { font-weight: 500; font-size: clamp(1.6rem, 4.2vw, 2.9rem); line-height: 1.05; margin: .55rem 0 .35rem; color: #fff; letter-spacing: -.01em; max-width: 24ch; }
    .cxf-when { font-size: .96rem; color: rgba(255,255,255,.9); margin: 0; }
    .cxf-teaser { font-size: 1.02rem; line-height: 1.55; color: rgba(255,255,255,.82); margin: .6rem 0 0; max-width: 52ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .cxf-cta { display: inline-block; margin-top: 1rem; font-family: 'Newsreader', Georgia, serif; font-weight: 600; font-size: .95rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,.5); padding-bottom: 1px; transition: border-color .2s; }
    .cxf:hover .cxf-cta { border-color: #fff; }

    /* Season programme list */
    .cx-mgroup { margin-bottom: 1.6rem; }
    .cx-mrule { display: flex; align-items: center; gap: 1rem; margin: 0 0 .4rem; }
    .cx-mrule span { font-family: 'Fraunces', Georgia, serif; font-size: .95rem; color: var(--rose2); white-space: nowrap; }
    .cx-mrule::after { content: ""; flex: 1; height: 1px; background: linear-gradient(to right, var(--line), transparent); }

    .cxr { display: grid; grid-template-columns: 3.4rem 4.5rem 1fr auto; align-items: center; gap: 1rem; padding: .8rem .6rem; border-radius: 14px; text-decoration: none; color: inherit; transition: background .18s, transform .18s; }
    .cxr:hover { background: var(--card); box-shadow: var(--shadow-sm); transform: translateY(-1px); }
    .cxr-date { text-align: center; line-height: 1; }
    .cxr-day { display: block; font-family: 'Fraunces', Georgia, serif; font-size: 1.45rem; color: var(--ink); font-weight: 500; }
    .cxr-mo { display: block; font-size: .6rem; letter-spacing: .14em; color: var(--muted); margin-top: .15rem; }
    .cxr-thumb { width: 4.5rem; height: 4.5rem; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm); background: var(--line); }
    .cxr-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
    .cxr:hover .cxr-thumb img { transform: scale(1.06); }
    .cxr-main { min-width: 0; }
