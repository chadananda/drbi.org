echo "🔍 Pre-commit checks"

# Unit tests only. Deliberately NOT the build.
#
# Two reasons the build does not belong here:
#  1. It needs Cloudflare credentials — the @astrojs/cloudflare vite plugin opens a remote
#     proxy session. A machine without a token cannot commit AT ALL. That is not a gate,
#     it is a lockout, and it already blocked real work.
#  2. pre-push runs the identical build immediately afterwards, so nothing reaches the
#     remote unbuilt. Running it twice only makes every commit slow enough to route around.
#
# Keep this fast. A hook people skip protects nothing.

echo "🧪 Unit tests..."
if ! npm run test:unit; then
  echo "❌ Unit tests failed. Commit aborted."; exit 1
fi

echo "✅ Pre-commit checks passed."
